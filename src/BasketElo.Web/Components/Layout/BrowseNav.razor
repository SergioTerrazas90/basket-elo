@using BasketElo.Domain.Elo
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IDisposable

<details class="nav-disclosure" open>
    <summary class="nav-disclosure-summary">
        <span class="nav-icon info-icon" aria-hidden="true"></span>
        <span>Browse</span>
        <span class="nav-disclosure-chevron" aria-hidden="true"></span>
    </summary>
    <div class="nav-subitems">
        @if (directoryLoading)
        {
            <div class="nav-tree-status">Loading directories...</div>
        }
        else if (!string.IsNullOrWhiteSpace(directoryError))
        {
            <div class="nav-tree-status nav-tree-status-error">Directory unavailable</div>
        }
        else
        {
            @foreach (var pool in Pools)
            {
                if (browseResponses.TryGetValue(pool.Key, out var response))
                {
                    <details class="nav-pool" open="@(pool.Key == selectedPool)">
                        <summary class="nav-pool-summary" @onclick="() => SelectPool(pool.Key)" @onclick:stopPropagation="true">
                            <span class="nav-tree-label">@pool.DisplayName</span>
                            <span class="nav-tree-count">@response.Competitions.Count</span>
                            <span class="nav-tree-chevron" aria-hidden="true"></span>
                        </summary>
                        <div class="nav-pool-children">
                            <div class="nav-item nav-subitem">
                                <NavLink class="nav-link" href="@BrowseHref(pool.Key)" Match="NavLinkMatch.All">Directory</NavLink>
                            </div>

                            <details class="nav-tree">
                                <summary class="nav-tree-summary">
                                    <span class="nav-tree-label">Countries</span>
                                    <span class="nav-tree-count">@response.Countries.Count</span>
                                    <span class="nav-tree-chevron" aria-hidden="true"></span>
                                </summary>
                                <div class="nav-tree-children">
                                    @foreach (var country in response.Countries)
                                    {
                                        <details class="nav-tree nav-tree-country">
                                            <summary class="nav-tree-summary">
                                                <span class="nav-tree-label">@country.Name</span>
                                                <span class="nav-tree-count">@country.CompetitionCount</span>
                                                <span class="nav-tree-chevron" aria-hidden="true"></span>
                                            </summary>
                                            <div class="nav-tree-children">
                                                @foreach (var competition in CompetitionsFor(response, country))
                                                {
                                                    @CompetitionNode(competition, pool.Key)
                                                }
                                            </div>
                                        </details>
                                    }
                                </div>
                            </details>

                            <details class="nav-tree">
                                <summary class="nav-tree-summary">
                                    <span class="nav-tree-label">Competitions</span>
                                    <span class="nav-tree-count">@response.Competitions.Count</span>
                                    <span class="nav-tree-chevron" aria-hidden="true"></span>
                                </summary>
                                <div class="nav-tree-children">
                                    @foreach (var competition in response.Competitions)
                                    {
                                        @CompetitionNode(competition, pool.Key)
                                    }
                                </div>
                            </details>
                        </div>
                    </details>
                }
            }
        }
    </div>
</details>

@code {
    private static IReadOnlyList<EloPoolDescriptor> Pools
        => EloPoolCatalog.All.OrderBy(pool => pool.DisplayOrder).ToList();

    private readonly Dictionary<string, EloBrowseResponse> browseResponses = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> openCompetitionKeys = new(StringComparer.OrdinalIgnoreCase);
    private string selectedPool = EloPoolKeys.Default;
    private bool directoryLoading;
    private string? directoryError;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        selectedPool = CurrentPool();
        await LoadDirectoriesAsync();
    }

    private RenderFragment CompetitionNode(EloBrowseCompetition competition, string poolKey) => builder =>
    {
        var sequence = 0;
        var key = CompetitionKey(competition, poolKey);
        var includeTeams = string.Equals(poolKey, selectedPool, StringComparison.OrdinalIgnoreCase) && openCompetitionKeys.Contains(key);
        builder.OpenElement(sequence++, "details");
        builder.AddAttribute(sequence++, "class", "nav-tree nav-tree-competition");
        builder.AddAttribute(sequence++, "open", includeTeams);
        builder.OpenElement(sequence++, "summary");
        builder.AddAttribute(sequence++, "class", "nav-tree-summary");
        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => ToggleCompetition(key)));
        builder.AddEventStopPropagationAttribute(sequence++, "onclick", true);
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "nav-tree-label");
        builder.AddContent(sequence++, competition.Name);
        builder.CloseElement();
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "nav-tree-count");
        builder.AddContent(sequence++, competition.TeamCount);
        builder.CloseElement();
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "nav-tree-chevron");
        builder.AddAttribute(sequence++, "aria-hidden", "true");
        builder.CloseElement();
        builder.CloseElement();
        if (includeTeams)
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "nav-tree-children nav-team-children");
            foreach (var team in competition.Teams)
            {
                builder.OpenElement(sequence++, "a");
                builder.AddAttribute(sequence++, "class", "nav-tree-team");
                builder.AddAttribute(sequence++, "href", TeamHref(team, poolKey));
                builder.AddContent(sequence++, team.Name);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private async Task LoadDirectoriesAsync()
    {
        directoryLoading = true;
        directoryError = null;
        try
        {
            var responses = await Task.WhenAll(Pools.Select(LoadPoolAsync));
            browseResponses.Clear();
            foreach (var response in responses)
            {
                browseResponses[response.EloPoolKey] = response;
            }
        }
        catch
        {
            browseResponses.Clear();
            directoryError = "The directories could not be loaded.";
        }
        finally
        {
            directoryLoading = false;
        }
    }

    private async Task<EloBrowseResponse> LoadPoolAsync(EloPoolDescriptor pool)
    {
        var uri = Navigation.GetUriWithQueryParameters("api/elo/browse", new Dictionary<string, object?>
        {
            ["pool"] = pool.Key
        });
        return await Http.GetFromJsonAsync<EloBrowseResponse>(uri)
            ?? throw new InvalidOperationException($"Browse response for {pool.Key} was empty.");
    }

    private static IEnumerable<EloBrowseCompetition> CompetitionsFor(EloBrowseResponse response, EloBrowseCountry country)
        => response.Competitions.Where(competition =>
            string.Equals(competition.CountryCode, country.CountryCode, StringComparison.OrdinalIgnoreCase) ||
            (string.IsNullOrWhiteSpace(competition.CountryCode) && string.Equals(competition.Country, country.Name, StringComparison.OrdinalIgnoreCase)));

    private void SelectPool(string poolKey)
    {
        selectedPool = poolKey;
        openCompetitionKeys.Clear();
        StateHasChanged();
    }

    private void ToggleCompetition(string key)
    {
        if (!openCompetitionKeys.Add(key))
        {
            openCompetitionKeys.Remove(key);
        }

        StateHasChanged();
    }

    private static string CompetitionKey(EloBrowseCompetition competition, string poolKey)
        => $"{poolKey}|{competition.CountryCode}|{competition.Name}";

    private string BrowseHref(string poolKey, string? country = null, string? competition = null)
        => Navigation.GetUriWithQueryParameters("browse", new Dictionary<string, object?>
        {
            ["pool"] = poolKey,
            ["country"] = country,
            ["competition"] = competition
        });

    private string TeamHref(EloBrowseTeam team, string poolKey)
        => $"teams/{team.TeamId}?pool={Uri.EscapeDataString(poolKey)}&returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}";

    private string CurrentPool()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query.TrimStart('?');
        var pool = query.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(parts => parts.Length == 2 && string.Equals(parts[0], "pool", StringComparison.OrdinalIgnoreCase))
            .Select(parts => Uri.UnescapeDataString(parts[1]))
            .FirstOrDefault();
        return EloPoolKeys.IsSupported(pool) ? pool!.Trim().ToLowerInvariant() : EloPoolKeys.Default;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(() =>
        {
            var nextPool = CurrentPool();
            if (string.Equals(nextPool, selectedPool, StringComparison.OrdinalIgnoreCase))
            {
                return Task.CompletedTask;
            }

            selectedPool = nextPool;
            StateHasChanged();
            return Task.CompletedTask;
        });

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}

