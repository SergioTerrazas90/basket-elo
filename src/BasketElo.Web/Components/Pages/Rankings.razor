    private async Task LoadChartAsync(bool force = false)
    {
        if ((!force && isChartLoading) || response is null)
        {
            return;
        }

        if (evolution is not null)
        {
            if (!graphSelectionInitialized)
            {
                await EnsureGraphSelectionAsync();
            }

            return;
        }

        isChartLoading = true;
        errorMessage = null;

        try
        {
            await EnsureGraphSelectionAsync();
            evolutionRankings = await FetchEvolutionRankingsAsync();
            evolution = await FetchEvolutionAsync();
            fullEvolution = evolution;
            RebuildEvolutionChartSeries();
            CaptureActiveRankingsCacheEntry();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load chart: {ex.Message}";
        }
        finally
        {
            isChartLoading = false;
        }
    }

    private async Task EnsureGraphSelectionAsync()
    {
        if (graphSelectionInitialized || response is null)
        {
            return;
        }

        if (evolutionRankings is not null && evolutionRankings.Rankings.Count > 0)
        {
            graphTeamRows = MergeGraphTeamRows(evolutionRankings.Rankings);
            graphTeamIds.UnionWith(evolutionRankings.Rankings.Select(row => row.TeamId));
            graphSelectionInitialized = true;
            return;
        }

        var rows = HasGraphBulkScope
            ? await FetchAllRankingRowsAsync(includeTeamSearch: false)
            : response.Rankings.Take(20).ToList();

        graphTeamRows = MergeGraphTeamRows(rows);
        graphTeamIds.Clear();
        graphTeamIds.UnionWith(rows.Select(row => row.TeamId));
        hiddenGraphTeamIds.Clear();
        if (HasGraphBulkScope)
        {
            graphBulkTeamIds.UnionWith(rows.Select(row => row.TeamId));
        }
        graphSelectionInitialized = true;
    }

    private async Task AddCountryTeamsToGraphAsync()
        => await AddBulkGraphTeamsAsync($"country '{selectedCountry}'");

    private async Task AddCompetitionTeamsToGraphAsync()
        => await AddBulkGraphTeamsAsync($"competition '{selectedCompetition}'");

    private async Task AddBulkGraphTeamsAsync(string description)
    {
        if (!HasGraphBulkScope)
        {
            return;
        }

        isGraphSelectionBusy = true;
        errorMessage = null;
        try
        {
            var rows = await FetchAllRankingRowsAsync(includeTeamSearch: false);
            graphTeamRows = MergeGraphTeamRows(rows);
            graphTeamIds.UnionWith(rows.Select(row => row.TeamId));
            graphBulkTeamIds.UnionWith(rows.Select(row => row.TeamId));
            graphSelectionInitialized = true;
            graphTeamSearchResults = [];
            await ReloadGraphAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not add teams from {description}: {ex.Message}";
        }
        finally
        {
            isGraphSelectionBusy = false;
        }
    }

    private async Task HandleGraphTeamSearchInputAsync(ChangeEventArgs args)
    {
        graphTeamSearch = args.Value?.ToString();
        graphSearchCancellation?.Cancel();
        graphSearchCancellation?.Dispose();
        graphSearchCancellation = null;
        graphTeamSearchResults = [];

        if (string.IsNullOrWhiteSpace(graphTeamSearch))
        {
            isGraphSearchBusy = false;
            return;
        }

        var cancellation = new CancellationTokenSource();
        graphSearchCancellation = cancellation;
        try
        {
            await Task.Delay(180, cancellation.Token);
            await SearchGraphTeamsAsync(cancellation.Token);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(graphSearchCancellation, cancellation))
            {
                graphSearchCancellation = null;
                cancellation.Dispose();
            }
        }
    }

    private Task SearchGraphTeamsAsync()
    {
        graphSearchCancellation?.Cancel();
        graphSearchCancellation?.Dispose();
        graphSearchCancellation = null;
        return SearchGraphTeamsAsync(CancellationToken.None);
    }

    private async Task SearchGraphTeamsAsync(CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(graphTeamSearch))
        {
            graphTeamSearchResults = [];
            isGraphSearchBusy = false;
            return;
        }

        isGraphSearchBusy = true;
        errorMessage = null;
        try
        {
            var rows = await FetchGraphSearchRowsAsync(graphTeamSearch, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            graphTeamRows = MergeGraphTeamRows(rows);
            graphTeamSearchResults = rows;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not search teams: {ex.Message}";
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                isGraphSearchBusy = false;
            }
        }
    }

    private async Task AddGraphTeamAsync(EloRankingRow row)
    {
        if (graphTeamIds.Contains(row.TeamId))
        {
            return;
        }

        if (manualGraphTeamIds.Count >= MaxManualGraphTeams)
        {
            errorMessage = $"You can manually add up to {MaxManualGraphTeams} teams to the chart.";
            return;
        }

        isGraphSelectionBusy = true;
        errorMessage = null;
        try
        {
            var addedEvolution = await FetchEvolutionForTeamsAsync([row.TeamId]);

            graphTeamRows = MergeGraphTeamRows([row]);
            graphTeamIds.Add(row.TeamId);
            hiddenGraphTeamIds.Remove(row.TeamId);
            manualGraphTeamIds.Add(row.TeamId);
            graphSelectionInitialized = true;
            graphTeamSearchResults = graphTeamSearchResults
                .Where(item => item.TeamId != row.TeamId)
                .ToList();

            evolutionRankings = await FetchEvolutionRankingsAsync();
            fullEvolution = MergeEvolutionData(fullEvolution ?? evolution, addedEvolution);
            evolution = MergeEvolutionData(evolution ?? fullEvolution, addedEvolution);
            foreach (var series in addedEvolution.Series)
            {
                evolutionVisibleRatedPointCounts[series.TeamId] = series.RatedPointCount;
            }

            RebuildEvolutionChartSeries(resetViewport: false);
            CaptureActiveRankingsCacheEntry();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not add {row.TeamName}: {ex.Message}";
        }
        finally
        {
            isGraphSelectionBusy = false;
        }
    }

    private Task RemoveGraphTeamAsync(Guid teamId)
    {
        CancelEvolutionRefinement();
        graphTeamIds.Remove(teamId);
        hiddenGraphTeamIds.Remove(teamId);
        manualGraphTeamIds.Remove(teamId);
        if (evolutionRankings is not null)
        {
            var selectedRows = graphTeamRows
                .Where(row => graphTeamIds.Contains(row.TeamId))
                .ToList();
            evolutionRankings = evolutionRankings with
            {
                Rankings = selectedRows,
                PageSize = selectedRows.Count,
                TotalCount = selectedRows.Count,
                TotalPages = 1
            };
            RebuildEvolutionChartSeries(resetViewport: false);
            CaptureActiveRankingsCacheEntry();
        }

        return Task.CompletedTask;
    }

    private async Task ReloadGraphAsync()
    {
        CancelEvolutionRefinement();
        evolution = null;
        fullEvolution = null;
        evolutionRankings = null;
        evolutionChartSeries = [];
        lastEvolutionApiUri = null;
        lastEvolutionRankingsApiUri = null;
        await LoadChartAsync();
    }

    private async Task<IReadOnlyList<EloRankingRow>> FetchAllRankingRowsAsync(bool includeTeamSearch)
    {
        var firstResponse = await FetchRankingResponseAsync(1, 100, includeTeamSearch);
        if (firstResponse is null || firstResponse.Rankings.Count == 0)
        {
            return [];
        }

        if (firstResponse.TotalPages <= 1)
        {
            return firstResponse.Rankings.ToList();
        }

        var rows = firstResponse.Rankings.ToList();
        for (var nextPage = 2; nextPage <= firstResponse.TotalPages; nextPage++)
        {
            rows.AddRange(await FetchRankingRowsAsync(nextPage, 100, includeTeamSearch));
        }

        return rows;
    }

    private async Task<IReadOnlyList<EloRankingRow>> FetchRankingRowsAsync(
        int requestedPage,
        int requestedPageSize,
        bool includeTeamSearch,
        string? teamOverride = null)
    {
        var result = await FetchRankingResponseAsync(requestedPage, requestedPageSize, includeTeamSearch, teamOverride);
        return result?.Rankings?.ToList() ?? [];
    }

    private async Task<IReadOnlyList<EloRankingRow>> FetchGraphSearchRowsAsync(
        string? searchText,
        CancellationToken cancellationToken)
    {
        var result = await Http.GetFromJsonAsync<EloRankingsResponse>(
            BuildApiUri(1, 100, includeTeamSearch: true, teamOverride: searchText),
            cancellationToken);
        return result?.Rankings?.ToList() ?? [];
    }

    private Task<EloRankingsResponse?> FetchRankingResponseAsync(
        int requestedPage,
        int requestedPageSize,
        bool includeTeamSearch,
        string? teamOverride = null)
        => Http.GetFromJsonAsync<EloRankingsResponse>(BuildApiUri(
            requestedPage,
            requestedPageSize,
            includeTeamSearch,
            teamOverride));

    private IReadOnlyList<EloRankingRow> MergeGraphTeamRows(IReadOnlyCollection<EloRankingRow> rows)
        => graphTeamRows
            .Concat(rows)
            .GroupBy(row => row.TeamId)
            .Select(group => group.First())
            .OrderByDescending(row => row.Elo)
            .ThenBy(row => row.TeamName)
            .ToList();

