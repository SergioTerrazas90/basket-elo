    private string? ResolveCountrySearch(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var countries = response?.Filters.Countries ?? [];
        var canonical = countries.FirstOrDefault(country =>
            string.Equals(country, value.Trim(), StringComparison.OrdinalIgnoreCase));
        if (canonical is not null)
        {
            return canonical;
        }

        return countries.FirstOrDefault(country =>
            CountryAliases.TryGetValue(country, out var aliases) &&
            aliases.Any(alias => string.Equals(alias, value.Trim(), StringComparison.OrdinalIgnoreCase)));
    }

    private EloRankingCompetitionOption? ResolveCompetitionSearch(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var search = value.Trim();
        return FilteredCompetitionOptions.FirstOrDefault(option =>
                   string.Equals(CompetitionOptionDisplay(option), search, StringComparison.OrdinalIgnoreCase))
               ?? FilteredCompetitionOptions.FirstOrDefault(option =>
                   string.Equals(option.Name, search, StringComparison.OrdinalIgnoreCase));
    }

