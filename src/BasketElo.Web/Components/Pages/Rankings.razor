@page "/"
@page "/rankings"
@page "/movers"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using BasketElo.Domain.Elo
@using BasketElo.Domain.Entities
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Basket ELO @ViewTitle()</PageTitle>

<div class="rankings-page">
    <header class="rankings-header">
        <nav class="rating-pool-tabs" aria-label="Rating pools">
            @foreach (var option in EloPoolCatalog.All.OrderBy(x => x.DisplayOrder))
            {
                <button type="button" class="@PoolTabClass(option.Key)" @onclick="() => SelectPoolAsync(option.Key)" disabled="@isBusy">
                    @(option.Key == EloPoolKeys.EuropeClubs ? "Europe" : option.Key == EloPoolKeys.NationalTeams ? "National teams" : option.DisplayName)
                </button>
            }
        </nav>

        <div class="rankings-context-bar">
            <div>
                <strong>@PoolHeading()</strong>
                <span>@PoolIntroduction()</span>
            </div>
            <nav class="rankings-view-tabs" aria-label="Ranking views">
                <button type="button" class='@ViewTabClass("rankings")' @onclick='() => SelectViewAsync("rankings")' disabled="@isBusy">Rankings</button>
                <button type="button" class='@ViewTabClass("results")' @onclick='() => SelectViewAsync("results")' disabled="@isBusy">Results</button>
                <button type="button" class='@ViewTabClass("graph-svg")' @onclick='() => SelectViewAsync("graph-svg")' disabled="@isBusy">Graph SVG</button>
                <button type="button" class='@ViewTabClass("graph-canvas")' @onclick='() => SelectViewAsync("graph-canvas")' disabled="@isBusy">Graph Canvas</button>
            </nav>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <section class="ranking-toolbar" aria-label="Ranking controls">
        @if (SupportsTeamScope)
        {
            <div class="scope-control-block">
                <span class="filter-label">@(selectedPool == EloPoolKeys.Nba ? "Franchises" : "Teams")</span>
                <div class="franchise-scope-control" role="group" aria-label="@TeamScopeAriaLabel()">
                    <button type="button" class="@TeamScopeClass(EloTeamScopes.Current)" @onclick="() => SelectTeamScopeAsync(EloTeamScopes.Current)" disabled="@isBusy">
                        Current
                    </button>
                    <button type="button" class="@TeamScopeClass(EloTeamScopes.Historical)" @onclick="() => SelectTeamScopeAsync(EloTeamScopes.Historical)" disabled="@isBusy">
                        Historical
                    </button>
                </div>
            </div>
        }

        <div class="filter-field team-search-field">
            <label for="teamSearch">Team</label>
            <div class="clearable-field">
                <input id="teamSearch" class="form-control" @bind="teamSearch" @bind:event="oninput" placeholder="Search teams" />
                <button type="button" class="clear-filter" aria-label="Clear team search" title="Clear team search" @onclick="ClearTeamSearch" disabled="@(!HasTeamSearch)">
                    &times;
                </button>
            </div>
        </div>

        <button type="button"
                class="filter-toggle"
                aria-expanded="@showAdvancedFilters"
                aria-controls="advanced-ranking-filters"
                @onclick="ToggleAdvancedFilters">
            <span>Filters</span>
            @if (ActiveFilterCount > 0)
            {
                <span class="filter-count" aria-label="@($"{ActiveFilterCount} active filters")">@ActiveFilterCount</span>
            }
            <span class="filter-toggle-icon" aria-hidden="true">@(showAdvancedFilters ? "−" : "+")</span>
        </button>

        @if (HasActiveFilters)
        {
            <button type="button" class="clear-all-filters" @onclick="ResetFiltersAsync" disabled="@isBusy">
                Clear all
            </button>
        }
    </section>

    @if (HasActiveFilters)
    {
        <div class="active-filters" aria-label="Active ranking filters">
            @if (!string.IsNullOrWhiteSpace(teamSearch))
            {
                <button type="button" class="filter-chip" @onclick="ClearTeamSearch">
                    Team: @teamSearch <span aria-hidden="true">×</span>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(selectedCountry))
            {
                <button type="button" class="filter-chip" @onclick="ClearCountryFilterAsync">
                    Country: @selectedCountry <span aria-hidden="true">×</span>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(selectedCompetition))
            {
                <button type="button" class="filter-chip" @onclick="ClearCompetitionFilterAsync">
                    Competition: @selectedCompetition <span aria-hidden="true">×</span>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(selectedFromSeason) || !string.IsNullOrWhiteSpace(selectedToSeason))
            {
                <button type="button" class="filter-chip" @onclick="ClearSeasonFilterAsync">
                    Seasons: @(selectedFromSeason ?? "All") – @(selectedToSeason ?? "Current") <span aria-hidden="true">×</span>
                </button>
            }
            @if (minimumGames > 0)
            {
                <button type="button" class="filter-chip" @onclick="ClearMinimumGamesFilterAsync">
                    Min games: @minimumGames <span aria-hidden="true">×</span>
                </button>
            }
        </div>
    }

    @if (showAdvancedFilters)
    {
        <section id="advanced-ranking-filters" class="advanced-filters" aria-label="Additional ranking filters">
            @if (HasCountryFilter)
            {
                <div class="filter-field">
                    <label for="countryFilter">Country</label>
                    <select id="countryFilter" class="form-select" @bind="selectedCountry" @bind:after="CountryFilterChanged">
                        <option value="">All countries</option>
                        @foreach (var option in response?.Filters.Countries ?? [])
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
            }

            @if (HasCompetitionFilter)
            {
                <div class="filter-field">
                    <label for="competitionFilter">Competition</label>
                    <select id="competitionFilter" class="form-select" @bind="selectedCompetition">
                        <option value="">All competitions</option>
                        @foreach (var option in FilteredCompetitionOptions)
                        {
                            <option value="@option.Name">@option.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="season-range-field">
                <span class="filter-label">Seasons</span>
                <div class="season-range-control">
                    <select id="fromSeasonFilter" class="form-select" aria-label="From season" @bind="selectedFromSeason">
                        <option value="">All history</option>
                        @foreach (var option in response?.Filters.Seasons ?? [])
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    <span aria-hidden="true">to</span>
                    <select id="toSeasonFilter" class="form-select" aria-label="To season" @bind="selectedToSeason">
                        <option value="">Current</option>
                        @foreach (var option in response?.Filters.Seasons ?? [])
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
            </div>

            <div class="filter-field compact">
                <label for="minGames">Min games</label>
                <input id="minGames" class="form-control" type="number" min="0" max="999" @bind="minimumGames" />
            </div>

            <div class="filter-actions">
                <button class="btn btn-primary" @onclick="ApplyFiltersAsync" disabled="@isBusy">Apply</button>
                <button class="btn btn-outline-secondary" @onclick="ResetFiltersAsync" disabled="@isBusy">Reset</button>
            </div>
        </section>
    }

    @if (isBusy && response is null)
    {
        <section class="loading-panel">Loading rankings...</section>
    }
    else if (response is not null)
    {
        <section class="results-header" aria-label="Ranking snapshot">
            <div class="results-context">
                <span class="results-kicker">@((selectedView == "movers") ? "Movement view" : "Current rankings")</span>
                <strong>@response.Summary.FilteredTeams <span>of @response.Summary.RatedTeams teams</span></strong>
                <small class="results-scope-detail">@ScopeDetail()</small>
            </div>
            <dl class="snapshot-metadata">
                <div>
                    <dt>@LatestGameLabel()</dt>
                    <dd>@FormatDate(response.Summary.LatestGameUtc)</dd>
                </div>
                <div>
                    <dt>@LeaderLabel()</dt>
                    <dd>@(response.Summary.TopTeamName ?? "-") <span>(@FormatRating(response.Summary.TopTeamElo))</span></dd>
                </div>
                <div>
                    <dt>Ruleset</dt>
                    <dd>@response.RulesetVersion</dd>
                </div>
            </dl>
        </section>

        @if (IsArchiveMode)
        {
            <section class="archive-state">
                <strong>@ArchiveStateTitle()</strong>
                <span>@ArchiveStateDetail()</span>
            </section>
        }

        @if (selectedView == "movers")
        {
            <section class="movers-section">
                <div class="section-head">
                    <div>
                        <h2>@MoversTitle()</h2>
                        <p>@MoversContextLabel()</p>
                    </div>
                    <div class="pager">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(isBusy || CurrentPage <= 1)">Previous</button>
                        <label class="page-jump" for="moversPageInput">
                            <span>Page</span>
                            <input id="moversPageInput" class="form-control form-control-sm" type="number" min="1" max="@CurrentTotalPages" @bind="requestedPage" @onkeydown="HandlePageInputKeyDown" />
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="GoToRequestedPageAsync" disabled="@isBusy">Go</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextPageAsync" disabled="@(isBusy || CurrentPage >= CurrentTotalPages)">Next</button>
                    </div>
                </div>

                <div class="movers-toolbar" aria-label="Movement controls">
                    <label for="moverDirection">
                        <span>Movement</span>
                        <select id="moverDirection" class="form-select form-select-sm" value="@selectedMoverDirection" @onchange="ChangeMoverDirectionAsync">
                            <option value="risers">Risers</option>
                            <option value="fallers">Fallers</option>
                        </select>
                    </label>
                    <label for="windowDays">
                        <span>Window</span>
                        <select id="windowDays" class="form-select form-select-sm" value="@selectedWindowDays" @onchange="ChangeMoverWindowAsync">
                            <option value="7">7 days</option>
                            <option value="30">30 days</option>
                            <option value="90">90 days</option>
                        </select>
                    </label>
                </div>

                <div class="table-responsive ranking-table-wrap">
                    <table class="table table-hover align-middle ranking-table">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Team</th>
                                @if (ShowsCountryColumn)
                                {
                                    <th>Country</th>
                                }
                                <th class="numeric">Change</th>
                                <th class="numeric">Start</th>
                                <th class="numeric">End</th>
                                <th class="numeric">Current</th>
                                <th class="numeric">Games</th>
                                <th>Latest</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (movers is null || movers.Movers.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="empty-state">No rating movement is available for the selected scope.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in movers.Movers)
                                {
                                    <tr class="team-row" tabindex="0" @onclick="() => OpenTeam(row.TeamId)" @onkeydown="args => OpenTeamFromKeyboard(args, row.TeamId)">
                                        <td class="rank-cell">#@row.Rank</td>
                                        <td>
                                            <div class="team-identity-cell">
                                                <div>
                                                    <a class="team-link" href="@BuildTeamHref(row.TeamId)" @onclick:stopPropagation="true">@row.TeamName</a>
                                                    @if (!row.IsActive)
                                                    {
                                                        <span class="franchise-status">@HistoricalTeamLabel()</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        @if (ShowsCountryColumn)
                                        {
                                            <td><a class="context-link" href="@RankingsContextHref(country: row.Country)" @onclick:stopPropagation="true">@row.Country</a></td>
                                        }
                                        <td class="numeric"><span class="@MovementClass(row.EloChange)">@FormatMovement(row.EloChange)</span></td>
                                        <td class="numeric">@row.StartElo.ToString("0")</td>
                                        <td class="numeric">@row.EndElo.ToString("0")</td>
                                        <td class="numeric rating">@row.CurrentElo.ToString("0")</td>
                                        <td class="numeric">@row.GamesInWindow</td>
                                        <td>@FormatDate(row.LastGameUtc)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        @if (selectedView == "results")
        {
            <section class="results-section">
                <div class="section-head">
                    <div>
                        <h2>Recent results</h2>
                        <p>Finished games from the last 30 days in the selected rating pool, newest first.</p>
                    </div>
                    <div class="pager">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(isBusy || CurrentPage <= 1)">Previous</button>
                        <span class="pager-status">Page @CurrentPage of @CurrentTotalPages</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextPageAsync" disabled="@(isBusy || CurrentPage >= CurrentTotalPages)">Next</button>
                    </div>
                </div>

                <div class="table-responsive ranking-table-wrap">
                    <table class="table table-hover align-middle results-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Competition</th>
                                <th>Match</th>
                                <th class="numeric">Score</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (results is null || results.Results.Count == 0)
                            {
                                <tr><td colspan="4" class="empty-state">No completed results match the current filters.</td></tr>
                            }
                            else
                            {
                                @foreach (var row in results.Results)
                                {
                                    <tr>
                                        <td>@FormatDate(row.GameDateTimeUtc)</td>
                                        <td><strong>@row.Competition</strong><span class="result-meta">@row.Country · @row.Season</span></td>
                                        <td>@row.HomeTeam <span class="result-separator">vs</span> @row.AwayTeam</td>
                                        <td class="numeric result-score">@row.HomeScore–@row.AwayScore</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (selectedView == "rankings")
        {
            <section class="rankings-table-section">
                <div class="section-head">
                    <div>
                        <h2>Ranking table</h2>
                        <p>@TableContextLabel()</p>
                    </div>
                    <div class="pager">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(isBusy || CurrentPage <= 1)">Previous</button>
                        <label class="page-jump" for="rankingsPageInput">
                            <span>Page</span>
                            <input id="rankingsPageInput" class="form-control form-control-sm" type="number" min="1" max="@CurrentTotalPages" @bind="requestedPage" @onkeydown="HandlePageInputKeyDown" />
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="GoToRequestedPageAsync" disabled="@isBusy">Go</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextPageAsync" disabled="@(isBusy || CurrentPage >= CurrentTotalPages)">Next</button>
                    </div>
                </div>

                <div class="table-responsive ranking-table-wrap">
                    <table class="table table-hover align-middle ranking-table @(ShowsGlobalRank ? "with-global-rank" : string.Empty)">
                        <thead>
                            <tr>
                                @if (ShowRankingColumn("rank"))
                                {
                                    <th class="sticky-column rank-column" scope="col">Rank</th>
                                }
                                @if (ShowRankingColumn("globalRank"))
                                {
                                    <th class="sticky-column global-rank-column" scope="col">Global rank</th>
                                }
                                @if (ShowRankingColumn("team"))
                                {
                                    <th class="sticky-column team-column" scope="col">Team</th>
                                }
                                @if (ShowRankingColumn("country"))
                                {
                                    <th scope="col">Country</th>
                                }
                                @if (ShowRankingColumn("elo"))
                                {
                                    <th class="numeric" scope="col">ELO</th>
                                }
                                @if (ShowRankingColumn("games"))
                                {
                                    <th class="numeric" scope="col">Games</th>
                                }
                                @if (ShowRankingColumn("movement"))
                                {
                                    <th class="numeric" scope="col">Last</th>
                                }
                                @if (ShowRankingColumn("lastGame"))
                                {
                                    <th scope="col">Last game</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (response.Rankings.Count == 0)
                            {
                                <tr>
                                    <td colspan="@RankingTableColumnCount" class="empty-state">@(selectedPool == EloPoolKeys.NationalTeams ? "National team ratings are not available yet." : "No teams match the current filters.")</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in response.Rankings)
                                {
                                    <tr class="team-row" tabindex="0" @onclick="() => OpenTeam(row.TeamId)" @onkeydown="args => OpenTeamFromKeyboard(args, row.TeamId)">
                                        @if (ShowRankingColumn("rank"))
                                        {
                                            <td class="rank-cell sticky-column rank-column">#@row.Rank</td>
                                        }
                                        @if (ShowRankingColumn("globalRank"))
                                        {
                                            <td class="muted-rank sticky-column global-rank-column">#@row.GlobalRank</td>
                                        }
                                        @if (ShowRankingColumn("team"))
                                        {
                                            <td class="sticky-column team-column">
                                            <div class="team-identity-cell">
                                                <div>
                                                    <a class="team-link" href="@BuildTeamHref(row.TeamId)" @onclick:stopPropagation="true">@row.TeamName</a>
                                                    @if (!row.IsActive)
                                                    {
                                                        <span class="franchise-status">@HistoricalTeamLabel()</span>
                                                    }
                                                </div>
                                            </div>
                                            </td>
                                        }
                                        @if (ShowRankingColumn("country"))
                                        {
                                            <td><a class="context-link" href="@RankingsContextHref(country: row.Country)" @onclick:stopPropagation="true">@row.Country</a></td>
                                        }
                                        @if (ShowRankingColumn("elo"))
                                        {
                                            <td class="numeric rating">@row.Elo.ToString("0")</td>
                                        }
                                        @if (ShowRankingColumn("games"))
                                        {
                                            <td class="numeric">@row.GamesPlayed</td>
                                        }
                                        @if (ShowRankingColumn("movement"))
                                        {
                                            <td class="numeric">
                                                <span class="@MovementClass(row.RecentMovement)">@FormatMovement(row.RecentMovement)</span>
                                            </td>
                                        }
                                        @if (ShowRankingColumn("lastGame"))
                                        {
                                            <td>@FormatDate(row.LastGameUtc)</td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if ((selectedView == "rankings" || IsGraphView) && response.Rankings.Count > 0)
        {
            <section class="evolution-section">
                <div class="section-head evolution-section-head">
                    <div>
                        <h2>@(IsGraphView ? "ELO evolution" : "Explore the graph")</h2>
                        <p>@EvolutionContextLabel()</p>
                    </div>
                    <div class="evolution-section-actions">
                        @if (selectedView == "rankings")
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    aria-expanded="@isChartVisible"
                                    aria-controls="ranking-evolution-panel"
                                    @onclick="ToggleChartAsync">
                                @(isChartVisible ? "Hide chart" : "Show chart")
                            </button>
                        }
                        @if (isChartVisible || IsGraphView)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    aria-expanded="@isGraphTeamManagerOpen"
                                    aria-controls="chart-team-manager"
                                    @onclick="ToggleGraphTeamManager">
                                Manage teams <span class="chart-count-badge">@graphTeamIds.Count</span>
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    aria-pressed="@showGraphLegend"
                                    @onclick="ToggleGraphLegend">
                                Legend: @(showGraphLegend ? "On" : "Off")
                            </button>
                        }
                    </div>
                </div>

                @if (isChartVisible || IsGraphView)
                {
                    <div id="ranking-evolution-panel" class="evolution-panel" role="region" aria-label="ELO evolution chart">
                        @if (isChartLoading)
                        {
                            <div class="loading-panel">Loading chart...</div>
                        }
                        else
                        {
                            <div class="evolution-workspace @(isGraphTeamManagerOpen ? "manager-open" : string.Empty)">
                                @if (isGraphTeamManagerOpen)
                                {
                                    <aside id="chart-team-manager" class="graph-team-manager" aria-label="Chart team manager">
                                        <div class="graph-team-manager-heading">
                                            <div>
                                                <strong>Chart teams</strong>
                                                <span>@graphTeamIds.Count selected · @VisibleGraphTeamCount visible</span>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-quiet" @onclick="ToggleGraphTeamManager">Collapse</button>
                                        </div>

                                        <p class="graph-team-manager-help">Use the eye to show or hide a line. Remove teams from the chart using the team menu.</p>

                                        <div class="graph-team-search">
                                            <label for="graphTeamSearch">Add or manage teams</label>
                                            <div class="graph-team-search-row">
                                                <input id="graphTeamSearch" class="form-control" @bind="graphTeamSearch" @bind:event="oninput" placeholder="Search teams" />
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SearchGraphTeamsAsync" disabled="@(isGraphSelectionBusy || string.IsNullOrWhiteSpace(graphTeamSearch))">Search</button>
                                            </div>
                                        </div>

                                        <div class="graph-bulk-actions">
                                            @if (!string.IsNullOrWhiteSpace(selectedCountry))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddCountryTeamsToGraphAsync" disabled="@isGraphSelectionBusy">Add all @selectedCountry</button>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(selectedCompetition))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddCompetitionTeamsToGraphAsync" disabled="@isGraphSelectionBusy">Add all @selectedCompetition</button>
                                            }
                                        </div>

                                        @if (graphTeamSearchResults.Count > 0)
                                        {
                                            <div class="graph-team-search-results" aria-label="Team search results">
                                                @foreach (var row in graphTeamSearchResults)
                                                {
                                                    var isAdded = graphTeamIds.Contains(row.TeamId);
                                                    <div class="graph-team-search-result">
                                                        <span>@row.TeamName <small>@row.Country</small></span>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(isAdded || isGraphSelectionBusy)" @onclick="() => AddGraphTeamAsync(row)">@(isAdded ? "Added" : "Add")</button>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (SelectedGraphTeams.Count == 0)
                                        {
                                            <p class="graph-selection-empty">No teams selected. Search for a team or add teams from the active country or competition.</p>
                                        }
                                        else
                                        {
                                            <div class="graph-team-manager-list-heading">
                                                <span>Legend</span>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ShowAllGraphTeamsAsync" disabled="@(hiddenGraphTeamIds.Count == 0)">Show all</button>
                                            </div>
                                            <div class="graph-team-manager-list" aria-label="Chart legend and selected teams">
                                                @foreach (var team in SelectedGraphTeams)
                                                {
                                                    var isVisible = IsGraphTeamVisible(team.TeamId);
                                                    <div class="graph-team-manager-row @(isVisible ? "is-visible" : "is-hidden")">
                                                        <span class="graph-team-color-swatch" style="background: @GraphTeamColor(team.TeamId)" aria-hidden="true"></span>
                                                        <span class="graph-team-manager-name" title="@team.TeamName">@team.TeamName <small>@team.Country</small></span>
                                                        <button type="button" class="graph-team-visibility-toggle" aria-pressed="@isVisible" aria-label="@(isVisible ? $"Hide {team.TeamName}" : $"Show {team.TeamName}")" title="@(isVisible ? "Hide line" : "Show line")" @onclick="() => ToggleGraphTeamVisibilityAsync(team.TeamId)">
                                                            <span class="graph-eye-icon" aria-hidden="true"></span>
                                                        </button>
                                                        <button type="button" class="graph-team-remove-button" aria-label="Remove @team.TeamName from chart" title="Remove from chart" @onclick="() => RemoveGraphTeamAsync(team.TeamId)">&times;</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </aside>
                                }

                                <div class="@EvolutionChartClass" role="img" aria-label="ELO evolution for teams in the current ranking table">
                                    @if (EvolutionSeries.Count < 1 || EvolutionSeries.All(x => x.Points.Count < 2))
                                    {
                                        <div class="empty-state">Not enough rated games for an evolution chart yet.</div>
                                    }
                                    else
                                    {
                                        <EloEvolutionChart @key="@($"{activeRankingsCacheKey}:{selectedView}")"
                                                           Series="@evolutionChartSeries"
                                                           EnableRangeNavigation="true"
                                                           ShowLegend="false"
                                                           ShowSeriesControls="@(showGraphLegend && !isGraphTeamManagerOpen)"
                                                           CompareRenderers="false"
                                                           UseDygraphs="@(selectedView == "graph-canvas")"
                                                           ShowDiagnostics="@isAdmin"
                                                           HiddenTeamIds="@HiddenGraphTeamIds"
                                                           SeriesVisibilityChanged="@ToggleGraphTeamVisibilityAsync"
                                                           ShowAllSeriesRequested="@ShowAllGraphTeamsAsync"
                                                           SharedTooltip="false"
                                                           HeightPixels="@ChartHeightPixels"
                                                           DataRevision="@evolutionDataRevision"
                                                           IsRefining="@isEvolutionRefining"
                                                           ViewportRefinementRequested="@QueueEvolutionRefinementAsync"
                                                           FullRangeRequested="@RestoreFullEvolutionAsync" />

                                    }
                                </div>
                            </div>
                            <div class="chart-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleChartSize">
                                    @(isChartExpanded ? "Compact chart" : "Expand chart")
                                </button>
                            </div>
                        }
                    </div>
                }
            </section>
        }

    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "pool")]
    public string? Pool { get; set; }

    [SupplyParameterFromQuery(Name = "country")]
    public string? Country { get; set; }

    [SupplyParameterFromQuery(Name = "competition")]
    public string? Competition { get; set; }

    [SupplyParameterFromQuery(Name = "season")]
    public string? Season { get; set; }

    [SupplyParameterFromQuery(Name = "fromSeason")]
    public string? FromSeason { get; set; }

    [SupplyParameterFromQuery(Name = "toSeason")]
    public string? ToSeason { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? From { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? To { get; set; }

    [SupplyParameterFromQuery(Name = "minGames")]
    public int? MinGames { get; set; }

    [SupplyParameterFromQuery(Name = "team")]
    public string? Team { get; set; }

    [SupplyParameterFromQuery(Name = "teams")]
    public string? Teams { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    [SupplyParameterFromQuery(Name = "movement")]
    public string? Movement { get; set; }

    [SupplyParameterFromQuery(Name = "windowDays")]
    public int? WindowDays { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    private EloRankingsResponse? response;
    private EloMoversResponse? movers;
    private EloResultsResponse? results;
    private EloRankingsEvolutionResponse? evolution;
    private EloRankingsEvolutionResponse? fullEvolution;
    private EloRankingsResponse? evolutionRankings;
    private IReadOnlyList<EloChartSeries> evolutionChartSeries = [];
    private bool isBusy;
    private bool isChartExpanded;
    private bool isChartVisible;
    private bool isChartLoading;
    private bool isAdmin;
    private bool isGraphTeamManagerOpen;
    private bool showGraphLegend = true;
    private bool showAdvancedFilters;
    private string? errorMessage;
    private string? selectedCountry;
    private string? selectedCompetition;
    private string selectedPool = EloPoolKeys.Default;
    private string selectedTeamScope = EloTeamScopes.Current;
    private string? selectedFromSeason;
    private string? selectedToSeason;
    private string? teamSearch;
    private int minimumGames;
    private int page = 1;
    private int requestedPage = 1;
    private string selectedView = "rankings";
    private string selectedMoverDirection = "risers";
    private int selectedWindowDays = 30;
    private string? lastLoadedUri;
    private string? lastRankingsApiUri;
    private string? lastMoversApiUri;
    private string? lastResultsApiUri;
    private string? lastEvolutionRankingsApiUri;
    private string? lastEvolutionApiUri;
    private RankingsClientCacheKey? activeRankingsCacheKey;
    private long evolutionDataRevision;
    private bool isEvolutionRefining;
    private readonly Dictionary<Guid, int> evolutionVisibleRatedPointCounts = new();
    private CancellationTokenSource? evolutionRefinementCancellation;
    private readonly Dictionary<RankingsClientCacheKey, RankingsClientCacheEntry> rankingsClientCache = new();
    private readonly Dictionary<string, EloRankingsEvolutionResponse> evolutionRangeCache = new(StringComparer.Ordinal);
    private readonly Queue<string> evolutionRangeCacheOrder = new();

    private const int EvolutionRefinementDebounceMilliseconds = 600;
    private const int EvolutionRangeCacheLimit = 8;
    private const int MaxManualGraphTeams = 200;

    private readonly HashSet<Guid> graphTeamIds = [];
    private readonly HashSet<Guid> graphBulkTeamIds = [];
    private readonly HashSet<Guid> manualGraphTeamIds = [];
    private readonly HashSet<Guid> hiddenGraphTeamIds = [];
    private IReadOnlyList<EloRankingRow> graphTeamRows = [];
    private IReadOnlyList<EloRankingRow> graphTeamSearchResults = [];
    private string? graphTeamSearch;
    private bool graphSelectionInitialized;
    private bool isGraphSelectionBusy;

    private sealed record RankingsClientCacheKey(
        string Pool,
        string View,
        string RankingsUri,
        string MoverDirection,
        int MoverWindowDays);

    private sealed class RankingsClientCacheEntry
    {
        public EloRankingsResponse? Rankings { get; set; }
        public EloMoversResponse? Movers { get; set; }
        public EloResultsResponse? Results { get; set; }
        public EloRankingsEvolutionResponse? Evolution { get; set; }
        public EloRankingsEvolutionResponse? FullEvolution { get; set; }
        public EloRankingsResponse? EvolutionRankings { get; set; }
        public IReadOnlyList<EloChartSeries> EvolutionChartSeries { get; set; } = [];
        public Dictionary<Guid, int> EvolutionVisibleRatedPointCounts { get; set; } = new();
        public string? RankingsApiUri { get; set; }
        public string? MoversApiUri { get; set; }
        public string? ResultsApiUri { get; set; }
        public string? EvolutionRankingsApiUri { get; set; }
        public string? EvolutionApiUri { get; set; }
        public long EvolutionDataRevision { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        var authenticationState = AuthenticationStateTask is null
            ? null
            : await AuthenticationStateTask;
        isAdmin = authenticationState?.User.IsInRole(ApplicationRoleKeys.Admin) == true;

        var currentUri = Navigation.Uri;
        if (currentUri == lastLoadedUri)
        {
            return;
        }

        CaptureActiveRankingsCacheEntry();

        selectedPool = EloPoolKeys.IsSupported(Pool?.Trim().ToLowerInvariant() ?? string.Empty)
            ? Pool!.Trim().ToLowerInvariant()
            : EloPoolKeys.Default;
        selectedTeamScope = SupportsTeamScope
            ? EloTeamScopes.Normalize(Teams)
            : EloTeamScopes.Current;
        selectedCountry = Country;
        selectedCompetition = Competition;
        selectedFromSeason = FromSeason;
        selectedToSeason = ToSeason;
        if (!string.IsNullOrWhiteSpace(Season) && string.IsNullOrWhiteSpace(selectedFromSeason) && string.IsNullOrWhiteSpace(selectedToSeason))
        {
            selectedFromSeason = Season;
            selectedToSeason = Season;
        }
        else
        {
            ApplyLegacyDateRange();
        }
        minimumGames = Math.Max(0, MinGames ?? 0);
        teamSearch = Team;
        var currentPath = Navigation.ToBaseRelativePath(currentUri).Split('?', 2)[0].Trim('/');
        var isMoversRoute = string.Equals(currentPath, "movers", StringComparison.OrdinalIgnoreCase);
        selectedView = isMoversRoute || string.Equals(View, "movers", StringComparison.OrdinalIgnoreCase)
            ? "movers"
            : View?.Trim().ToLowerInvariant() switch
            {
                "results" => "results",
                "graph" or "graph-canvas" => "graph-canvas",
                "graph-svg" => "graph-svg",
                _ => "rankings"
            };
        selectedMoverDirection = string.Equals(Movement, "fallers", StringComparison.OrdinalIgnoreCase) ? "fallers" : "risers";
        selectedWindowDays = WindowDays is 7 or 30 or 90 ? WindowDays.Value : 30;
        showAdvancedFilters = HasAdvancedFilterValues;
        isChartVisible = IsGraphView;
        isChartExpanded = false;
        isChartLoading = false;
        page = Math.Max(1, Page ?? 1);
        requestedPage = page;
        lastLoadedUri = currentUri;
        CancelEvolutionRefinement();
        evolutionRangeCache.Clear();
        evolutionRangeCacheOrder.Clear();
        ResetGraphSelection();

        activeRankingsCacheKey = null;
        response = null;
        movers = null;
        results = null;
        evolution = null;
        evolutionRankings = null;
        evolutionChartSeries = [];
        fullEvolution = null;

        await RefreshAsync();
        if (IsGraphView)
        {
            await LoadChartAsync();
        }
    }

    private async Task ApplyFiltersAsync()
    {
        await RefreshSelectionAsync(1);
    }

    private async Task ResetFiltersAsync()
    {
        selectedTeamScope = EloTeamScopes.Current;
        selectedCountry = null;
        selectedCompetition = null;
        selectedFromSeason = null;
        selectedToSeason = null;
        minimumGames = 0;
        teamSearch = null;
        await RefreshSelectionAsync(1);
    }

    private Task SelectTeamScopeAsync(string teamScope)
    {
        selectedTeamScope = EloTeamScopes.Normalize(teamScope);
        NavigateToRankings(1);
        return Task.CompletedTask;
    }

    private Task SelectPoolAsync(string poolKey)
    {
        selectedPool = EloPoolKeys.Normalize(poolKey);
        selectedTeamScope = EloTeamScopes.Current;
        selectedCountry = null;
        selectedCompetition = null;
        selectedFromSeason = null;
        selectedToSeason = null;
        minimumGames = 0;
        teamSearch = null;
        page = 1;
        lastRankingsApiUri = null;
        lastMoversApiUri = null;
        lastEvolutionRankingsApiUri = null;
        lastEvolutionApiUri = null;
        NavigateToRankings(1);
        return Task.CompletedTask;
    }

    private async Task ClearTeamSearch()
    {
        teamSearch = null;
        await RefreshSelectionAsync(1);
    }

    private async Task ClearCountryFilterAsync()
    {
        selectedCountry = null;
        await RefreshSelectionAsync(1);
    }

    private void CountryFilterChanged()
    {
        if (!string.IsNullOrWhiteSpace(selectedCompetition) &&
            !FilteredCompetitionOptions.Any(option =>
                string.Equals(option.Name, selectedCompetition, StringComparison.OrdinalIgnoreCase)))
        {
            selectedCompetition = null;
        }
    }

    private async Task ClearCompetitionFilterAsync()
    {
        selectedCompetition = null;
        await RefreshSelectionAsync(1);
    }

    private async Task ClearSeasonFilterAsync()
    {
        selectedFromSeason = null;
        selectedToSeason = null;
        await RefreshSelectionAsync(1);
    }

    private async Task ClearMinimumGamesFilterAsync()
    {
        minimumGames = 0;
        await RefreshSelectionAsync(1);
    }

    private void ToggleAdvancedFilters()
        => showAdvancedFilters = !showAdvancedFilters;

    private Task SelectViewAsync(string view)
    {
        selectedView = view switch
        {
            "results" or "graph-svg" or "graph-canvas" => view,
            "graph" => "graph-canvas",
            _ => "rankings"
        };
        page = 1;
        NavigateToRankings(1);
        return Task.CompletedTask;
    }

    private Task ChangeMoverDirectionAsync(ChangeEventArgs args)
    {
        selectedMoverDirection = string.Equals(args.Value?.ToString(), "fallers", StringComparison.OrdinalIgnoreCase)
            ? "fallers"
            : "risers";
        NavigateToRankings(1);
        return Task.CompletedTask;
    }

    private Task ChangeMoverWindowAsync(ChangeEventArgs args)
    {
        selectedWindowDays = int.TryParse(args.Value?.ToString(), out var value) && value is 7 or 30 or 90
            ? value
            : 30;
        NavigateToRankings(1);
        return Task.CompletedTask;
    }

    private async Task ToggleChartAsync()
    {
        isChartVisible = !isChartVisible;
        if (!isChartVisible)
        {
            return;
        }

        await LoadChartAsync();
    }

    private async Task LoadChartAsync()
    {
        if (isChartLoading || evolution is not null || response is null)
        {
            return;
        }

        isChartLoading = true;
        errorMessage = null;

        try
        {
            await EnsureGraphSelectionAsync();
            evolutionRankings = await FetchEvolutionRankingsAsync();
            evolution = await FetchEvolutionAsync();
            fullEvolution = evolution;
            RebuildEvolutionChartSeries();
            CaptureActiveRankingsCacheEntry();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load chart: {ex.Message}";
        }
        finally
        {
            isChartLoading = false;
        }
    }

    private async Task EnsureGraphSelectionAsync()
    {
        if (graphSelectionInitialized || response is null)
        {
            return;
        }

        var rows = HasGraphBulkScope
            ? await FetchAllRankingRowsAsync(includeTeamSearch: false)
            : response.Rankings.Take(20).ToList();

        graphTeamRows = MergeGraphTeamRows(rows);
        graphTeamIds.Clear();
        graphTeamIds.UnionWith(rows.Select(row => row.TeamId));
        hiddenGraphTeamIds.Clear();
        if (HasGraphBulkScope)
        {
            graphBulkTeamIds.UnionWith(rows.Select(row => row.TeamId));
        }
        graphSelectionInitialized = true;
    }

    private async Task AddCountryTeamsToGraphAsync()
        => await AddBulkGraphTeamsAsync($"country '{selectedCountry}'");

    private async Task AddCompetitionTeamsToGraphAsync()
        => await AddBulkGraphTeamsAsync($"competition '{selectedCompetition}'");

    private async Task AddBulkGraphTeamsAsync(string description)
    {
        if (!HasGraphBulkScope)
        {
            return;
        }

        isGraphSelectionBusy = true;
        errorMessage = null;
        try
        {
            var rows = await FetchAllRankingRowsAsync(includeTeamSearch: false);
            graphTeamRows = MergeGraphTeamRows(rows);
            graphTeamIds.UnionWith(rows.Select(row => row.TeamId));
            graphBulkTeamIds.UnionWith(rows.Select(row => row.TeamId));
            graphSelectionInitialized = true;
            graphTeamSearchResults = [];
            await ReloadGraphAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not add teams from {description}: {ex.Message}";
        }
        finally
        {
            isGraphSelectionBusy = false;
        }
    }

    private async Task SearchGraphTeamsAsync()
    {
        if (string.IsNullOrWhiteSpace(graphTeamSearch))
        {
            graphTeamSearchResults = [];
            return;
        }

        isGraphSelectionBusy = true;
        errorMessage = null;
        try
        {
            var rows = await FetchRankingRowsAsync(1, 100, includeTeamSearch: true, teamOverride: graphTeamSearch);
            graphTeamRows = MergeGraphTeamRows(rows);
            graphTeamSearchResults = rows;
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not search teams: {ex.Message}";
        }
        finally
        {
            isGraphSelectionBusy = false;
        }
    }

    private async Task AddGraphTeamAsync(EloRankingRow row)
    {
        if (graphTeamIds.Contains(row.TeamId))
        {
            return;
        }

        if (manualGraphTeamIds.Count >= MaxManualGraphTeams)
        {
            errorMessage = $"You can manually add up to {MaxManualGraphTeams} teams to the chart.";
            return;
        }

        graphTeamRows = MergeGraphTeamRows([row]);
        graphTeamIds.Add(row.TeamId);
        hiddenGraphTeamIds.Remove(row.TeamId);
        manualGraphTeamIds.Add(row.TeamId);
        graphSelectionInitialized = true;
        graphTeamSearchResults = graphTeamSearchResults
            .Where(item => item.TeamId != row.TeamId)
            .ToList();
        await ReloadGraphAsync();
    }

    private Task RemoveGraphTeamAsync(Guid teamId)
    {
        CancelEvolutionRefinement();
        graphTeamIds.Remove(teamId);
        hiddenGraphTeamIds.Remove(teamId);
        manualGraphTeamIds.Remove(teamId);
        graphTeamSearchResults = graphTeamSearchResults
            .Where(item => item.TeamId != teamId)
            .ToList();

        if (evolutionRankings is not null)
        {
            var selectedRows = graphTeamRows
                .Where(row => graphTeamIds.Contains(row.TeamId))
                .ToList();
            evolutionRankings = evolutionRankings with
            {
                Rankings = selectedRows,
                PageSize = selectedRows.Count,
                TotalCount = selectedRows.Count,
                TotalPages = 1
            };
            RebuildEvolutionChartSeries(resetViewport: false);
            CaptureActiveRankingsCacheEntry();
        }

        return Task.CompletedTask;
    }

    private async Task ReloadGraphAsync()
    {
        CancelEvolutionRefinement();
        evolution = null;
        fullEvolution = null;
        evolutionRankings = null;
        evolutionChartSeries = [];
        lastEvolutionApiUri = null;
        lastEvolutionRankingsApiUri = null;
        await LoadChartAsync();
    }

    private async Task<IReadOnlyList<EloRankingRow>> FetchAllRankingRowsAsync(bool includeTeamSearch)
    {
        var firstResponse = await FetchRankingResponseAsync(1, 100, includeTeamSearch);
        if (firstResponse is null || firstResponse.Rankings.Count == 0)
        {
            return [];
        }

        if (firstResponse.TotalPages <= 1)
        {
            return firstResponse.Rankings.ToList();
        }

        var rows = firstResponse.Rankings.ToList();
        for (var nextPage = 2; nextPage <= firstResponse.TotalPages; nextPage++)
        {
            rows.AddRange(await FetchRankingRowsAsync(nextPage, 100, includeTeamSearch));
        }

        return rows;
    }

    private async Task<IReadOnlyList<EloRankingRow>> FetchRankingRowsAsync(
        int requestedPage,
        int requestedPageSize,
        bool includeTeamSearch,
        string? teamOverride = null)
    {
        var result = await FetchRankingResponseAsync(requestedPage, requestedPageSize, includeTeamSearch, teamOverride);
        return result?.Rankings?.ToList() ?? [];
    }

    private Task<EloRankingsResponse?> FetchRankingResponseAsync(
        int requestedPage,
        int requestedPageSize,
        bool includeTeamSearch,
        string? teamOverride = null)
        => Http.GetFromJsonAsync<EloRankingsResponse>(BuildApiUri(
            requestedPage,
            requestedPageSize,
            includeTeamSearch,
            teamOverride));

    private IReadOnlyList<EloRankingRow> MergeGraphTeamRows(IReadOnlyCollection<EloRankingRow> rows)
        => graphTeamRows
            .Concat(rows)
            .GroupBy(row => row.TeamId)
            .Select(group => group.First())
            .OrderByDescending(row => row.Elo)
            .ThenBy(row => row.TeamName)
            .ToList();

    private void ResetGraphSelection()
    {
        graphTeamIds.Clear();
        graphBulkTeamIds.Clear();
        manualGraphTeamIds.Clear();
        hiddenGraphTeamIds.Clear();
        graphTeamRows = [];
        graphTeamSearchResults = [];
        graphTeamSearch = null;
        graphSelectionInitialized = false;
        isGraphSelectionBusy = false;
        isGraphTeamManagerOpen = false;
    }

    private void ToggleGraphTeamManager()
        => isGraphTeamManagerOpen = !isGraphTeamManagerOpen;

    private void ToggleGraphLegend()
        => showGraphLegend = !showGraphLegend;

    private Task ToggleGraphTeamVisibilityAsync(Guid teamId)
    {
        if (!graphTeamIds.Contains(teamId))
        {
            return Task.CompletedTask;
        }

        if (!hiddenGraphTeamIds.Add(teamId))
        {
            hiddenGraphTeamIds.Remove(teamId);
        }

        return Task.CompletedTask;
    }

    private Task ShowAllGraphTeamsAsync()
    {
        hiddenGraphTeamIds.Clear();
        return Task.CompletedTask;
    }

    private void ToggleChartSize()
    {
        isChartExpanded = !isChartExpanded;
    }

    private async Task PreviousPageAsync()
    {
        await RefreshSelectionAsync(Math.Max(1, CurrentPage - 1));
    }

    private async Task NextPageAsync()
    {
        await RefreshSelectionAsync(Math.Min(CurrentTotalPages, CurrentPage + 1));
    }

    private async Task GoToRequestedPageAsync()
    {
        await RefreshSelectionAsync(ClampRequestedPage(requestedPage, CurrentTotalPages));
    }

    private async Task HandlePageInputKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await GoToRequestedPageAsync();
        }
    }

    private async Task RefreshAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var rankingsUri = BuildApiUri();
            var cacheKey = BuildRankingsClientCacheKey(rankingsUri);
            if (rankingsClientCache.TryGetValue(cacheKey, out var cachedEntry))
            {
                RestoreRankingsCacheEntry(cacheKey, cachedEntry);
                return;
            }

            if (response is null ||
                !string.Equals(rankingsUri, lastRankingsApiUri, StringComparison.Ordinal) ||
                activeRankingsCacheKey != cacheKey)
            {
                response = await Http.GetFromJsonAsync<EloRankingsResponse>(rankingsUri);
                lastRankingsApiUri = rankingsUri;
            }

            if (response is not null)
            {
                page = response.Page;
                requestedPage = response.Page;
            }

            if (selectedView == "movers")
            {
                var moversUri = BuildMoversApiUri();
                if (movers is null || !string.Equals(moversUri, lastMoversApiUri, StringComparison.Ordinal))
                {
                    movers = await Http.GetFromJsonAsync<EloMoversResponse>(moversUri);
                    lastMoversApiUri = moversUri;
                }

                if (movers is not null)
                {
                    page = movers.Page;
                    requestedPage = movers.Page;
                }
            }
            else if (selectedView == "results")
            {
                var resultsUri = BuildResultsApiUri();
                if (results is null || !string.Equals(resultsUri, lastResultsApiUri, StringComparison.Ordinal))
                {
                    results = await Http.GetFromJsonAsync<EloResultsResponse>(resultsUri);
                    lastResultsApiUri = resultsUri;
                }

                if (results is not null)
                {
                    page = results.Page;
                    requestedPage = results.Page;
                }
            }
            else
            {
                // Chart data is intentionally deferred until the user opens the chart.
                // The ranking response must remain the first meaningful data surface.
            }

            StoreRankingsCacheEntry(cacheKey);
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load rankings: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private RankingsClientCacheKey BuildRankingsClientCacheKey(string rankingsUri)
        => new(
            selectedPool,
            selectedView,
            rankingsUri,
            selectedView == "movers" ? selectedMoverDirection : string.Empty,
            selectedView == "movers" ? selectedWindowDays : 0);

    private void CaptureActiveRankingsCacheEntry()
    {
        if (activeRankingsCacheKey is null ||
            !rankingsClientCache.TryGetValue(activeRankingsCacheKey, out var entry))
        {
            return;
        }

        entry.Rankings = response;
        entry.Movers = movers;
        entry.Results = results;
        entry.Evolution = evolution;
        entry.FullEvolution = fullEvolution;
        entry.EvolutionRankings = evolutionRankings;
        entry.EvolutionChartSeries = evolutionChartSeries.ToList();
        entry.EvolutionVisibleRatedPointCounts = new(evolutionVisibleRatedPointCounts);
        entry.RankingsApiUri = lastRankingsApiUri;
        entry.MoversApiUri = lastMoversApiUri;
        entry.ResultsApiUri = lastResultsApiUri;
        entry.EvolutionRankingsApiUri = lastEvolutionRankingsApiUri;
        entry.EvolutionApiUri = lastEvolutionApiUri;
        entry.EvolutionDataRevision = evolutionDataRevision;
    }

    private void StoreRankingsCacheEntry(RankingsClientCacheKey cacheKey)
    {
        var entry = rankingsClientCache.TryGetValue(cacheKey, out var existing)
            ? existing
            : new RankingsClientCacheEntry();

        entry.Rankings = response;
        entry.Movers = movers;
        entry.Results = results;
        entry.Evolution = evolution;
        entry.FullEvolution = fullEvolution;
        entry.EvolutionRankings = evolutionRankings;
        entry.EvolutionChartSeries = evolutionChartSeries.ToList();
        entry.EvolutionVisibleRatedPointCounts = new(evolutionVisibleRatedPointCounts);
        entry.RankingsApiUri = lastRankingsApiUri;
        entry.MoversApiUri = lastMoversApiUri;
        entry.ResultsApiUri = lastResultsApiUri;
        entry.EvolutionRankingsApiUri = lastEvolutionRankingsApiUri;
        entry.EvolutionApiUri = lastEvolutionApiUri;
        entry.EvolutionDataRevision = evolutionDataRevision;

        rankingsClientCache[cacheKey] = entry;
        activeRankingsCacheKey = cacheKey;
    }

    private void RestoreRankingsCacheEntry(
        RankingsClientCacheKey cacheKey,
        RankingsClientCacheEntry entry)
    {
        response = entry.Rankings;
        movers = entry.Movers;
        results = entry.Results;
        evolution = entry.Evolution;
        fullEvolution = entry.FullEvolution;
        evolutionRankings = entry.EvolutionRankings;
        evolutionChartSeries = entry.EvolutionChartSeries.ToList();
        evolutionVisibleRatedPointCounts.Clear();
        foreach (var item in entry.EvolutionVisibleRatedPointCounts)
        {
            evolutionVisibleRatedPointCounts[item.Key] = item.Value;
        }

        lastRankingsApiUri = entry.RankingsApiUri;
        lastMoversApiUri = entry.MoversApiUri;
        lastResultsApiUri = entry.ResultsApiUri;
        lastEvolutionRankingsApiUri = entry.EvolutionRankingsApiUri;
        lastEvolutionApiUri = entry.EvolutionApiUri;
        evolutionDataRevision = entry.EvolutionDataRevision;
        activeRankingsCacheKey = cacheKey;

        if (response is not null)
        {
            page = response.Page;
            requestedPage = response.Page;
        }
        else if (movers is not null)
        {
            page = movers.Page;
            requestedPage = movers.Page;
        }
        else if (results is not null)
        {
            page = results.Page;
            requestedPage = results.Page;
        }
    }

