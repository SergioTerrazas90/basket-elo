@page "/admin/current-results-review"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@using BasketElo.Domain.CurrentResults
@using BasketElo.Domain.Competitions
@using BasketElo.Domain.Entities
@inject HttpClient Http

<PageTitle>Current Results Review</PageTitle>

<div class="admin-page">
    <section class="page-header">
        <div>
            <p class="eyebrow">Operations</p>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1>Current-results review</h1>
                @if (openReviewCount.HasValue)
                {
                    <span class="badge rounded-pill text-bg-warning" title="Open reviews remaining">
                        @openReviewCount.Value @(openReviewCount.Value == 1 ? "review left" : "reviews left")
                    </span>
                }
            </div>
            <p class="intro">Assign Livescore results that could not be matched safely, or ignore them without creating duplicate games.</p>
        </div>
        <div class="header-actions">
            <NavLink class="btn btn-outline-secondary" href="admin">Admin dashboard</NavLink>
            <button type="button" class="btn btn-primary" @onclick="LoadAsync" disabled="@isBusy">Refresh</button>
        </div>
    </section>

    @if (unmatchedCompetitions is { Count: > 0 })
    {
        <section class="card border-warning mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <p class="eyebrow text-warning-emphasis">New unmatched competition</p>
                        <h2 class="h4 mb-1">Decide how these competitions should be handled</h2>
                        <p class="text-muted mb-0">Merge into an existing competition or create a new one. For FIBA and Olympic sources, you can also assign or create the target tournament cycle.</p>
                    </div>
                    <NavLink class="btn btn-outline-secondary" href="admin/competitions">Manage competitions</NavLink>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var unmatched in unmatchedCompetitions)
                    {
                        var key = UnmatchedKey(unmatched);
                        var selection = GetUnmatchedSelection(key, unmatched);
                        <div class="border rounded p-3">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <strong>@unmatched.CompetitionName</strong>
                                    <div class="small text-muted">@unmatched.CountryName · @unmatched.Source@(string.IsNullOrWhiteSpace(unmatched.SourceCompetitionId) ? string.Empty : $" · ID {unmatched.SourceCompetitionId}") · @unmatched.ReviewCount review(s)</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => IgnoreUnmatchedAsync(unmatched)" disabled="@isBusy">Don't handle</button>
                            </div>
                            <div class="row g-3 mt-2">
                                <div class="col-lg-5">
                                    <label class="form-label" for="competition-mode-@key">Competition action</label>
                                    <select id="competition-mode-@key" class="form-select" @bind="selection.CompetitionMode">
                                        <option value="existing">Merge into existing competition</option>
                                        <option value="create">Create new competition</option>
                                    </select>
                                </div>
                                @if (selection.CompetitionMode == "existing")
                                {
                                    <div class="col-lg-7">
                                        <label class="form-label" for="merge-@key">Existing competition</label>
                                        <select id="merge-@key" class="form-select" @bind="selection.ExistingCompetitionId">
                                            <option value="">Choose a supported competition...</option>
                                            @foreach (var option in competitionOptions ?? [])
                                            {
                                                if (option.SupportPolicy == CompetitionSupportPolicies.Supported)
                                                {
                                                    <option value="@option.Id">@option.Name@(string.IsNullOrWhiteSpace(option.CountryCode) ? string.Empty : $" ({option.CountryCode})")</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-lg-7">
                                        <label class="form-label" for="new-name-@key">New competition name</label>
                                        <input id="new-name-@key" class="form-control" @bind="selection.NewCompetitionName" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="new-type-@key">Type</label>
                                        <input id="new-type-@key" class="form-control" @bind="selection.NewCompetitionType" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="new-pool-@key">ELO pool</label>
                                        <input id="new-pool-@key" class="form-control" @bind="selection.NewCompetitionEloPoolKey" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="new-country-@key">Country code (optional)</label>
                                        <input id="new-country-@key" class="form-control" @bind="selection.NewCompetitionCountryCode" />
                                    </div>
                                }
                                <div class="col-lg-7">
                                    <label class="form-label" for="cycle-@key">Tournament cycle</label>
                                    <select id="cycle-@key" class="form-select" @bind="selection.CycleSelection">
                                        <option value="">Do not assign a cycle</option>
                                        @foreach (var cycle in tournamentCycleOptions ?? [])
                                        {
                                            <option value="@cycle.Id">@cycle.DisplayName (@cycle.Key)</option>
                                        }
                                        <option value="create">Create a FIBA/Olympic cycle</option>
                                    </select>
                                </div>
                                @if (selection.CycleSelection == "create")
                                {
                                    <div class="col-md-5">
                                        <label class="form-label" for="cycle-family-@key">Cycle family</label>
                                        <select id="cycle-family-@key" class="form-select" @bind="selection.NewCycleFamily">
                                            <option value="">Choose a family...</option>
                                            @foreach (var family in tournamentCycleFamilies ?? [])
                                            {
                                                <option value="@family">@family</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label" for="cycle-edition-@key">Edition</label>
                                        <input id="cycle-edition-@key" class="form-control" placeholder="2031" @bind="selection.NewCycleEdition" />
                                    </div>
                                }
                                <div class="col-12">
                                    <button type="button" class="btn btn-primary" @onclick="() => MergeUnmatchedAsync(unmatched)" disabled="@isBusy">Apply competition and cycle</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="card mb-4">
        <div class="card-body d-flex flex-wrap align-items-end gap-3">
            <div>
                <label class="form-label" for="current-results-status">Status</label>
                <select id="current-results-status" class="form-select" @bind="statusFilter">
                    <option value="open">Needs review</option>
                    <option value="resolved">Resolved</option>
                    <option value="ignored">Ignored</option>
                    <option value="all">All</option>
                </select>
            </div>
            <span class="text-muted small">Open reviews are held outside the games table until assigned.</span>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageCss" role="alert">@message</div>
    }

    @if (reviews is null)
    {
        <p><em>Loading current-results reviews...</em></p>
    }
    else if (reviews.Count == 0)
    {
        <div class="alert alert-success">No current-results reviews match this filter.</div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var review in reviews)
            {
                var isOpen = review.Status == CurrentResultReviewStatuses.Open;
                var isExpanded = expandedReviewId == review.Id;
                var cyclePending = review.Reason == CurrentResultReviewReasons.TournamentCycleConfirmationRequired;
                <article class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="text-muted small">@review.SourceDate.ToString("yyyy-MM-dd") · @review.CompetitionName · @review.Reason</div>
                                <h2 class="h5 mb-1">@review.HomeTeamName <span class="text-muted">vs</span> @review.AwayTeamName</h2>
                                <div class="small">@review.ResultStatus · @FormatScore(review) · @review.GameDateTimeUtc.ToLocalTime().ToString("g")</div>
                                @if (!string.IsNullOrWhiteSpace(review.SourceUrl))
                                {
                                    <a class="small" href="@review.SourceUrl" target="_blank" rel="noreferrer">Open Livescore source</a>
                                }
                            </div>
                            <span class="badge @(isOpen ? "text-bg-warning" : review.Status == CurrentResultReviewStatuses.Resolved ? "text-bg-success" : "text-bg-secondary")">@review.Status</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(review.ResolutionNote))
                        {
                            <p class="text-muted small mt-2 mb-0">Note: @review.ResolutionNote</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(review.TournamentCycleKey))
                        {
                            <p class="small mt-2 mb-0">Tournament cycle: <strong>@review.TournamentCycleKey</strong></p>
                        }

                        @if (isOpen)
                        {
                            @if (cyclePending)
                            {
                                <div class="alert alert-warning mt-3 mb-2">Tournament cycle confirmation is required before this game can become Elo-eligible. Confirm it through the official tournament ingestion, then refresh this queue.</div>
                            }
                            <div class="d-flex gap-2 mt-3">
                                @if (!cyclePending)
                                {
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => ToggleMatchesAsync(review.Id)" disabled="@isBusy">
                                        @(isExpanded ? "Hide planned matches" : "Choose planned match")
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => IgnoreAsync(review.Id)" disabled="@isBusy">Ignore</button>
                            </div>
                        }

                        @if (isExpanded)
                        {
                            <div class="mt-3 border-top pt-3">
                                @if (!matchesByReview.TryGetValue(review.Id, out var matches))
                                {
                                    <p class="text-muted mb-0">Loading planned matches...</p>
                                }
                                else if (matches.Count == 0)
                                {
                                    <p class="text-muted mb-0">No scheduled games were found within 36 hours. Leave this review open until the planned source is available, or ignore it.</p>
                                }
                                else
                                {
                                    <p class="small text-muted">Select the canonical planned fixture. The Livescore score/status will be applied while the planned source identity is preserved.</p>
                                    <div class="list-group">
                                        @foreach (var match in matches)
                                        {
                                            var selected = selectedGameByReview.TryGetValue(review.Id, out var selectedGame) && selectedGame == match.GameId;
                                            <button type="button" class="list-group-item list-group-item-action @(selected ? "active" : string.Empty)" @onclick="() => SelectMatch(review.Id, match.GameId)">
                                                <div class="d-flex justify-content-between gap-3">
                                                    <strong>@match.HomeTeamName <span class="fw-normal">vs</span> @match.AwayTeamName</strong>
                                                    <span>@match.GameDateTimeUtc.ToLocalTime().ToString("g")</span>
                                                </div>
                                                <div class="small">@match.CompetitionName · @match.Season · @(match.TournamentCycleKey ?? "no tournament cycle") · @match.Source:@match.SourceGameId</div>
                                            </button>
                                        }
                                    </div>
                                    <div class="d-flex gap-2 mt-3">
                                        <button type="button" class="btn btn-success" @onclick="() => AssignAsync(review.Id)" disabled="@(!selectedGameByReview.ContainsKey(review.Id) || isBusy)">Assign selected match</button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => Collapse(review.Id)">Cancel</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<CurrentResultReviewDto>? reviews;
    private IReadOnlyList<CurrentResultsUnmatchedCompetitionDto>? unmatchedCompetitions;
    private IReadOnlyList<CompetitionAdminOption>? competitionOptions;
    private IReadOnlyList<CurrentResultsTournamentCycleOption>? tournamentCycleOptions;
    private IReadOnlyList<string>? tournamentCycleFamilies;
    private int? openReviewCount;
    private readonly Dictionary<Guid, IReadOnlyList<CurrentResultReviewMatchDto>> matchesByReview = [];
    private readonly Dictionary<Guid, Guid> selectedGameByReview = [];
    private readonly Dictionary<string, UnmatchedSelection> unmatchedSelections = [];
    private Guid? expandedReviewId;
    private string statusFilter = CurrentResultReviewStatuses.Open;
    private string? message;
    private string messageCss = "alert-info";
    private bool isBusy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isBusy = true;
        message = null;
        try
        {
            var query = statusFilter == "all" ? "" : $"?status={Uri.EscapeDataString(statusFilter)}";
            reviews = await Http.GetFromJsonAsync<IReadOnlyList<CurrentResultReviewDto>>($"api/current-results/reviews{query}") ?? [];
            try
            {
                openReviewCount = await Http.GetFromJsonAsync<int>("api/current-results/reviews/count");
            }
            catch
            {
                openReviewCount = null;
            }
            unmatchedCompetitions = await Http.GetFromJsonAsync<IReadOnlyList<CurrentResultsUnmatchedCompetitionDto>>("api/current-results/reviews/unmatched-competitions") ?? [];
            competitionOptions = await Http.GetFromJsonAsync<IReadOnlyList<CompetitionAdminOption>>("api/admin/competitions/options") ?? [];
            var cycleResponse = await Http.GetFromJsonAsync<CurrentResultsTournamentCycleOptionsResponse>("api/current-results/tournament-cycles");
            tournamentCycleOptions = cycleResponse?.Cycles ?? [];
            tournamentCycleFamilies = cycleResponse?.Families ?? [];
            unmatchedSelections.Clear();
            matchesByReview.Clear();
            selectedGameByReview.Clear();
            expandedReviewId = null;
        }
        catch (Exception exception)
        {
            SetMessage($"Could not load current-results reviews: {exception.Message}", "alert-danger");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ToggleMatchesAsync(Guid reviewId)
    {
        if (expandedReviewId == reviewId)
        {
            expandedReviewId = null;
            return;
        }

        expandedReviewId = reviewId;
        if (matchesByReview.ContainsKey(reviewId)) return;

        try
        {
            matchesByReview[reviewId] = await Http.GetFromJsonAsync<IReadOnlyList<CurrentResultReviewMatchDto>>($"api/current-results/reviews/{reviewId}/matches") ?? [];
        }
        catch (Exception exception)
        {
            SetMessage($"Could not load planned matches: {exception.Message}", "alert-danger");
        }
    }

    private void SelectMatch(Guid reviewId, Guid gameId) => selectedGameByReview[reviewId] = gameId;

    private void Collapse(Guid reviewId)
    {
        if (expandedReviewId == reviewId) expandedReviewId = null;
    }

    private async Task AssignAsync(Guid reviewId)
    {
        if (!selectedGameByReview.TryGetValue(reviewId, out var gameId)) return;
        await ResolveAsync(reviewId, new CurrentResultReviewResolutionRequest("assign", gameId, "Assigned from Current Results Review."));
    }

    private async Task IgnoreAsync(Guid reviewId) =>
        await ResolveAsync(reviewId, new CurrentResultReviewResolutionRequest("ignore", null, "Ignored from Current Results Review."));

    private async Task MergeUnmatchedAsync(CurrentResultsUnmatchedCompetitionDto unmatched)
    {
        var key = UnmatchedKey(unmatched);
        var selection = GetUnmatchedSelection(key, unmatched);
        Guid? targetId = null;
        if (selection.CompetitionMode == "existing")
        {
            if (!Guid.TryParse(selection.ExistingCompetitionId, out var parsedTargetId))
            {
                SetMessage("Choose a supported competition before merging.", "alert-warning");
                return;
            }

            targetId = parsedTargetId;
        }

        CreateCompetitionFromMergeRequest? newCompetition = null;
        if (selection.CompetitionMode == "create")
        {
            newCompetition = new CreateCompetitionFromMergeRequest(
                selection.NewCompetitionName ?? string.Empty,
                selection.NewCompetitionType ?? string.Empty,
                selection.NewCompetitionCountryCode,
                selection.NewCompetitionEloPoolKey,
                1,
                CompetitionSupportPolicies.Supported);
        }

        Guid? tournamentCycleId = null;
        string? tournamentCycleFamily = null;
        string? tournamentCycleEdition = null;
        if (selection.CycleSelection == "create")
        {
            tournamentCycleFamily = selection.NewCycleFamily ?? string.Empty;
            tournamentCycleEdition = selection.NewCycleEdition ?? string.Empty;
        }
        else if (Guid.TryParse(selection.CycleSelection, out var parsedCycleId))
        {
            tournamentCycleId = parsedCycleId;
        }

        await PostUnmatchedDecisionAsync(
            "api/current-results/reviews/unmatched-competitions/merge",
            new MergeUnmatchedCompetitionRequest(
                unmatched.Source,
                unmatched.SourceCompetitionId,
                unmatched.CountryName,
                unmatched.CompetitionName,
                targetId,
                newCompetition,
                tournamentCycleId,
                tournamentCycleFamily,
                tournamentCycleEdition),
            "Competition and cycle assignment saved. Any single safe planned match was assigned automatically; rerun current-results or choose a planned match for candidates that remain open.");
    }

    private async Task IgnoreUnmatchedAsync(CurrentResultsUnmatchedCompetitionDto unmatched) =>
        await PostUnmatchedDecisionAsync(
            "api/current-results/reviews/unmatched-competitions/ignore",
            new IgnoreUnmatchedCompetitionRequest(unmatched.Source, unmatched.SourceCompetitionId, unmatched.CountryName, unmatched.CompetitionName),
            "Competition marked unsupported and its current-results reviews were ignored.");

    private async Task PostUnmatchedDecisionAsync(string endpoint, object request, string successMessage)
    {
        isBusy = true;
        try
        {
            var response = await Http.PostAsJsonAsync(endpoint, request);
            if (!response.IsSuccessStatusCode)
            {
                SetMessage(await response.Content.ReadAsStringAsync(), "alert-danger");
                return;
            }

            SetMessage(successMessage, "alert-success");
            await LoadAsync();
        }
        catch (Exception exception)
        {
            SetMessage($"Could not update unmatched competition: {exception.Message}", "alert-danger");
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string UnmatchedKey(CurrentResultsUnmatchedCompetitionDto unmatched) =>
        string.Join("|", unmatched.Source, unmatched.SourceCompetitionId ?? string.Empty, unmatched.CountryName, unmatched.CompetitionName);

    private UnmatchedSelection GetUnmatchedSelection(string key, CurrentResultsUnmatchedCompetitionDto unmatched)
    {
        if (unmatchedSelections.TryGetValue(key, out var existing))
        {
            return existing;
        }

        var selection = new UnmatchedSelection
        {
            NewCompetitionName = unmatched.CompetitionName,
            NewCycleFamily = SuggestedCycleFamily(unmatched.CompetitionName) ?? string.Empty
        };
        unmatchedSelections[key] = selection;
        return selection;
    }

    private async Task ResolveAsync(Guid reviewId, CurrentResultReviewResolutionRequest request)
    {
        isBusy = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/current-results/reviews/{reviewId}/resolve", request);
            if (!response.IsSuccessStatusCode)
            {
                SetMessage(await response.Content.ReadAsStringAsync(), "alert-danger");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<CurrentResultReviewResolutionDto>();
            SetMessage(result?.Message ?? "Review updated.", "alert-success");
            await LoadAsync();
        }
        catch (Exception exception)
        {
            SetMessage($"Could not update review: {exception.Message}", "alert-danger");
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string FormatScore(CurrentResultReviewDto review) =>
        review.HomeScore.HasValue && review.AwayScore.HasValue ? $"{review.HomeScore}-{review.AwayScore}" : "score pending";

    private void SetMessage(string value, string css)
    {
        message = value;
        messageCss = css;
    }

    private static string? SuggestedCycleFamily(string competitionName)
    {
        var normalized = competitionName.Trim().ToLowerInvariant();
        if (normalized.Contains("world cup") || (normalized.Contains("wc") && normalized.Contains("qualif"))) return "FIBA Basketball World Cup";
        if (normalized.Contains("afrobasket")) return "AfroBasket";
        if (normalized.Contains("eurobasket")) return "EuroBasket";
        if (normalized.Contains("asia cup")) return "FIBA Asia Cup";
        if (normalized.Contains("americup")) return "FIBA AmeriCup";
        if (normalized.Contains("olympic")) return "Olympics";
        return null;
    }

    private sealed class UnmatchedSelection
    {
        public string CompetitionMode { get; set; } = "existing";
        public string ExistingCompetitionId { get; set; } = string.Empty;
        public string? NewCompetitionName { get; set; }
        public string? NewCompetitionType { get; set; } = "qualifier";
        public string NewCompetitionCountryCode { get; set; } = string.Empty;
        public string NewCompetitionEloPoolKey { get; set; } = "national-teams";
        public string CycleSelection { get; set; } = string.Empty;
        public string NewCycleFamily { get; set; } = string.Empty;
        public string NewCycleEdition { get; set; } = string.Empty;
    }
}
