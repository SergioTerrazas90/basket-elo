@page "/upcoming"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@using BasketElo.Domain.CurrentResults
@using BasketElo.Domain.Games
@inject HttpClient Http

<PageTitle>Upcoming schedule</PageTitle>

<div class="games-page">
    <section class="page-header">
        <div>
            <p class="eyebrow">Game data</p>
            <h1>Upcoming schedule</h1>
            <p class="intro">Review the next seven days of matchups, with current ELO ratings when both teams are covered. Start times are shown in UTC.</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="RefreshAsync" disabled="@isBusy">Refresh</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (isBusy && response is null)
    {
        <p>Loading upcoming games...</p>
    }
    else if (response is not null)
    {
        <section class="summary-panel">
            <div class="summary-card"><span class="summary-label">Scheduled games</span><strong>@response.TotalCount</strong></div>
            <div class="summary-card"><span class="summary-label">Needs review</span><strong>@pendingReviews.Count</strong></div>
            <div class="summary-card"><span class="summary-label">Showing</span><strong>@FilteredRows.Count()</strong></div>
            <div class="summary-card"><span class="summary-label">Window</span><strong>@FormatUtcDay(response.FromUtc) – @FormatUtcDay(response.ToUtc)</strong></div>
        </section>
        <section class="table-section">
            <div class="section-head">
                <div>
                    <h2 class="h4 mb-1">Upcoming games and fixtures to review</h2>
                    <p class="text-muted mb-0">Scheduled games and unresolved Livescore fixtures are shown together. Use the status filter to focus the list. Review unresolved fixtures in <a href="admin/current-results-review">Results matching</a>.</p>
                </div>
                <div class="filter-field">
                    <label class="form-label" for="upcoming-status-filter">Status</label>
                    <select id="upcoming-status-filter" class="form-select" @bind="statusFilter">
                        <option value="all">All statuses</option>
                        <option value="needs-review">Needs review</option>
                        @foreach (var status in GameStatuses)
                        {
                            <option value="@status">@FormatStatus(status)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle games-table">
                    <thead><tr><th>Date</th><th>Competition</th><th>Matchup</th><th>Team ELOs</th><th>Gap</th><th>Status</th></tr></thead>
                    <tbody>
                    @if (!FilteredRows.Any())
                    {
                        <tr><td colspan="6" class="empty-state">No upcoming fixtures match this status filter.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in FilteredRows)
                        {
                            <tr>
                                <td>@FormatUtcDate(row.GameDateTimeUtc)</td>
                                <td><strong>@row.Competition</strong><br /><small>@row.Country</small></td>
                                <td>@row.HomeTeam <span class="vs">vs</span> @row.AwayTeam</td>
                                <td>@FormatElo(row.HomeElo) – @FormatElo(row.AwayElo)</td>
                                <td>@FormatElo(row.EloDifference)</td>
                                <td>
                                    @if (row.IsReview)
                                    {
                                        <a class="status-pill status-warning" href="admin/current-results-review">Needs review</a>
                                    }
                                    else
                                    {
                                        <span class="status-pill">@FormatStatus(row.Status)</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private UpcomingGamesResponse? response;
    private IReadOnlyList<CurrentResultReviewDto> pendingReviews = [];
    private string statusFilter = "all";
    private bool isBusy;
    private string? errorMessage;

    private IEnumerable<string> GameStatuses => response?.Games
        .Select(x => x.Status)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        ?? Enumerable.Empty<string>();

    private IEnumerable<ScheduleRow> FilteredRows => ScheduleRows
        .Where(x => statusFilter == "all" || string.Equals(x.Status, statusFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ScheduleRow> ScheduleRows => (response?.Games
        .Select(game => new ScheduleRow(
            game.GameDateTimeUtc, game.Country, game.Competition, game.HomeTeam, game.AwayTeam,
            game.HomeElo, game.AwayElo, game.EloDifference, game.Status, false))
        ?? [])
        .Concat(pendingReviews.Select(review => new ScheduleRow(
            review.GameDateTimeUtc, review.CountryName, review.CompetitionName, review.HomeTeamName, review.AwayTeamName,
            null, null, null, "needs-review", true)))
        .OrderBy(x => x.GameDateTimeUtc)
        .ThenBy(x => x.Competition);

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        isBusy = true;
        errorMessage = null;
        pendingReviews = [];
        try
        {
            response = await Http.GetFromJsonAsync<UpcomingGamesResponse>("api/games/upcoming");
            if (response is not null)
            {
                try
                {
                    var reviews = await Http.GetFromJsonAsync<IReadOnlyList<CurrentResultReviewDto>>("api/current-results/reviews?status=open&limit=500") ?? [];
                    pendingReviews = reviews
                        .Where(x => x.GameDateTimeUtc >= response.FromUtc && x.GameDateTimeUtc <= response.ToUtc)
                        .OrderBy(x => x.GameDateTimeUtc)
                        .ThenBy(x => x.CompetitionName)
                        .ToList();
                }
                catch
                {
                    pendingReviews = [];
                }
            }
        }
        catch (Exception exception)
        {
            errorMessage = $"Could not load upcoming games: {exception.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string FormatElo(decimal? value) => value.HasValue ? value.Value.ToString("0") : "—";

    private static string FormatStatus(string status)
        => status.Replace('_', ' ');

    private static string FormatUtcDay(DateTime value)
        => DateTime.SpecifyKind(value, DateTimeKind.Utc).ToString("MMM d 'UTC'");

    private static string FormatUtcDate(DateTime value)
        => DateTime.SpecifyKind(value, DateTimeKind.Utc).ToString("ddd, MMM d · HH:mm 'UTC'");

    private sealed record ScheduleRow(
        DateTime GameDateTimeUtc,
        string Country,
        string Competition,
        string HomeTeam,
        string AwayTeam,
        decimal? HomeElo,
        decimal? AwayElo,
        decimal? EloDifference,
        string Status,
        bool IsReview);
}
