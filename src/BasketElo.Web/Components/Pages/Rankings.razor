    private static IReadOnlyList<FixtureHighlight> BuildFixtureHighlights(IReadOnlyCollection<UpcomingGameListItem>? source = null)
    {
        var games = source?.ToList() ?? [];
        if (games.Count == 0)
        {
            return [];
        }

        var usedGameIds = new HashSet<Guid>();
        var ratedGames = games.Where(game => game.HasBothRatings).ToList();
        var comparableGames = ratedGames.Count > 0 ? ratedGames : games;
        var highlights = new List<FixtureHighlight>(2);

        AddHighlight(
            highlights,
            usedGameIds,
            "Most even",
            "The fixture closest to a 50–50 expected result.",
            comparableGames
                .OrderBy(ProbabilityDistanceFromEven)
                .ThenByDescending(CombinedElo)
                .ThenBy(game => game.GameDateTimeUtc));

        AddHighlight(
            highlights,
            usedGameIds,
            "Strongest matchup",
            "The fixture with the highest combined ELO.",
            comparableGames
                .OrderByDescending(CombinedElo)
                .ThenBy(game => game.EloDifference)
                .ThenBy(game => game.GameDateTimeUtc));

        return highlights;
    }

    private static void AddHighlight(
        ICollection<FixtureHighlight> highlights,
        ISet<Guid> usedGameIds,
        string title,
        string description,
        IEnumerable<UpcomingGameListItem> orderedGames)
    {
        var ordered = orderedGames.ToList();
        var selected = ordered
            .Where(game => usedGameIds.Add(game.Id))
            .Take(2)
            .ToList();

        if (selected.Count < 2)
        {
            selected.AddRange(ordered
                .Where(game => selected.All(selectedGame => selectedGame.Id != game.Id))
                .Take(2 - selected.Count));
        }

        if (selected.Count > 0)
        {
            highlights.Add(new FixtureHighlight(title, description, selected));
        }
    }

    private static decimal CombinedElo(UpcomingGameListItem game)
        => game.HasBothRatings && game.HomeElo.HasValue && game.AwayElo.HasValue
            ? game.HomeElo.Value + game.AwayElo.Value
            : decimal.MinValue;

    private static decimal ProbabilityDistanceFromEven(UpcomingGameListItem game)
        => game.HomeWinProbability.HasValue
            ? Math.Abs(game.HomeWinProbability.Value - 0.5m)
            : decimal.MaxValue;

