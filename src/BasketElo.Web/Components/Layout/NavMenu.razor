@using System.Globalization
@using BasketElo.Web.Localization

<div class="site-navigation">
    <a class="brand-lockup" href="@RankingsHomeHref" aria-label='@T["BasketEloHome"]'>
        <span class="brand-mark" aria-hidden="true"><img src="brand-mark.svg" alt="" /></span>
        <span class="brand-copy">
            <strong>BasketElo</strong>
            <small>@T["BasketballIntelligence"]</small>
        </span>
    </a>

    <input id="navigation-toggle"
           type="checkbox"
           title='@T["ToggleNavigationMenu"]'
           aria-label='@T["ToggleNavigationMenu"]'
           class="navbar-toggler"
           aria-controls="primary-navigation" />

    <div id="primary-navigation"
         class="nav-drawer"
        onclick="if (event.target.closest('a:not([data-enhance-nav=false])')) document.querySelector('#navigation-toggle').click()">
        <nav class="nav-primary" aria-label='@T["PrimaryNavigation"]'>
            <NavLink class="nav-link" href="@RankingsHomeHref" Match="NavLinkMatch.All">@T["Rankings"]</NavLink>
            <NavLink class="nav-link" href="@MoversHref">@T["Movers"]</NavLink>
            <NavLink class="nav-link" href="model-lab">@T["ModelLab"]</NavLink>
        </nav>

        <div class="nav-utilities">
            <nav class="nav-information" aria-label='@T["ProjectInformation"]'>
                <NavLink class="nav-information-link" href="how-it-works">@T["Method"]</NavLink>
                <NavLink class="nav-information-link" href="data-sources">@T["Sources"]</NavLink>
                <NavLink class="nav-information-link" href="about">@T["About"]</NavLink>
                <NavLink class="nav-information-link" href="sponsor">@T["Sponsor"]</NavLink>
            </nav>

            <AuthorizeView Roles="admin">
                <Authorized>
                    <details class="nav-disclosure nav-disclosure-admin">
                        <summary>@T["Operations"] <span class="nav-chevron" aria-hidden="true"></span></summary>
                        <nav class="nav-popover nav-admin-popover" aria-label='@T["OperationsNavigation"]'>
                            <p class="nav-admin-group-label">@T["MonitorAndRun"]</p>
                            <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">
                                <span>@T["OperationsOverview"]</span>
                                <small>@T["OperationsOverviewDescription"]</small>
                            </NavLink>
                            <NavLink class="nav-link" href="admin/jobs" target="_blank" rel="noopener">
                                <span>@T["EloJobMonitor"] <span aria-hidden="true">↗</span></span>
                                <small>@T["EloJobMonitorDescription"]</small>
                            </NavLink>

                            <p class="nav-admin-group-label">@T["GameData"]</p>
                            <NavLink class="nav-link" href="games">
                                <span>@T["GameRecords"]</span>
                                <small>@T["GameRecordsDescription"]</small>
                            </NavLink>
                            <NavLink class="nav-link" href="upcoming">
                                <span>@T["UpcomingSchedule"]</span>
                                <small>@T["UpcomingScheduleDescription"]</small>
                            </NavLink>
                            <NavLink class="nav-link" href="admin/manual-game">
                                <span>Manual match entry</span>
                                <small>Create missing fixtures and results</small>
                            </NavLink>
                            <NavLink class="nav-link" href="backfill">
                                <span>@T["HistoricalImports"]</span>
                                <small>@T["HistoricalImportsDescription"]</small>
                            </NavLink>

                            <p class="nav-admin-group-label">@T["ReviewAndResolve"]</p>
                            <NavLink class="nav-link" href="admin/current-results-review">
                                <span>@T["ResultsMatching"]</span>
                                <small>@T["ResultsMatchingDescription"]</small>
                            </NavLink>
                            <NavLink class="nav-link" href="admin/identity">
                                <span>@T["IdentityChecks"]</span>
                                <small>@T["IdentityChecksDescription"]</small>
                            </NavLink>
                            <NavLink class="nav-link" href="admin/identity-review">
                                <span>@T["IdentityDecisions"]</span>
                                <small>@T["IdentityDecisionsDescription"]</small>
                            </NavLink>

                            <p class="nav-admin-group-label">@T["Catalogs"]</p>
                            <NavLink class="nav-link" href="admin/competitions">
                                <span>@T["CompetitionCatalog"]</span>
                                <small>@T["CompetitionCatalogDescription"]</small>
                            </NavLink>
                            <NavLink class="nav-link" href="admin/teams">
                                <span>@T["TeamCatalog"]</span>
                                <small>@T["TeamCatalogDescription"]</small>
                            </NavLink>

                            <p class="nav-admin-group-label">@T["Publishing"]</p>
                            <NavLink class="nav-link" href="admin/social-posts">
                                <span>@T["SocialPostStudio"]</span>
                                <small>@T["SocialPostStudioDescription"]</small>
                            </NavLink>
                        </nav>
                    </details>
                </Authorized>
            </AuthorizeView>

            <div class="nav-account">
                <LanguageSelector />
                <AuthStatus />
            </div>
        </div>
    </div>
</div>

@code {
    private bool IsSpanish => CultureInfo.CurrentUICulture.Name.StartsWith("es", StringComparison.OrdinalIgnoreCase);

    private string RankingsHomeHref => IsSpanish ? "/es" : "/";

    private string MoversHref => IsSpanish ? "/es/movers" : "/movers";
}

