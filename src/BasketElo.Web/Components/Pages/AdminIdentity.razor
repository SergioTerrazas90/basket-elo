@page "/admin/identity"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@inject HttpClient Http


<PageTitle>Identity Health</PageTitle>

<div class="d-flex justify-content-between align-items-start gap-3">
    <h1>Identity Health</h1>
    <NavLink class="btn btn-outline-primary" href="admin/identity-review">Open Identity Review</NavLink>
</div>

<div class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-sm-2">
            <label class="form-label" for="identity-source">Source</label>
            <select id="identity-source" class="form-select" @bind="checkRequest.Source">
                <option value="">All sources</option>
                @foreach (var source in options?.Sources ?? [])
                {
                    <option value="@source">@source</option>
                }
            </select>
        </div>
        <div class="col-sm-2">
            <label class="form-label" for="identity-season">Season filter</label>
            <select id="identity-season" class="form-select" @bind="checkRequest.Season">
                <option value="">All seasons</option>
                @foreach (var season in options?.Seasons ?? [])
                {
                    <option value="@season">@season</option>
                }
            </select>
        </div>
        <div class="col-sm-2">
            <label class="form-label" for="identity-country">Country</label>
            <select id="identity-country" class="form-select" @bind="checkRequest.CountryCode">
                <option value="">All countries</option>
                @foreach (var country in options?.Countries ?? [])
                {
                    <option value="@country.Code">@CountryLabel(country)</option>
                }
            </select>
        </div>
        <div class="col-sm-3">
            <label class="form-label" for="identity-competition">Competition</label>
            <select id="identity-competition" class="form-select" @bind="competitionIdText">
                <option value="">All competitions</option>
                @foreach (var competition in FilteredCompetitionOptions)
                {
                    <option value="@competition.Id">@CompetitionLabel(competition)</option>
                }
            </select>
        </div>
        <div class="col-sm-1 form-check mb-2">
            <input id="identity-force" class="form-check-input" type="checkbox" @bind="checkRequest.Force" />
            <label class="form-check-label" for="identity-force">Force</label>
        </div>
        <div class="col-sm-2">
            <button class="btn btn-primary w-100" @onclick="RunCheckAsync" disabled="@isBusy">Run Check</button>
        </div>
        <div class="col-sm-2">
            <button class="btn btn-outline-secondary w-100" @onclick="ApplyRunFiltersAsync" disabled="@isBusy">Apply filters</button>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageCss">@message</div>
}

<h2>Latest Runs</h2>

@if (runs is null)
{
    <p><em>Loading...</em></p>
}
else if (runs.Count == 0)
{
    <p>No identity health checks have run yet.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Checked</th>
                <th>Scope</th>
                <th>Pending</th>
                <th>Resolved</th>
                <th>Ignored</th>
                <th>Types</th>
                <th>Invalidated</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var run in runs)
            {
                <tr class="@(run.Id == selectedRunId ? "table-primary" : string.Empty)">
                    <td>@run.CheckedAtUtc.ToLocalTime().ToString("g")</td>
                    <td>@run.ScopeKey</td>
                    <td title="@PendingTitle(run)">
                        <span class="@PendingBadge(run)">@run.OpenFindingsCount</span>
                    </td>
                    <td>@run.ResolvedFindingsCount</td>
                    <td>@run.IgnoredFindingsCount</td>
                    <td title="@TypeSummaryTitle(run)">@TypeSummary(run)</td>
                    <td>@(run.InvalidatedAtUtc?.ToLocalTime().ToString("g") ?? "-")</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectRunAsync(run.Id)" disabled="@isBusy">
                            Select
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRunAsync(run.Id)" disabled="@isBusy">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Confirmed separate teams</h2>

@if (distinctTeams is null)
{
    <p><em>Loading...</em></p>
}
else if (distinctTeams.Count == 0)
{
    <p>No persistent separate-team decisions have been recorded.</p>
}
else
{
    <p class="text-muted">These pairs are excluded from duplicate, cross-source, and cross-season identity findings. Remove a decision if the teams should be reconsidered.</p>
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Team</th>
                <th>Different team</th>
                <th>Note</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var decision in distinctTeams)
            {
                <tr>
                    <td><a href="@($"/teams/{decision.LeftTeamId}")">@decision.LeftTeamName</a></td>
                    <td><a href="@($"/teams/{decision.RightTeamId}")">@decision.RightTeamName</a></td>
                    <td>@decision.Note</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveDistinctTeamsAsync(decision)" disabled="@isBusy">
                            Remove decision
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Findings</h2>

@if (SelectedRun is not null)
{
    <p>Showing findings for run @SelectedRun.CheckedAtUtc.ToLocalTime().ToString("g") with scope @SelectedRun.ScopeKey.</p>
}
else
{
    <p>Select a run to review its findings.</p>
}

<div class="row g-2 align-items-end mb-3">
    <div class="col-sm-2">
        <label class="form-label" for="finding-status">Status</label>
        <select id="finding-status" class="form-select" @bind="findingStatus">
            <option value="open">Open</option>
            <option value="resolved">Resolved</option>
            <option value="ignored">Ignored</option>
            <option value="">All</option>
        </select>
    </div>
    <div class="col-sm-2">
        <label class="form-label" for="finding-severity">Severity</label>
        <select id="finding-severity" class="form-select" @bind="findingSeverity">
            <option value="">All</option>
            <option value="blocker">Blocker</option>
            <option value="warning">Warning</option>
        </select>
    </div>
    <div class="col-sm-2">
        <label class="form-label" for="finding-limit">Rows</label>
        <select id="finding-limit" class="form-select" @bind="findingLimit">
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="250">250</option>
            <option value="5000">All</option>
        </select>
    </div>
    <div class="col-sm-2">
        <button class="btn btn-outline-secondary w-100" @onclick="ApplyFindingFiltersAsync" disabled="@isBusy">Apply filters</button>
    </div>
</div>

@if (selectedRunId is null)
{
}
else if (findings is null)
{
    <p><em>Loading...</em></p>
}
else if (findings.Count == 0)
{
    <p>No identity findings match the current filters.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span>Showing @findings.Count row@(findings.Count == 1 ? string.Empty : "s") on page @findingPage.</span>
        @if (findingPage > 1 || findings.Count >= findingLimit)
        {
            <div class="btn-group">
                <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousFindingsPageAsync" disabled="@isBusy || findingPage <= 1">Previous</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="NextFindingsPageAsync" disabled="@isBusy || findings.Count < findingLimit">Next</button>
            </div>
        }
    </div>

    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Severity</th>
                <th>Type</th>
                <th>Teams</th>
                <th>Evidence</th>
                <th>Review</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var finding in findings)
            {
                var reviewState = GetReviewState(finding);
                var evidenceState = GetEvidenceState(finding);
                <tr>
                    <td><span class="@SeverityBadge(finding.Severity)">@finding.Severity</span></td>
                    <td>@finding.FindingType</td>
                    <td>
                        <div>@TeamLabel(finding.AffectedTeamName, finding.AffectedTeamId, finding.Source, finding.SourceTeamId)</div>
                        @if (finding.RelatedTeamId.HasValue)
                        {
                            <div>@TeamLabel(finding.RelatedTeamName, finding.RelatedTeamId, finding.RelatedSource, finding.RelatedSourceTeamId)</div>
                        }
                    </td>
                    <td>
                        <div>@finding.Evidence</div>
                        <div class="identity-evidence-trigger">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadEvidenceGamesAsync(finding.Id)" disabled="@(isBusy || evidenceState?.IsLoading == true)">
                                @(evidenceState is null ? "Show evidence games" : evidenceState.IsLoading ? "Loading games..." : "Show evidence games")
                            </button>
                            @if (evidenceState?.IsLoaded == true)
                            {
                                <span class="text-muted small">Loaded</span>
                            }
                        </div>
                    </td>
                    <td>
                        @if (finding.Status != "open")
                        {
                            <div>
                                <span class="@FindingStatusBadge(finding.Status)">@finding.Status</span>
                                <span>@FormatResolution(finding)</span>
                            </div>
                        }
                        else
                        {
                            <p class="mb-2">@finding.SuggestedAction</p>
                            @if (finding.FindingType == "alias_observation")
                            {
                                <div class="alert alert-light border py-2 px-3 mb-2">
                                    <strong>Alias will match canonical team:</strong>
                                    <span>@CanonicalAliasTarget(finding)</span>
                                </div>
                            }
                            @if (finding.AffectedTeamId.HasValue && finding.FindingType == "missing_metadata")
                            {
                                <div class="metadata-editor">
                                    <div class="metadata-field">
                                        <label class="form-label" for="canonical-@finding.Id">Canonical name</label>
                                        <input id="canonical-@finding.Id" class="form-control form-control-sm" @bind="reviewState.CanonicalName" />
                                    </div>
                                    <div class="metadata-field">
                                        <label class="form-label" for="country-@finding.Id">Country</label>
                                        <select id="country-@finding.Id" class="form-select form-select-sm" @bind="reviewState.CountryCode">
                                            <option value="">Country</option>
                                            @foreach (var country in options?.Countries ?? [])
                                            {
                                                <option value="@country.Code">@CountryLabel(country)</option>
                                            }
                                        </select>
                                    </div>
                                    <label class="form-check metadata-active" title="Active teams are included in current rankings; historical games remain even when a team is inactive.">
                                        <input class="form-check-input" type="checkbox" @bind="reviewState.IsActive" />
                                        <span class="form-check-label">Active</span>
                                    </label>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditMetadataAsync(finding, reviewState)" disabled="@isBusy">
                                        Save metadata
                                    </button>
                                </div>
                            }
                            @if (finding.FindingType == "alias_observation")
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AcceptAliasAsync(finding.Id)" disabled="@isBusy">
                                    Accept alias
                                </button>
                            }
                            else if (finding.RelatedTeamId.HasValue)
                            {
                                <div class="merge-review-panel">
                                    <div class="merge-field">
                                        <label class="form-label" for="merge-target-@finding.Id">Merge onto (team to keep)</label>
                                        <select id="merge-target-@finding.Id" class="form-select form-select-sm" @bind="reviewState.MergeTargetTeamId">
                                            @if (finding.AffectedTeamId.HasValue)
                                            {
                                                <option value="@finding.AffectedTeamId">@TeamLabel(finding.AffectedTeamName, finding.AffectedTeamId, finding.Source, finding.SourceTeamId)</option>
                                            }
                                            <option value="@finding.RelatedTeamId">@TeamLabel(finding.RelatedTeamName, finding.RelatedTeamId, finding.RelatedSource, finding.RelatedSourceTeamId)</option>
                                        </select>
                                    </div>
                                    <div class="merge-preview">
                                        <strong>What will happen</strong>
                                        <span>@MergePreview(finding, reviewState)</span>
                                    </div>
                                    <div class="merge-actions">
                                        <label class="form-check merge-confirmation">
                                            <input id="confirm-merge-@finding.Id" class="form-check-input" type="checkbox" @bind="reviewState.ConfirmMergeWithRatings" />
                                            <span class="form-check-label">I understand this merge changes historical game and rating ownership.</span>
                                        </label>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => MergeAsync(finding, reviewState)" disabled="@isBusy">
                                            Confirm &amp; merge
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => MarkReviewedAsync(finding.Id)" disabled="@isBusy">
                                            Confirm different teams
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => MarkReviewedAsync(finding.Id)" disabled="@isBusy">
                                    Mark reviewed
                                </button>
                            }

                            <button class="btn btn-sm btn-link" @onclick="() => IgnoreAsync(finding.Id)" disabled="@isBusy">
                                Ignore
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (activeEvidenceState is not null)
{
    <div class="identity-evidence-backdrop" role="presentation" @onclick="CloseEvidenceGames">
        <section class="identity-evidence-modal" role="dialog" aria-modal="true" aria-labelledby="identity-evidence-title" @onclick:stopPropagation="true">
            <div class="identity-evidence-modal-header">
                <div>
                    <p class="eyebrow mb-1">Identity evidence</p>
                    <h2 id="identity-evidence-title">Games behind this finding</h2>
                </div>
                <button type="button" class="btn-close" aria-label="Close evidence games" @onclick="CloseEvidenceGames"></button>
            </div>

            @if (activeEvidenceState.IsLoading)
            {
                <p><em>Loading evidence games...</em></p>
            }
            else if (!string.IsNullOrWhiteSpace(activeEvidenceState.ErrorMessage))
            {
                <div class="alert alert-danger mb-0">@activeEvidenceState.ErrorMessage</div>
            }
            else if (activeEvidenceState.Response is not null)
            {
                <div class="identity-evidence-options">
                    @foreach (var option in EvidenceOptions(activeEvidenceState.Response))
                    {
                        <section class="identity-evidence-option">
                            <div class="identity-evidence-option-header">
                                <div>
                                    <h3>@option.DisplayName</h3>
                                    @if (!string.IsNullOrWhiteSpace(option.Source) && !string.IsNullOrWhiteSpace(option.SourceTeamId))
                                    {
                                        <small>@option.Source:@option.SourceTeamId</small>
                                    }
                                </div>
                                <span class="text-muted small">@option.Games.Count game@(option.Games.Count == 1 ? string.Empty : "s")</span>
                            </div>

                            @if (option.Games.Count == 0)
                            {
                                <p class="identity-evidence-empty">No games found in this finding's scope.</p>
                            }
                            else
                            {
                                <div class="identity-evidence-list">
                                    @foreach (var game in option.Games)
                                    {
                                        <div class="identity-evidence-game">
                                            <div class="identity-evidence-game-main">
                                                <strong>@game.HomeTeamName <span class="identity-evidence-vs">vs</span> @game.AwayTeamName</strong>
                                                <span>@game.GameDateTimeUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                                <span>@game.CompetitionName · @game.Season</span>
                                            </div>
                                            <div class="identity-evidence-game-meta">
                                                <span>@FormatEvidenceScore(game)</span>
                                                <span>@game.Status</span>
                                                @if (!string.IsNullOrWhiteSpace(game.SourceUrl))
                                                {
                                                    <a href="@game.SourceUrl" target="_blank" rel="noopener noreferrer">@game.Source</a>
                                                }
                                                else
                                                {
                                                    <span>@game.Source</span>
                                                }
                                                <small>@game.SourceGameId</small>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            }

            <div class="identity-evidence-modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseEvidenceGames">Close</button>
            </div>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "source")]
    public string? Source { get; set; }

    [SupplyParameterFromQuery(Name = "season")]
    public string? Season { get; set; }

    private IdentityHealthCheckRequest checkRequest = new() { Source = "api-sports" };
    private string? competitionIdText;
    private IdentityHealthOptionsDto? options;
    private IReadOnlyList<IdentityHealthCheckRunDto>? runs;
    private IReadOnlyList<IdentityHealthCheckFindingDto>? findings;
    private IReadOnlyList<IdentityDistinctTeamsDecisionDto>? distinctTeams;
    private readonly Dictionary<Guid, FindingReviewState> reviewStates = [];
    private readonly Dictionary<Guid, EvidenceGamesState> evidenceGames = [];
    private Guid? activeEvidenceFindingId;
    private Guid? selectedRunId;
    private string? findingStatus = "open";
    private string? findingSeverity;
    private int findingPage = 1;
    private int findingLimit = 100;
    private bool isBusy;
    private string? message;
    private string messageCss = "alert-info";

    private IReadOnlyList<IdentityCompetitionOptionDto> FilteredCompetitionOptions => (options?.Competitions ?? [])
        .Where(x => string.IsNullOrWhiteSpace(checkRequest.CountryCode) || x.CountryCode == checkRequest.CountryCode)
        .ToList();
    private IdentityHealthCheckRunDto? SelectedRun => runs?.FirstOrDefault(x => x.Id == selectedRunId);

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Source))
        {
            checkRequest.Source = Source;
        }

        if (!string.IsNullOrWhiteSpace(Season))
        {
            checkRequest.Season = Season;
        }

        options = await Http.GetFromJsonAsync<IdentityHealthOptionsDto>("api/identity-health/options");
        if (!string.IsNullOrWhiteSpace(checkRequest.Source) &&
            options is not null &&
            !options.Sources.Contains(checkRequest.Source, StringComparer.OrdinalIgnoreCase))
        {
            checkRequest.Source = null;
        }

        await RefreshAsync();
    }

    private async Task RunCheckAsync()
    {
        isBusy = true;
        message = null;

        try
        {
            checkRequest.CompetitionId = ParseCompetitionId();
            var apiResponse = await Http.PostAsJsonAsync("api/identity-health/checks", checkRequest);
            if (!apiResponse.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorAsync(apiResponse));
            }

            var run = await apiResponse.Content.ReadFromJsonAsync<IdentityHealthCheckRunDto>()
                ?? throw new InvalidOperationException("Identity check response was empty.");
            selectedRunId = run.Id;
            message = $"Identity check finished with status '{run.Status}' and {run.FindingsCount} finding(s).";
            messageCss = run.UnresolvedBlockersCount > 0 ? "alert-warning" : "alert-success";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageCss = "alert-danger";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task MarkReviewedAsync(Guid findingId)
    {
        await ResolveAsync(findingId, new ResolveIdentityFindingRequest
        {
            Action = "keep_separate",
            ResolvedBy = "admin-ui",
            Note = "Confirmed as different clubs; suppress future duplicate, cross-source, and cross-season identity findings for this pair."
        });
    }

    private async Task RemoveDistinctTeamsAsync(IdentityDistinctTeamsDecisionDto decision)
    {
        isBusy = true;
        message = null;

        try
        {
            var response = await Http.DeleteAsync($"api/identity-health/distinct-teams/{decision.LeftTeamId}/{decision.RightTeamId}");
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorAsync(response));
            }

            message = "Separate-team decision removed.";
            messageCss = "alert-success";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageCss = "alert-danger";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task IgnoreAsync(Guid findingId)
    {
        await ResolveAsync(findingId, new ResolveIdentityFindingRequest
        {
            Action = "ignore",
            ResolvedBy = "admin-ui",
            Note = "Ignored from internal identity health page."
        });
    }

    private async Task AcceptAliasAsync(Guid findingId)
    {
        await ResolveAsync(findingId, new ResolveIdentityFindingRequest
        {
            Action = "accept_alias",
            ResolvedBy = "admin-ui",
            Note = "Accepted alias observation from internal identity health page."
        });
    }

    private async Task EditMetadataAsync(IdentityHealthCheckFindingDto finding, FindingReviewState reviewState)
    {
        if (!finding.AffectedTeamId.HasValue)
        {
            message = "This finding does not have a team to update.";
            messageCss = "alert-danger";
            return;
        }

        await ResolveAsync(finding.Id, new ResolveIdentityFindingRequest
        {
            Action = "edit_metadata",
            TargetTeamId = finding.AffectedTeamId,
            CanonicalName = reviewState.CanonicalName,
            CountryCode = reviewState.CountryCode,
            IsActive = reviewState.IsActive,
            ResolvedBy = "admin-ui",
            Note = "Updated team metadata from internal identity health page."
        });
    }

    private async Task MergeAsync(IdentityHealthCheckFindingDto finding, FindingReviewState reviewState)
    {
        if (!reviewState.MergeTargetTeamId.HasValue)
        {
            message = "Choose a target team before merging.";
            messageCss = "alert-danger";
            return;
        }

        if (!reviewState.ConfirmMergeWithRatings)
        {
            message = "Tick the confirmation box before merging teams.";
            messageCss = "alert-warning";
            return;
        }

        await ResolveAsync(finding.Id, new ResolveIdentityFindingRequest
        {
            Action = "merge_duplicate",
            TargetTeamId = reviewState.MergeTargetTeamId,
            ConfirmMergeWithRatings = reviewState.ConfirmMergeWithRatings,
            ResolvedBy = "admin-ui",
            Note = "Merged from internal identity health page."
        });
    }

    private async Task DeleteRunAsync(Guid runId)
    {
        isBusy = true;
        message = null;

        try
        {
            var response = await Http.DeleteAsync($"api/identity-health/checks/{runId}");
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorAsync(response));
            }

            reviewStates.Clear();
            if (selectedRunId == runId)
            {
                selectedRunId = null;
                findings = [];
            }

            message = "Identity run and its findings were deleted.";
            messageCss = "alert-success";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageCss = "alert-danger";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ResolveAsync(Guid findingId, ResolveIdentityFindingRequest request)
    {
        isBusy = true;
        message = null;

        try
        {
            var apiResponse = await Http.PostAsJsonAsync(
                $"api/identity-health/findings/{findingId}/resolve",
                request);

            if (!apiResponse.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorAsync(apiResponse));
            }

            message = "Finding updated.";
            messageCss = "alert-success";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageCss = "alert-danger";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RefreshAsync()
    {
        evidenceGames.Clear();
        activeEvidenceFindingId = null;
        distinctTeams = await Http.GetFromJsonAsync<IReadOnlyList<IdentityDistinctTeamsDecisionDto>>("api/identity-health/distinct-teams") ?? [];
        checkRequest.CompetitionId = ParseCompetitionId();
        runs = await Http.GetFromJsonAsync<IReadOnlyList<IdentityHealthCheckRunDto>>($"api/identity-health/checks?{BuildScopeQuery(10)}") ?? [];
        if (selectedRunId.HasValue && !runs.Any(x => x.Id == selectedRunId))
        {
            selectedRunId = null;
        }

        selectedRunId ??= runs.FirstOrDefault()?.Id;

        if (selectedRunId is null)
        {
            findings = [];
            return;
        }

        findings = await Http.GetFromJsonAsync<IReadOnlyList<IdentityHealthCheckFindingDto>>($"api/identity-health/findings?{BuildFindingQuery()}") ?? [];

        foreach (var finding in findings)
        {
            GetReviewState(finding);
        }
    }

    private async Task ApplyRunFiltersAsync()
    {
        selectedRunId = null;
        findingPage = 1;
        reviewStates.Clear();
        await RefreshAsync();
    }

    private async Task SelectRunAsync(Guid runId)
    {
        selectedRunId = runId;
        findingPage = 1;
        reviewStates.Clear();
        await RefreshAsync();
    }

    private async Task ApplyFindingFiltersAsync()
    {
        if (selectedRunId is null)
        {
            message = "Select an identity run before filtering findings.";
            messageCss = "alert-warning";
            return;
        }

        findingPage = 1;
        await RefreshAsync();
    }

    private async Task PreviousFindingsPageAsync()
    {
        if (findingPage <= 1)
        {
            return;
        }

        findingPage -= 1;
        await RefreshAsync();
    }

    private async Task NextFindingsPageAsync()
    {
        if (findings is null || findings.Count < findingLimit)
        {
            return;
        }

        findingPage += 1;
        await RefreshAsync();
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(body) ? response.ReasonPhrase ?? "Request failed." : body;
    }

    private Guid? ParseCompetitionId()
    {
        if (string.IsNullOrWhiteSpace(competitionIdText))
        {
            return null;
        }

        if (Guid.TryParse(competitionIdText, out var competitionId))
        {
            return competitionId;
        }

        throw new InvalidOperationException("Competition ID must be a valid GUID.");
    }

    private string BuildScopeQuery(int limit)
    {
        var query = new List<string> { $"limit={limit}" };
        Append(query, "source", checkRequest.Source);
        Append(query, "season", checkRequest.Season);
        Append(query, "countryCode", checkRequest.CountryCode);
        Append(query, "competitionId", competitionIdText);
        return string.Join("&", query);
    }

    private string BuildFindingQuery()
    {
        var query = new List<string>
        {
            $"runId={selectedRunId}",
            $"page={findingPage}",
            $"limit={findingLimit}"
        };
        Append(query, "status", findingStatus);
        Append(query, "severity", findingSeverity);
        return string.Join("&", query);
    }

    private static void Append(List<string> query, string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        query.Add($"{Uri.EscapeDataString(key)}={Uri.EscapeDataString(value)}");
    }

    private static string PendingBadge(IdentityHealthCheckRunDto run)
    {
        return run.OpenBlockersCount > 0
            ? "badge bg-danger"
            : run.OpenWarningsCount > 0
                ? "badge bg-warning text-dark"
                : "badge bg-success";
    }

    private static string PendingTitle(IdentityHealthCheckRunDto run)
    {
        return $"{run.OpenFindingsCount} open: {run.OpenBlockersCount} blocker(s), {run.OpenWarningsCount} warning(s).";
    }

    private static string TypeSummary(IdentityHealthCheckRunDto run)
    {
        if (run.TypeSummaries.Count == 0)
        {
            return "-";
        }

        return string.Join(", ", run.TypeSummaries.Take(3).Select(x => $"{FormatType(x.FindingType)} {x.OpenCount}/{x.OpenCount + x.ResolvedCount + x.IgnoredCount}"));
    }

    private static string TypeSummaryTitle(IdentityHealthCheckRunDto run)
    {
        if (run.TypeSummaries.Count == 0)
        {
            return "No findings.";
        }

        return string.Join(Environment.NewLine, run.TypeSummaries.Select(x =>
            $"{FormatType(x.FindingType)}: {x.OpenCount} open, {x.ResolvedCount} resolved, {x.IgnoredCount} ignored"));
    }

    private static string FormatType(string findingType)
    {
        return findingType.Replace('_', ' ');
    }

    private static string SeverityBadge(string severity)
    {
        return severity == "blocker" ? "badge bg-danger" : "badge bg-warning text-dark";
    }

    private static string FindingStatusBadge(string status)
    {
        return status == "resolved"
            ? "badge bg-success"
            : status == "ignored"
                ? "badge bg-secondary"
                : "badge bg-info text-dark";
    }

    private static string FormatResolution(IdentityHealthCheckFindingDto finding)
    {
        var action = string.IsNullOrWhiteSpace(finding.ResolutionAction)
            ? finding.Status
            : finding.ResolutionAction.Replace('_', ' ');
        var when = finding.ResolvedAtUtc?.ToLocalTime().ToString("g");

        return string.IsNullOrWhiteSpace(when) ? action : $"{action} on {when}";
    }

    private static string CompetitionLabel(IdentityCompetitionOptionDto competition)
    {
        return string.IsNullOrWhiteSpace(competition.CountryCode)
            ? $"{competition.Name} ({competition.Id})"
            : $"{competition.Name} [{competition.CountryCode}] ({competition.Id})";
    }

    private static string CountryLabel(IdentityCountryOptionDto country)
    {
        return $"{country.Name} [{country.Code}]";
    }

    private FindingReviewState GetReviewState(IdentityHealthCheckFindingDto finding)
    {
        if (!reviewStates.TryGetValue(finding.Id, out var state))
        {
            state = new FindingReviewState
            {
                CanonicalName = finding.AffectedTeamName,
                CountryCode = finding.SuggestedCountryCode ?? finding.AffectedTeamCountryCode,
                IsActive = finding.AffectedTeamIsActive ?? true,
                MergeTargetTeamId = finding.RelatedTeamId ?? finding.AffectedTeamId
            };
            reviewStates[finding.Id] = state;
        }

        return state;
    }

    private EvidenceGamesState? GetEvidenceState(IdentityHealthCheckFindingDto finding)
        => evidenceGames.TryGetValue(finding.Id, out var state) ? state : null;

    private async Task LoadEvidenceGamesAsync(Guid findingId)
    {
        if (!evidenceGames.TryGetValue(findingId, out var state))
        {
            state = new EvidenceGamesState();
            evidenceGames[findingId] = state;
        }

        activeEvidenceFindingId = findingId;
        state.IsLoading = true;
        state.IsLoaded = false;
        state.ErrorMessage = null;

        try
        {
            state.Response = await Http.GetFromJsonAsync<IdentityEvidenceGamesResponseDto>(
                $"api/identity-health/findings/{findingId}/games?limit=12")
                ?? throw new InvalidOperationException("The API returned an empty evidence-games response.");
            state.IsLoaded = true;
        }
        catch (Exception ex)
        {
            state.ErrorMessage = $"Could not load evidence games: {ex.Message}";
        }
        finally
        {
            state.IsLoading = false;
        }
    }

    private EvidenceGamesState? activeEvidenceState
        => activeEvidenceFindingId.HasValue && evidenceGames.TryGetValue(activeEvidenceFindingId.Value, out var state)
            ? state
            : null;

    private static IEnumerable<IdentityEvidenceTeamGamesDto> EvidenceOptions(IdentityEvidenceGamesResponseDto response)
        => new[] { response.AffectedTeam, response.RelatedTeam }
            .Where(x => x is not null)
            .Select(x => x!);

    private void CloseEvidenceGames()
    {
        activeEvidenceFindingId = null;
    }

    private static string FormatEvidenceScore(IdentityEvidenceGameDto game)
        => game.HomeScore.HasValue && game.AwayScore.HasValue
            ? $"{game.HomeScore}-{game.AwayScore}"
            : "Score pending";

    private static string MergePreview(IdentityHealthCheckFindingDto finding, FindingReviewState state)
    {
        if (!state.MergeTargetTeamId.HasValue)
        {
            return "Choose the team that should remain.";
        }

        var targetIsAffected = state.MergeTargetTeamId == finding.AffectedTeamId;
        var target = targetIsAffected
            ? TeamLabel(finding.AffectedTeamName, finding.AffectedTeamId, finding.Source, finding.SourceTeamId)
            : TeamLabel(finding.RelatedTeamName, finding.RelatedTeamId, finding.RelatedSource, finding.RelatedSourceTeamId);
        var source = targetIsAffected
            ? TeamLabel(finding.RelatedTeamName, finding.RelatedTeamId, finding.RelatedSource, finding.RelatedSourceTeamId)
            : TeamLabel(finding.AffectedTeamName, finding.AffectedTeamId, finding.Source, finding.SourceTeamId);

        return $"{source} will be removed as a separate team; its games, aliases, rating history, and ratings will be assigned to {target}.";
    }

    private static string TeamLabel(string? name, Guid? teamId, string? source, string? sourceTeamId)
    {
        var displayName = DisplayName(name, teamId);
        var sourceLabel = string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(sourceTeamId)
            ? string.Empty
            : $" ({source}:{sourceTeamId})";

        return $"{displayName}{sourceLabel}";
    }

    private static string DisplayName(string? name, Guid? teamId)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            return name;
        }

        return teamId?.ToString() ?? "Unknown team";
    }

    private static string CanonicalAliasTarget(IdentityHealthCheckFindingDto finding)
    {
        return !string.IsNullOrWhiteSpace(finding.AffectedTeamName)
            ? finding.AffectedTeamName
            : "No canonical team resolved";
    }

    private sealed class FindingReviewState
    {
        public string? CanonicalName { get; set; }
        public string? CountryCode { get; set; }
        public bool IsActive { get; set; } = true;
        public Guid? MergeTargetTeamId { get; set; }
        public bool ConfirmMergeWithRatings { get; set; }
    }

    private sealed class EvidenceGamesState
    {
        public IdentityEvidenceGamesResponseDto? Response { get; set; }
        public bool IsLoading { get; set; }
        public bool IsLoaded { get; set; }
        public string? ErrorMessage { get; set; }
    }
}
