    private async Task TeamSearchChangedAsync()
    {
        CancelTeamSearchDebounce();

        var requestVersion = ++teamSearchRequestVersion;
        var searchText = teamSearch;

        var debounceCancellation = new CancellationTokenSource();
        var requestCancellation = new CancellationTokenSource();
        teamSearchDebounceCancellation = debounceCancellation;
        teamSearchRequestCancellation = requestCancellation;
        try
        {
            await Task.Delay(300, debounceCancellation.Token);
            if (debounceCancellation.IsCancellationRequested ||
                !IsCurrentTeamSearchRequest(requestVersion, searchText))
            {
                return;
            }

            await RefreshSelectionAsync(1, requestCancellation.Token, requestVersion, searchText);
        }
        catch (OperationCanceledException) when (debounceCancellation.IsCancellationRequested || requestCancellation.IsCancellationRequested)
        {
            // A newer keystroke replaced this pending search.
        }
        finally
        {
            if (ReferenceEquals(teamSearchDebounceCancellation, debounceCancellation))
            {
                teamSearchDebounceCancellation = null;
            }

            if (ReferenceEquals(teamSearchRequestCancellation, requestCancellation))
            {
                teamSearchRequestCancellation = null;
            }

            debounceCancellation.Dispose();
            requestCancellation.Dispose();
        }
    }

    private void CancelTeamSearchDebounce()
    {
        teamSearchRequestVersion++;

        var debounceCancellation = teamSearchDebounceCancellation;
        teamSearchDebounceCancellation = null;
        debounceCancellation?.Cancel();
        debounceCancellation?.Dispose();

        var requestCancellation = teamSearchRequestCancellation;
        teamSearchRequestCancellation = null;
        requestCancellation?.Cancel();
        requestCancellation?.Dispose();
    }

    private bool IsCurrentTeamSearchRequest(long? requestVersion, string? searchText)
        => !requestVersion.HasValue ||
            (requestVersion.Value == teamSearchRequestVersion &&
             string.Equals(teamSearch, searchText, StringComparison.Ordinal));

