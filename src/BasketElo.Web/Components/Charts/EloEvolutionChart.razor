@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="elo-chart">
    @if (EnableRangeNavigation)
    {
        <div class="elo-chart-toolbar" aria-label="Chart range controls">
            <div class="elo-chart-controls">
                <label class="elo-chart-sampling-select">
                    <span>View</span>
                    <select aria-label="Chart sampling mode" value="@samplingMode" @onchange="HandleSamplingModeChanged">
                        <option value="@EloChartSamplingMode.GameByGame">Games</option>
                        <option value="@EloChartSamplingMode.Weekly">Weeks</option>
                        <option value="@EloChartSamplingMode.Monthly">Months</option>
                    </select>
                </label>
                <div class="elo-chart-range-buttons">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ShowFullRange">Reset zoom</button>
                    @if (ShowDiagnostics)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                aria-expanded="@diagnosticsExpanded"
                                @onclick="ToggleDiagnostics">
                            Diagnostics
                        </button>
                    }
                </div>
            </div>
            <span class="elo-chart-context">
                <span>@ChartContextLabel</span>
                @if (ShowDiagnostics && diagnosticsExpanded)
                {
                    <span class="elo-chart-metrics">
                        <span>@VisibleChartPointCount plotted</span>
                        <span>@CurrentRatedPointCount rated in view / @TotalRatedPointCount full range</span>
                    </span>
                }
                <span class="elo-chart-refinement-slot" aria-live="polite">
                    @if (ChartBusy)
                    {
                        <span class="spinner-border spinner-border-sm elo-chart-refinement-spinner" aria-hidden="true"></span>
                        <span class="visually-hidden">@ChartBusyLabel</span>
                    }
                </span>
            </span>
        </div>
    }

    @if (ShowSeriesControls && EnableRangeNavigation && SourceSeries.Count > 1)
    {
        <div class="elo-chart-series-controls" aria-label="Chart legend and visibility controls">
            <span class="elo-chart-series-controls-label">Legend</span>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    @onclick="ToggleAllSeriesAsync"
                    disabled="@(SourceSeries.Count == 0)">@(AllSeriesVisible ? "Hide all" : "Show all")</button>
            @foreach (var series in SourceSeries)
            {
                var isVisible = IsSeriesVisible(series);
                <button type="button"
                        class="elo-chart-series-toggle @(isVisible ? "is-visible" : "is-hidden")"
                        aria-pressed="@isVisible"
                        title="@(isVisible ? $"Hide {series.TeamName}" : $"Show {series.TeamName}")"
                        @onclick="() => ToggleSeriesAsync(series)">
                    <span class="elo-chart-series-toggle-swatch" style="background: @series.Color"></span>
                    <span class="elo-chart-series-toggle-name">@series.TeamName</span>
                    @if (ShowDiagnostics && diagnosticsExpanded)
                    {
                        <small>@GetVisibleChartPointCount(series) plotted &#183; @RatedPointCount(series) rated</small>
                    }
                </button>
            }
        </div>
    }

    <div class="elo-chart-plot">
        @if (selectedPoint is not null)
        {
            <div class="elo-chart-selection-strip" style="--active-team-color: @selectedPoint.Color" role="status" aria-live="polite">
                <div class="elo-chart-tooltip-team">
                    <span class="elo-chart-active-swatch"></span>
                    <strong>@selectedPoint.TeamName</strong>
                </div>
                <span>@FormatDate(selectedPoint.GameDateTimeUtc)</span>
                <strong>@selectedPoint.Elo.ToString("0") ELO</strong>
                @if (selectedPoint.EloDelta.HasValue)
                {
                    <span>Change @FormatMovement(selectedPoint.EloDelta.Value)</span>
                }
                @if (selectedPoint.Rank.HasValue)
                {
                    <span>Rank #@selectedPoint.Rank</span>
                }
                <button type="button" class="elo-chart-selection-clear" @onclick="ClearSelection" aria-label="Clear selected chart point">×</button>
            </div>
        }

        <div class="elo-chart-comparison @(!CompareRenderers ? "elo-chart-single" : string.Empty)"
             aria-label="@(CompareRenderers ? "Radzen and Dygraphs chart comparison" : UseDygraphs ? "Dygraphs Canvas chart" : "Radzen SVG chart")">
            @if (CompareRenderers || !UseDygraphs)
            {
                <section class="elo-chart-comparison-pane" aria-label="Radzen SVG chart">
                    @if (CompareRenderers)
                    {
                        <div class="elo-chart-comparison-heading">
                            <strong>Radzen / SVG</strong>
                            <span>Current renderer</span>
                        </div>
                    }
                    <RadzenChart @key="samplingMode"
                                 class="elo-radzen-chart"
                                 Style="@ChartStyle"
                                 TooltipTolerance="40"
                                 ClickTolerance="40"
                                 MouseMoveThrottle="25"
                                 AllowSeriesHover="true"
                                 AllowZoom="false"
                                 AllowPan="false">
                        <RadzenChartTooltipOptions Shared="@SharedTooltip" Trigger="@TooltipTrigger" HighlightDataPoint="false" />
                        <RadzenLegend Visible="@ShowLegend" Position="LegendPosition.Bottom" />

                        @foreach (var series in DisplaySeries)
                        {
                            <RadzenLineSeries Data="@series.Points"
                                              TItem="EloChartPoint"
                                              CategoryProperty="@CategoryProperty"
                                              ValueProperty="@nameof(EloChartPoint.Elo)"
                                              Title="@series.TeamName"
                                              Stroke="@series.Color"
                                              StrokeWidth="3"
                                              Smooth="@Smooth">
                                <ChildContent>
                                    <RadzenMarkers MarkerType="MarkerType.Circle" Size="2" Fill="@series.Color" Stroke="@series.Color" />
                                </ChildContent>
                                <TooltipTemplate Context="point">
                                    <div class="elo-chart-tooltip" style="--active-team-color: @point.Color">
                                        <div class="elo-chart-tooltip-team">
                                            <span class="elo-chart-active-swatch"></span>
                                            <strong>@point.TeamName</strong>
                                        </div>
                                        <span>@FormatDate(point.GameDateTimeUtc)</span>
                                        <span>@point.Elo.ToString("0") ELO</span>
                                        @if (point.EloDelta.HasValue)
                                        {
                                            <span>Change @FormatMovement(point.EloDelta.Value)</span>
                                        }
                                        @if (point.Rank.HasValue)
                                        {
                                            <span>Rank #@point.Rank</span>
                                        }
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                        }

                        <RadzenCategoryAxis Formatter="@FormatCategoryAxis"
                                            LabelAutoRotation="-35"
                                            Min="@CategoryAxisMin"
                                            Max="@CategoryAxisMax"
                                            TickPlacement="@CategoryTickPlacement">
                            <RadzenAxisCrosshair Visible="true" Label="true" Snap="true" Stroke="#6b7682" />
                        </RadzenCategoryAxis>
                        <RadzenValueAxis Formatter="@FormatEloAxis">
                            <RadzenGridLines Visible="true" />
                            <RadzenAxisCrosshair Visible="true" Label="true" Stroke="#9aa6b2" />
                        </RadzenValueAxis>

                        @if (DisplaySeries.FirstOrDefault() is { } navigatorSeries)
                        {
                            <RadzenChartRangeNavigator Visible="@EnableRangeNavigation"
                                                       Height="52"
                                                       ShowHandleLabels="true">
                                <RadzenRangeNavigatorLineSeries TItem="EloChartPoint"
                                                                Data="@navigatorSeries.Points"
                                                                CategoryProperty="@nameof(EloChartPoint.GameDateTimeUtc)"
                                                                ValueProperty="@nameof(EloChartPoint.Elo)"
                                                                Stroke="@navigatorSeries.Color"
                                                                StrokeWidth="2"
                                                                Smooth="@Smooth" />
                            </RadzenChartRangeNavigator>
                        }
                    </RadzenChart>
                </section>
            }

            @if (CompareRenderers || UseDygraphs)
            {
                <section class="elo-chart-comparison-pane" aria-label="Dygraphs Canvas chart">
                    @if (CompareRenderers)
                    {
                        <div class="elo-chart-comparison-heading">
                            <strong>Dygraphs / Canvas</strong>
                            <span>New renderer</span>
                        </div>
                    }
                    <div @ref="chartHost"
                         class="elo-dygraph-chart"
                         style="@ChartStyle"
                         role="img"
                         aria-label="ELO history chart"></div>
                </section>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<EloChartSeries> Series { get; set; } = [];

    [Parameter]
    public bool ShowLegend { get; set; } = true;

    [Parameter]
    public bool ShowSeriesControls { get; set; } = true;

    [Parameter]
    public bool ShowDiagnostics { get; set; }

    [Parameter]
    public IReadOnlyCollection<Guid> HiddenTeamIds { get; set; } = [];

    [Parameter]
    public EventCallback<Guid> SeriesVisibilityChanged { get; set; }

    [Parameter]
    public EventCallback ShowAllSeriesRequested { get; set; }

    [Parameter]
    public EventCallback HideAllSeriesRequested { get; set; }

    [Parameter]
    public bool SharedTooltip { get; set; } = true;

    [Parameter]
    public bool EnableRangeNavigation { get; set; }

    [Parameter]
    public bool CompareRenderers { get; set; }

    [Parameter]
    public bool UseDygraphs { get; set; } = true;

    [Parameter]
    public bool Smooth { get; set; }

    [Parameter]
    public int HeightPixels { get; set; } = 340;

    [Parameter]
    public long DataRevision { get; set; }

    [Parameter]
    public bool IsRefining { get; set; }

    [Parameter]
    public EventCallback<EloChartViewportRange> ViewportRefinementRequested { get; set; }

    [Parameter]
    public EventCallback FullRangeRequested { get; set; }

    private double viewStart;
    private double viewEnd = 1;
    private DateTime? viewFromUtc;
    private DateTime? viewToUtc;

    private EloChartSamplingMode samplingMode = EloChartSamplingMode.GameByGame;
    private IReadOnlyList<EloChartSeries> sourceSeries = [];
    private IReadOnlyList<EloChartSeries> displaySeries = [];
    private IReadOnlyList<EloChartPoint> allPoints = [];
    private IReadOnlyList<DateTime> activeDates = [];
    private EloChartPoint? selectedPoint;
    private long renderedDataRevision = -1;
    private bool diagnosticsExpanded;
    private bool chartInitialized;
    private bool chartRenderPending;
    private bool chartPaintPending;
    private string renderedChartSignature = string.Empty;
    private ElementReference chartHost;
    private DotNetObjectReference<EloEvolutionChart>? dotNetReference;
    private readonly HashSet<string> hiddenSeriesKeys = new(StringComparer.Ordinal);

    private string ChartStyle => $"height: {Math.Clamp(HeightPixels, 260, 900)}px";

    private bool ChartBusy => IsRefining || chartPaintPending;

    private string ChartBusyLabel => IsRefining ? "Refreshing chart detail" : "Rendering chart";

    private string CategoryProperty => samplingMode == EloChartSamplingMode.GameByGame
        ? nameof(EloChartPoint.ActiveDateIndex)
        : nameof(EloChartPoint.GameDateTimeUtc);

    private object? CategoryAxisMin =>
        samplingMode == EloChartSamplingMode.GameByGame && activeDates.Count > 1
            ? 0d
            : null;

    private object? CategoryAxisMax =>
        samplingMode == EloChartSamplingMode.GameByGame && activeDates.Count > 1
            ? (double)(activeDates.Count - 1)
            : null;

    private TickPlacement CategoryTickPlacement =>
        samplingMode == EloChartSamplingMode.GameByGame
            ? TickPlacement.On
            : TickPlacement.Between;

    private ChartTooltipTrigger TooltipTrigger => ChartTooltipTrigger.Axis;

    private IReadOnlyList<EloChartSeries> SourceSeries
        => sourceSeries;

    private IReadOnlyList<EloChartSeries> DisplaySeries
        => displaySeries;

    private IReadOnlyList<EloChartPoint> AllPoints
        => allPoints;

    private int VisibleChartPointCount
        => DisplaySeries.Sum(GetVisibleChartPointCount);

    private int TotalRatedPointCount
        => DisplaySeries.Sum(RatedPointCount);

    private int CurrentRatedPointCount
        => DisplaySeries.Sum(series => series.VisibleRatedPointCount ?? RatedPointCount(series));

    private string ChartContextLabel
    {
        get
        {
            var points = AllPoints;
            if (points.Count == 0)
            {
                return "No range";
            }

            var visibleRange = GetCurrentVisibleDateRange();
            if (!visibleRange.HasValue)
            {
                return "No range";
            }

            return $"{SamplingLabel(samplingMode)}: {FormatDate(visibleRange.Value.FromUtc)} - {FormatDate(visibleRange.Value.ToUtc)}";
        }
    }

    protected override void OnParametersSet()
    {
        if (!ShowDiagnostics)
        {
            diagnosticsExpanded = false;
        }

        var dataChanged = renderedDataRevision != DataRevision;
        sourceSeries = Series
            .Select(series => series with
            {
                Points = series.Points
                    .OrderBy(point => point.GameDateTimeUtc)
                    .ToList()
            })
            .Where(x => x.Points.Count >= 2)
            .ToList();
        if (UsesExternalVisibilityState)
        {
            hiddenSeriesKeys.Clear();
            hiddenSeriesKeys.UnionWith(HiddenTeamIds.Select(teamId => teamId.ToString("D")));
        }
        else
        {
            hiddenSeriesKeys.RemoveWhere(key => sourceSeries.All(series => SeriesKey(series) != key));
        }
        RebuildDisplaySeries();

        var chartSignature = BuildChartSignature();
        var renderRequested = dataChanged || !string.Equals(renderedChartSignature, chartSignature, StringComparison.Ordinal);
        chartRenderPending |= renderRequested;
        chartPaintPending |= renderRequested && UseDygraphs;
        renderedChartSignature = chartSignature;

        if (!EnableRangeNavigation || dataChanged)
        {
            ResetView();
        }

        if (dataChanged)
        {
            selectedPoint = null;
        }

        renderedDataRevision = DataRevision;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!UseDygraphs)
        {
            return;
        }

        if (!chartInitialized)
        {
            dotNetReference ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("basketEloDygraph.initialize", chartHost);
            chartInitialized = true;
        }

        if (chartRenderPending)
        {
            chartRenderPending = false;
            try
            {
                await JS.InvokeVoidAsync("basketEloDygraph.render", chartHost, BuildDygraphPayload(), dotNetReference);
            }
            finally
            {
                if (!chartRenderPending && chartPaintPending)
                {
                    chartPaintPending = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    [JSInvokable("HandleDygraphPointClick")]
    public async Task HandleDygraphPointClick(string teamName, double xMillis)
    {
        var date = DateTimeOffset.FromUnixTimeMilliseconds((long)xMillis).UtcDateTime;
        selectedPoint = displaySeries
            .FirstOrDefault(series => string.Equals(series.TeamName, teamName, StringComparison.Ordinal))?
            .Points
            .OrderBy(point => Math.Abs((point.GameDateTimeUtc - date).Ticks))
            .FirstOrDefault();

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable("HandleDygraphViewChange")]
    public async Task HandleDygraphViewChange(double requestedStart, double requestedEnd)
    {
        viewStart = Math.Clamp(Math.Min(requestedStart, requestedEnd), 0, 1);
        viewEnd = Math.Clamp(Math.Max(requestedStart, requestedEnd), 0, 1);
        var visibleRange = GetVisibleDateRange(viewStart, viewEnd);
        if (visibleRange.HasValue)
        {
            viewFromUtc = visibleRange.Value.FromUtc;
            viewToUtc = visibleRange.Value.ToUtc;
            await RequestViewportRefinementAsync(viewFromUtc.Value, viewToUtc.Value);
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable("HandleDygraphDateRangeChange")]
    public async Task HandleDygraphDateRangeChange(double requestedStartMillis, double requestedEndMillis)
    {
        var startMillis = Math.Min(requestedStartMillis, requestedEndMillis);
        var endMillis = Math.Max(requestedStartMillis, requestedEndMillis);
        var fullRange = GetVisibleDateRange(0, 1);
        if (fullRange.HasValue)
        {
            var requestedFromUtc = DateTimeOffset.FromUnixTimeMilliseconds((long)startMillis).UtcDateTime;
            var requestedToUtc = DateTimeOffset.FromUnixTimeMilliseconds((long)endMillis).UtcDateTime;
            var clampedFromUtc = requestedFromUtc < fullRange.Value.FromUtc
                ? fullRange.Value.FromUtc
                : requestedFromUtc;
            var clampedToUtc = requestedToUtc > fullRange.Value.ToUtc
                ? fullRange.Value.ToUtc
                : requestedToUtc;
            if (clampedToUtc < clampedFromUtc)
            {
                clampedFromUtc = fullRange.Value.FromUtc;
                clampedToUtc = fullRange.Value.ToUtc;
            }

            viewFromUtc = clampedFromUtc;
            viewToUtc = clampedToUtc;
            await RequestViewportRefinementAsync(viewFromUtc.Value, viewToUtc.Value);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowFullRange()
    {
        ResetView();
        chartRenderPending = true;
        await InvokeAsync(StateHasChanged);
        if (FullRangeRequested.HasDelegate)
        {
            await FullRangeRequested.InvokeAsync();
        }
    }

    private void SetSamplingMode(EloChartSamplingMode mode)
    {
        if (samplingMode == mode)
        {
            return;
        }

        samplingMode = mode;
        RebuildDisplaySeries();
        ResetView();
        chartRenderPending = true;
    }

    private void HandleSamplingModeChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<EloChartSamplingMode>(args.Value?.ToString(), out var mode))
        {
            SetSamplingMode(mode);
        }
    }

    private void ToggleDiagnostics()
        => diagnosticsExpanded = !diagnosticsExpanded;

    private async Task ToggleSeriesAsync(EloChartSeries series)
    {
        if (series.TeamId is Guid teamId && SeriesVisibilityChanged.HasDelegate)
        {
            await SeriesVisibilityChanged.InvokeAsync(teamId);
            return;
        }

        ToggleSeries(series);
    }

    private void ToggleSeries(EloChartSeries series)
    {
        var key = SeriesKey(series);
        if (!hiddenSeriesKeys.Add(key))
        {
            hiddenSeriesKeys.Remove(key);
        }

        if (selectedPoint is not null && !IsSeriesVisible(series) && selectedPoint.TeamName == series.TeamName)
        {
            selectedPoint = null;
        }

        RebuildDisplaySeries();
        chartRenderPending = true;
    }

    private async Task ToggleAllSeriesAsync()
    {
        if (AllSeriesVisible)
        {
            if (HideAllSeriesRequested.HasDelegate)
            {
                await HideAllSeriesRequested.InvokeAsync();
            }
            else
            {
                HideAllSeries();
            }

            return;
        }

        if (ShowAllSeriesRequested.HasDelegate)
        {
            await ShowAllSeriesRequested.InvokeAsync();
        }
        else
        {
            ShowAllSeries();
        }
    }

    private void ShowAllSeries()
    {
        hiddenSeriesKeys.Clear();
        RebuildDisplaySeries();
        chartRenderPending = true;
    }

    private void HideAllSeries()
    {
        hiddenSeriesKeys.Clear();
        hiddenSeriesKeys.UnionWith(SourceSeries.Select(SeriesKey));
        selectedPoint = null;
        RebuildDisplaySeries();
        chartRenderPending = true;
    }

    private bool IsSeriesVisible(EloChartSeries series)
        => !hiddenSeriesKeys.Contains(SeriesKey(series));

    private bool AllSeriesVisible
        => hiddenSeriesKeys.Count == 0;

    private bool UsesExternalVisibilityState
        => SeriesVisibilityChanged.HasDelegate || ShowAllSeriesRequested.HasDelegate || HideAllSeriesRequested.HasDelegate;

    private static string SeriesKey(EloChartSeries series)
        => series.TeamId?.ToString("D") ?? series.TeamName;

    private int GetVisibleChartPointCount(EloChartSeries series)
    {
        var display = displaySeries.FirstOrDefault(item => SeriesKey(item) == SeriesKey(series));
        if (display is null)
        {
            return 0;
        }

        var range = GetCurrentVisibleDateRange();
        return range is null
            ? display.Points.Count
            : display.Points.Count(point => point.GameDateTimeUtc >= range.Value.FromUtc && point.GameDateTimeUtc <= range.Value.ToUtc);
    }

    private static int RatedPointCount(EloChartSeries series)
        => series.RatedPointCount > 0 ? series.RatedPointCount : series.Points.Count;

    private void ClearSelection()
        => selectedPoint = null;

    private void RebuildDisplaySeries()
    {
        var sampledSeries = sourceSeries
            .Select(series => series with
            {
                Points = SamplePoints(series.Points, samplingMode)
            })
            .Where(IsSeriesVisible)
            .Where(x => x.Points.Count >= 2)
            .ToList();

        if (samplingMode == EloChartSamplingMode.GameByGame)
        {
            activeDates = sampledSeries
                .SelectMany(series => series.Points)
                .Select(point => point.GameDateTimeUtc.Date)
                .Distinct()
                .OrderBy(date => date)
                .ToList();
            var activeDateIndexes = activeDates
                .Select((date, index) => new { date, index })
                .ToDictionary(item => item.date, item => item.index);

            displaySeries = sampledSeries
                .Select(series => series with
                {
                    Points = series.Points
                        .Select(point => point with
                        {
                            ActiveDateIndex = activeDateIndexes[point.GameDateTimeUtc.Date]
                        })
                        .ToList()
                })
                .ToList();
        }
        else
        {
            activeDates = [];
            displaySeries = sampledSeries;
        }

        allPoints = displaySeries
            .SelectMany(x => x.Points)
            .OrderBy(x => x.GameDateTimeUtc)
            .ToList();
    }

    private string BuildChartSignature()
    {
        var signature = new HashCode();
        signature.Add(samplingMode);
        foreach (var hiddenKey in hiddenSeriesKeys.OrderBy(key => key, StringComparer.Ordinal))
        {
            signature.Add(hiddenKey, StringComparer.Ordinal);
        }

        foreach (var series in displaySeries)
        {
            signature.Add(SeriesKey(series), StringComparer.Ordinal);
            signature.Add(series.TeamName, StringComparer.Ordinal);
            signature.Add(series.Color, StringComparer.Ordinal);
            signature.Add(series.Points.Count);
            foreach (var point in series.Points)
            {
                signature.Add(point.GameDateTimeUtc.Ticks);
                signature.Add(point.Elo);
                signature.Add(point.EloDelta);
                signature.Add(point.Rank);
            }
        }

        return signature.ToHashCode().ToString("X8", CultureInfo.InvariantCulture);
    }

    private object BuildDygraphPayload()
        => new
        {
            sharedTooltip = SharedTooltip,
            enableRangeNavigation = EnableRangeNavigation,
            viewStart,
            viewEnd,
            viewFromUtc = viewFromUtc.HasValue ? ToUnixMilliseconds(viewFromUtc.Value) : (long?)null,
            viewToUtc = viewToUtc.HasValue ? ToUnixMilliseconds(viewToUtc.Value) : (long?)null,
            series = displaySeries.Select(series => new
            {
                name = series.TeamName,
                color = series.Color,
                points = series.Points.Select(point => new
                {
                    x = ToUnixMilliseconds(point.GameDateTimeUtc),
                    y = (double)point.Elo,
                    delta = point.EloDelta.HasValue ? (double?)point.EloDelta.Value : null,
                    rank = point.Rank
                }).ToList()
            }).ToList()
        };

    private static long ToUnixMilliseconds(DateTime value)
        => new DateTimeOffset(DateTime.SpecifyKind(value, DateTimeKind.Utc)).ToUnixTimeMilliseconds();

    private async Task RequestViewportRefinementAsync(DateTime requestedFromUtc, DateTime requestedToUtc)
    {
        if (!ViewportRefinementRequested.HasDelegate || sourceSeries.Count == 0)
        {
            return;
        }

        var fullRange = GetVisibleDateRange(0, 1);
        if (!fullRange.HasValue)
        {
            return;
        }

        var requestedRange = (
            FromUtc: requestedFromUtc < fullRange.Value.FromUtc ? fullRange.Value.FromUtc : requestedFromUtc,
            ToUtc: requestedToUtc > fullRange.Value.ToUtc ? fullRange.Value.ToUtc : requestedToUtc);
        if (requestedRange.FromUtc.Date <= fullRange.Value.FromUtc.Date &&
            requestedRange.ToUtc.Date >= fullRange.Value.ToUtc.Date)
        {
            if (FullRangeRequested.HasDelegate)
            {
                await FullRangeRequested.InvokeAsync();
            }

            return;
        }

        await ViewportRefinementRequested.InvokeAsync(new EloChartViewportRange(
            DateTime.SpecifyKind(requestedRange.FromUtc, DateTimeKind.Utc),
            DateTime.SpecifyKind(requestedRange.ToUtc, DateTimeKind.Utc)));
    }

    private (DateTime FromUtc, DateTime ToUtc)? GetCurrentVisibleDateRange()
        => UseDygraphs && viewFromUtc.HasValue && viewToUtc.HasValue
            ? (viewFromUtc.Value, viewToUtc.Value)
            : GetVisibleDateRange(viewStart, viewEnd);

    private (DateTime FromUtc, DateTime ToUtc)? GetVisibleDateRange(
        double requestedStart,
        double requestedEnd,
        bool includeAdjacentPoints = false)
    {
        var dates = UseDygraphs
            ? allPoints
                .Select(x => x.GameDateTimeUtc)
                .Distinct()
                .OrderBy(x => x)
                .ToList()
            : samplingMode == EloChartSamplingMode.GameByGame
            ? activeDates
            : allPoints
                .Select(x => x.GameDateTimeUtc)
                .Distinct()
                .OrderBy(x => x)
                .ToList();
        if (dates.Count == 0)
        {
            return null;
        }

        var startFraction = Math.Clamp(Math.Min(requestedStart, requestedEnd), 0, 1);
        var endFraction = Math.Clamp(Math.Max(requestedStart, requestedEnd), 0, 1);

        if (UseDygraphs)
        {
            var fromUtc = InterpolateDate(dates[0], dates[^1], startFraction);
            var toUtc = InterpolateDate(dates[0], dates[^1], endFraction);
            if (includeAdjacentPoints)
            {
                fromUtc = dates.LastOrDefault(date => date < fromUtc, dates[0]);
                toUtc = dates.FirstOrDefault(date => date > toUtc, dates[^1]);
            }

            return (fromUtc, toUtc);
        }

        var startIndex = (int)Math.Floor(startFraction * (dates.Count - 1));
        var endIndex = (int)Math.Ceiling(endFraction * (dates.Count - 1));
        if (includeAdjacentPoints)
        {
            startIndex = Math.Max(0, startIndex - 1);
            endIndex = Math.Min(dates.Count - 1, endIndex + 1);
        }

        return (dates[startIndex], dates[endIndex]);
    }

    private static DateTime InterpolateDate(DateTime fromUtc, DateTime toUtc, double fraction)
    {
        if (toUtc <= fromUtc)
        {
            return fromUtc;
        }

        var ticks = (long)Math.Round((toUtc.Ticks - fromUtc.Ticks) * fraction);
        return fromUtc.AddTicks(ticks);
    }

    private void ResetView()
    {
        viewStart = 0;
        viewEnd = 1;
        viewFromUtc = null;
        viewToUtc = null;
    }

    private static IReadOnlyList<EloChartPoint> SamplePoints(
        IReadOnlyList<EloChartPoint> sourcePoints,
        EloChartSamplingMode mode)
    {
        if (mode == EloChartSamplingMode.GameByGame || sourcePoints.Count < 2)
        {
            return sourcePoints;
        }

        var points = sourcePoints.OrderBy(point => point.GameDateTimeUtc).ToList();
        var firstBoundary = mode == EloChartSamplingMode.Weekly
            ? EndOfIsoWeek(points[0].GameDateTimeUtc)
            : EndOfMonth(points[0].GameDateTimeUtc);
        var lastPointDate = points[^1].GameDateTimeUtc;
        var sampled = new List<EloChartPoint>();
        var cursor = firstBoundary;
        var latestPointIndex = -1;
        EloChartPoint? latestPoint = null;

        while (cursor <= lastPointDate)
        {
            while (latestPointIndex + 1 < points.Count && points[latestPointIndex + 1].GameDateTimeUtc <= cursor)
            {
                latestPointIndex += 1;
                latestPoint = points[latestPointIndex];
            }

            if (latestPoint is not null)
            {
                sampled.Add(latestPoint with { GameDateTimeUtc = cursor });
            }

            cursor = mode == EloChartSamplingMode.Weekly
                ? cursor.AddDays(7)
                : EndOfMonth(cursor.AddTicks(1));
        }

        if (sampled.Count == 0 || sampled[^1].GameDateTimeUtc < lastPointDate)
        {
            sampled.Add(points[^1]);
        }

        return sampled;
    }

    private static DateTime EndOfIsoWeek(DateTime value)
    {
        var utcDate = DateTime.SpecifyKind(value.Date, DateTimeKind.Utc);
        var daysUntilSunday = ((int)DayOfWeek.Sunday - (int)utcDate.DayOfWeek + 7) % 7;
        return utcDate.AddDays(daysUntilSunday + 1).AddTicks(-1);
    }

    private static DateTime EndOfMonth(DateTime value)
    {
        var utcDate = DateTime.SpecifyKind(value.Date, DateTimeKind.Utc);
        return new DateTime(utcDate.Year, utcDate.Month, 1, 0, 0, 0, DateTimeKind.Utc)
            .AddMonths(1)
            .AddTicks(-1);
    }

    private static string SamplingLabel(EloChartSamplingMode mode)
        => mode switch
        {
            EloChartSamplingMode.Weekly => "Weekly snapshots",
            EloChartSamplingMode.Monthly => "Monthly snapshots",
            _ => "Game-level snapshots"
        };

    private static string FormatDate(DateTime value)
        => value.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture);

    private string FormatCategoryAxis(object value)
    {
        if (samplingMode == EloChartSamplingMode.GameByGame &&
            value is IConvertible convertible &&
            activeDates.Count > 0)
        {
            try
            {
                var index = (int)Math.Round(convertible.ToDouble(CultureInfo.InvariantCulture));
                if (index < 0 || index >= activeDates.Count)
                {
                    return string.Empty;
                }

                return activeDates[index].ToLocalTime().ToString("MMM yyyy", CultureInfo.CurrentCulture);
            }
            catch (FormatException)
            {
            }
            catch (InvalidCastException)
            {
            }
            catch (OverflowException)
            {
            }
        }

        return value is DateTime date
            ? date.ToLocalTime().ToString("MMM yyyy", CultureInfo.CurrentCulture)
            : value?.ToString() ?? string.Empty;
    }

    private static string FormatMovement(decimal value)
        => value switch
        {
            > 0 => $"+{value:0}",
            < 0 => value.ToString("0"),
            _ => "0"
        };

    private static string FormatEloAxis(object value)
        => value is IFormattable formattable
            ? formattable.ToString("0", CultureInfo.CurrentCulture)
            : value?.ToString() ?? string.Empty;

    public async ValueTask DisposeAsync()
    {
        if (chartInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("basketEloDygraph.dispose", chartHost);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        dotNetReference?.Dispose();
    }
}
