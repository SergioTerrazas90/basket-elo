@using System.Security.Claims

<details class="account-selector">
    <summary aria-label='@T["AccountMenu"]' title='@T["AccountMenu"]'>
        <span class="account-avatar" aria-hidden="true">@Initials</span>
        <span class="account-summary-copy">
            <strong>@DisplayName</strong>
            <small>@T["Account"]</small>
        </span>
        <svg class="account-chevron" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
            <path d="m3 4.5 3 3 3-3"></path>
        </svg>
    </summary>
    <div class="account-menu">
        <div class="account-menu-heading">
            <span class="account-menu-avatar" aria-hidden="true">@Initials</span>
            <span>
                <strong>@DisplayName</strong>
                <small>@Email</small>
            </span>
        </div>
        <a class="account-option" href="profile">
            <span class="account-option-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <circle cx="12" cy="8" r="3.25"></circle>
                    <path d="M5.5 19.2c.8-3.05 3-4.7 6.5-4.7s5.7 1.65 6.5 4.7"></path>
                </svg>
            </span>
            <span class="account-option-copy">
                <strong>@T["Profile"]</strong>
                <small>@T["ProfileMenuDescription"]</small>
            </span>
        </a>
        <a class="account-option account-option-danger" href="auth/logout">
            <span class="account-option-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M10 5H6.8A1.8 1.8 0 0 0 5 6.8v10.4A1.8 1.8 0 0 0 6.8 19H10"></path>
                    <path d="M13.5 8.5 17 12l-3.5 3.5M17 12H9"></path>
                </svg>
            </span>
            <span class="account-option-copy">
                <strong>@T["SignOut"]</strong>
                <small>@T["SignOutDescription"]</small>
            </span>
        </a>
    </div>
</details>

@code {
    [Parameter]
    public ClaimsPrincipal User { get; set; } = new();

    private string DisplayNameValue
        => User.FindFirstValue(ClaimTypes.Name)
            ?? User.FindFirstValue(ClaimTypes.Email)
            ?? T["SignedIn"];

    private string Email
        => User.FindFirstValue(ClaimTypes.Email) ?? string.Empty;

    private string Initials
    {
        get
        {
            var parts = DisplayNameValue
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            return parts.Length switch
            {
                0 => "BE",
                1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
                _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            };
        }
    }

    private string DisplayName => DisplayNameValue;
}
