@page "/how-it-works"

<SeoHead Title='@T["MethodSeoTitle"]'
         Description='@T["MethodSeoDescription"]'
         CanonicalPath="/how-it-works" />

<div class="info-page method-page">
    <header class="info-hero be-reveal" style="--reveal-order: 0">
        <div class="info-hero-copy">
            <p class="info-kicker">@T["Method"]</p>
            <h1>@T["MethodHeroTitle"]</h1>
            <p class="info-lede">@T["MethodHeroText"]</p>
        </div>
        <dl class="info-facts" aria-label='@T["MethodAtGlance"]'>
            <div><dt>@T["StartingRating"]</dt><dd>1,500</dd></div>
            <div><dt>@T["DefaultModel"]</dt><dd>@T["AdjustedElo"]</dd></div>
            <div><dt>@T["Updated"]</dt><dd>@T["AfterEveryResult"]</dd></div>
        </dl>
    </header>

    <section id="short-version" class="info-section be-reveal" style="--reveal-order: 1" aria-labelledby="short-version-heading">
        <div class="info-section-label"><span>01</span><span>@T["ShortVersion"]</span></div>
        <div class="info-section-body">
            <h2 id="short-version-heading">@T["ChessIdeaTitle"]</h2>
            <p class="info-section-intro">@T["ChessIdeaIntro"]</p>
            <ol class="method-steps">
                <li><span>1</span><div><h3>@T["Expect"]</h3><p>@T["ExpectDescription"]</p></div></li>
                <li><span>2</span><div><h3>@T["Score"]</h3><p>@T["ScoreDescription"]</p></div></li>
                <li><span>3</span><div><h3>@T["Update"]</h3><p>@T["UpdateDescription"]</p></div></li>
            </ol>
            <div class="method-core-formula" aria-label='@T["CoreEloFormula"]'>
                <span>@T["ClassicElo"]</span>
                <code>@T["EloFormula"]</code>
            </div>
        </div>
    </section>

    <section id="models" class="info-section be-reveal" style="--reveal-order: 2" aria-labelledby="models-heading">
        <div class="info-section-label"><span>02</span><span>@T["TwoViews"]</span></div>
        <div class="info-section-body">
            <h2 id="models-heading">@T["ModelsComparisonTitle"]</h2>
            <div class="model-comparison">
                <article>
                    <div class="model-heading"><span>@T["Baseline"]</span><h3>@T["BasicElo"]</h3></div>
                    <p>@T["BasicEloDescription"]</p>
                    <ul><li>@T["WinOrLoss"]</li><li>@T["OpponentStrength"]</li><li>@T["NoExtraAdjustments"]</li></ul>
                </article>
                <article class="is-default">
                    <div class="model-heading"><span>@T["UsedByDefault"]</span><h3>@T["AdjustedElo"]</h3></div>
                    <p>@T["AdjustedEloDescription"]</p>
                    <ul><li>@T["EverythingInBasic"]</li><li>@T["ScoreMargin"]</li><li>@T["CompetitionWeight"]</li></ul>
                </article>
            </div>
            <p class="method-plain-note"><strong>@T["DefaultModelMeaning"]</strong> @T["ModelHistoriesSeparate"]</p>
        </div>
    </section>

    <section id="example" class="info-section be-reveal" style="--reveal-order: 3" aria-labelledby="example-heading">
        <div class="info-section-label"><span>03</span><span>@T["WorkedExample"]</span></div>
        <div class="info-section-body">
            <h2 id="example-heading">@T["WorkedExampleTitle"]</h2>
            <p class="info-section-intro">@T["WorkedExampleIntro"]</p>
            <div class="formula-example">
                <article><span>@T["EffectiveGap"]</span><code>1,600 + 70 − 1,500 = 170</code><p>@T["EffectiveGapDescription"]</p></article>
                <article><span>@T["WinExpectation"]</span><code>1 ÷ (1 + 10^(-170 ÷ 400)) = 72.7%</code><p>@T["WinExpectationDescription"]</p></article>
                <article><span>@T["BaseUpdate"]</span><code>20 × (1 − 0.72683) = +5.46</code><p>@T["BaseUpdateDescription"]</p></article>
            </div>
            <div class="method-constants" aria-label='@T["CurrentModelConstants"]'>
                <span><strong>20</strong> @T["KFactor"]</span>
                <span><strong>70</strong> @T["HomeAdvantageLower"]</span>
                <span><strong>400</strong> @T["ProbabilityScale"]</span>
                <span><strong>28</strong> @T["RatingPointsPerExpectedPoint"]</span>
            </div>
            <a class="info-text-link" href="model-lab">@T["TestModelLab"] <span aria-hidden="true">→</span></a>
        </div>
    </section>

    <section id="limits" class="info-section info-section-last be-reveal" style="--reveal-order: 4" aria-labelledby="limits-heading">
        <div class="info-section-label"><span>04</span><span>@T["Limits"]</span></div>
        <div class="info-section-body">
            <h2 id="limits-heading">@T["LimitsTitle"]</h2>
            <div class="method-limits">
                <p>@T["LimitsText1"]</p>
                <p>@T["LimitsText2"]</p>
            </div>
        </div>
    </section>
</div>
