@page "/model-lab/new"
@page "/model-lab/models/{ModelId:guid}/run"
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using BasketElo.Domain.Elo
@using BasketElo.Domain.Entities
@using BasketElo.Infrastructure.Identity
@using BasketElo.Web.Auth
@using BasketElo.Web.Components.ModelLab
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IOptions<AuthOptions> AuthOptions

<SeoHead Title='@(IsExistingModelRoute ? "Run model | BasketElo" : "Create model | BasketElo")'
         Description="Build and backtest a basketball ELO model against historical results. Tune home advantage, K-factor, score-margin adjustment, and competition weight."
         CanonicalPath='@(IsExistingModelRoute ? $"/model-lab/models/{ModelId}/run" : "/model-lab/new")'
         SchemaType="WebApplication" />

<div class="model-lab-page">
    <section class="lab-hero">
        <div>
            <p class="eyebrow">@T["ModelLab"]</p>
            <h1>@(IsExistingModelRoute ? "Run model" : "Create a model")</h1>
            <p class="intro">@(IsExistingModelRoute ? "Choose the competitions and evaluation period for this saved model." : "Define a rating model, save it for reuse, and run it against historical results.")</p>
        </div>

        @if (result is not null)
        {
            <div class="score-card model-verdict-card @BaselineVerdictClass">
                <div class="verdict-card-heading">
                    <span>Model vs standard</span>
                    <strong>@BaselineVerdictLabel</strong>
                </div>
                <p class="verdict-summary">@BaselineVerdictSummary</p>
                <div class="verdict-metrics">
                    <div class="verdict-metric @BaselineMetricClass(result.Summary.WinnerAccuracy, result.BaselineSummary.WinnerAccuracy, true)">
                        <span>Winner accuracy</span>
                        <strong>@result.Summary.WinnerAccuracy.ToString("0.0")%</strong>
                        <small>Standard @result.BaselineSummary.WinnerAccuracy.ToString("0.0")% · @FormatAccuracyDelta()</small>
                    </div>
                    <div class="verdict-metric @BaselineMetricClass(result.Summary.BrierScore, result.BaselineSummary.BrierScore, false)">
                        <span>Brier score</span>
                        <strong>@result.Summary.BrierScore.ToString("0.000")</strong>
                        <small>Standard @result.BaselineSummary.BrierScore.ToString("0.000") · @FormatLowerIsBetterDelta(result.Summary.BrierScore, result.BaselineSummary.BrierScore)</small>
                    </div>
                    <div class="verdict-metric @BaselineMetricClass(result.Summary.AverageMarginError, result.BaselineSummary.AverageMarginError, false)">
                        <span>Margin error</span>
                        <strong>@result.Summary.AverageMarginError.ToString("0.0")</strong>
                        <small>Standard @result.BaselineSummary.AverageMarginError.ToString("0.0") · @FormatLowerIsBetterDelta(result.Summary.AverageMarginError, result.BaselineSummary.AverageMarginError)</small>
                    </div>
                </div>
                <small class="verdict-footnote">Both models were tested on the same @result.Summary.ScoredGames games.</small>
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (isLoadingOptions)
    {
        <section class="loading-panel">@T["LoadingModelLab"]</section>
    }
    else if (options is not null)
    {
        <section class="lab-workbench">
            <div class="model-panel">
                <div class="section-head">
                    <div>
                        <p class="step-label">@T["Step"] 1</p>
                        <h2>@(IsExistingModelRoute ? $"{loadedModel?.Name ?? "Model"} · v{loadedModel?.CurrentVersion.VersionNumber}" : "New model")</h2>
                        <p>@(IsExistingModelRoute ? "The model is fixed for this run. Choose the data and evaluation period below." : "Define the rating rules you want to test, then save the model or run it immediately.")</p>
                    </div>
                    @if (CanSaveModels)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="model-lab">My models</a>
                    }
                </div>

                <div class="control-grid">
                    <div class="filter-field wide">
                        <div class="label-with-info">
                            <label for="modelName">@T["Name"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("modelName")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Model name context"
                                    @onclick='() => ToggleInfoPanel("modelName")'>
                                i
                            </button>
                        </div>
                        <input id="modelName" class="form-control" @bind="modelName" maxlength="80" />
                    </div>

                    <div class="filter-field wide">
                        <label for="modelDescription">@T["Description"]</label>
                        <textarea id="modelDescription" class="form-control" rows="2" @bind="modelDescription" maxlength="1000"></textarea>
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="baseRating">@T["BaseRating"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("baseRating")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Base rating context"
                                    @onclick='() => ToggleInfoPanel("baseRating")'>
                                i
                            </button>
                        </div>
                        <input id="baseRating" class="form-control" type="number" min="500" max="2500" step="10" @bind="baseRating" />
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="kFactor">@T["KFactor"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("kFactor")'
                                    aria-controls="modelLabInfoDialog"
                                    title="K factor context"
                                    @onclick='() => ToggleInfoPanel("kFactor")'>
                                i
                            </button>
                        </div>
                        <input id="kFactor" class="form-control" type="number" min="1" max="100" step="1" @bind="kFactor" />
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="homeAdvantage">@T["HomeAdvantage"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("homeAdvantage")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Home advantage context"
                                    @onclick='() => ToggleInfoPanel("homeAdvantage")'>
                                i
                            </button>
                        </div>
                        <input id="homeAdvantage" class="form-control" type="number" min="-200" max="300" step="5" @bind="homeAdvantageElo" />
                    </div>

                    <section class="advanced-settings wide" aria-labelledby="model-calculations-title">
                        <div class="advanced-settings-heading">
                            <h3 id="model-calculations-title">Calibration and margin</h3>
                            <p>Probability calibration, competition weighting, and margin adjustments.</p>
                        </div>
                        <div class="control-grid advanced-settings-grid">
                    <div class="filter-field wide">
                        <div class="label-with-info">
                            <label for="probabilityScale">@T["ProbabilityScale"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("probabilityScale")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Probability scale context"
                                    @onclick='() => ToggleInfoPanel("probabilityScale")'>
                                i
                            </button>
                        </div>
                        <input id="probabilityScale" class="form-control" type="number" min="200" max="800" step="25" @bind="probabilityScale" />
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="competitionWeight">@T["CompetitionWeight"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("competitionWeight")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Competition weight context"
                                    @onclick='() => ToggleInfoPanel("competitionWeight")'>
                                i
                            </button>
                        </div>
                        <input id="competitionWeight" class="form-control" type="number" min="0.1" max="3" step="0.05" @bind="competitionWeight" />
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="usesMargin">@T["MarginAdjustment"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("usesMargin")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Margin adjustment context"
                                    @onclick='() => ToggleInfoPanel("usesMargin")'>
                                i
                            </button>
                        </div>
                        <label class="toggle-field" for="usesMargin">
                            <input id="usesMargin" type="checkbox" @bind="usesMarginAdjustment" />
                            <span>@(usesMarginAdjustment ? T["On"] : T["Off"])</span>
                        </label>
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="pointScale">@T["PointMarginScale"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("pointScale")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Point margin scale context"
                                    @onclick='() => ToggleInfoPanel("pointScale")'>
                                i
                            </button>
                        </div>
                        <input id="pointScale" class="form-control" type="number" min="5" max="100" step="1" @bind="pointsPerEloMargin" disabled="@(!usesMarginAdjustment)" />
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="marginDampenerFactor">@T["DampenerFactor"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("marginDampenerFactor")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Dampener factor context"
                                    @onclick='() => ToggleInfoPanel("marginDampenerFactor")'>
                                i
                            </button>
                        </div>
                        <input id="marginDampenerFactor" class="form-control" type="number" min="1" max="20" step="0.25" @bind="marginDampenerFactor" disabled="@(!usesMarginAdjustment)" />
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="maxMarginMultiplier">@T["MarginCap"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("maxMarginMultiplier")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Margin cap context"
                                    @onclick='() => ToggleInfoPanel("maxMarginMultiplier")'>
                                i
                            </button>
                        </div>
                        <input id="maxMarginMultiplier" class="form-control" type="number" min="1" max="3" step="0.05" @bind="maxMarginMultiplier" disabled="@(!usesMarginAdjustment)" />
                    </div>
                        </div>
                    </section>
                </div>

                <div class="saved-model-panel">
                    @if (CanSaveModels)
                    {
                        <div class="model-context-panel">
                            <div>
                                <span class="@EditorStateClass">@EditorStateLabel</span>
                                <strong>@EditorStateTitle</strong>
                                <small>@EditorStateDetail</small>
                            </div>
                            @if (IsExistingModelRoute && loadedModel is not null)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@($"model-lab/models/{loadedModel.Id}")">View model</a>
                            }
                        </div>

                        <div class="editor-actions">
                            @if (!IsExistingModelRoute)
                            {
                                <button type="button" class="btn btn-primary" @onclick="SaveNewModelAsync" disabled="@isSavingModel">@T["SaveModel"]</button>
                            }
                            else if (IsLoadedSelectedModel)
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="SaveNewModelAsync" disabled="@isSavingModel">@T["DuplicateModel"]</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="UpdateSelectedModelAsync" disabled="@(!CanUpdateSelectedModel)">@SaveModelChangesLabel</button>
                                @if (IsSelectedModelDirty)
                                {
                                    <button type="button" class="btn btn-outline-secondary" @onclick="DiscardSelectedModelChanges" disabled="@isSavingModel">Discard changes</button>
                                }
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(modelStatusMessage))
                    {
                        <p class="model-status">@modelStatusMessage</p>
                    }
                    else if (!CanSaveModels)
                    {
                        <p class="model-status">You can preview a model here, but sign in to save it and keep its run results.</p>
                    }
                </div>
            </div>

            <div class="model-panel">
                <div class="section-head">
                    <div>
                        <p class="step-label">@T["Step"] 2</p>
                        <h2>@T["Backtest"]</h2>
                        <p>@T["BacktestDescription"]</p>
                    </div>
                    @if (CanSaveModels)
                    {
                        <span class="run-quota">@StoredRunQuotaText</span>
                    }
                </div>

                <div class="control-grid">
                    <div class="filter-field wide">
                        <div class="label-with-info">
                            <label for="eloPool">@T["EloPool"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("eloPool")'
                                    aria-controls="modelLabInfoDialog"
                                    title="ELO pool context"
                                    @onclick='() => ToggleInfoPanel("eloPool")'>
                                i
                            </button>
                        </div>
                        <select id="eloPool"
                                class="form-select"
                                value="@selectedPoolKey"
                                @onchange="OnPoolChanged"
                                disabled="@(AvailablePools.Count <= 1)">
                            @foreach (var pool in AvailablePools)
                            {
                                <option value="@pool.Key">@pool.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="filter-field wide">
                        <div class="label-with-info">
                            <label for="scopeType">@T["Scope"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("scopeType")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Scope context"
                                    @onclick='() => ToggleInfoPanel("scopeType")'>
                                i
                            </button>
                        </div>
                        <select id="scopeType" class="form-select" value="@scopeType" @onchange="OnScopeTypeChanged">
                            <option value="@ModelLabScopeTypes.SingleCompetition">@T["SingleCompetition"]</option>
                            @if (CanUseMultiCompetitionScopes)
                            {
                                <option value="@ModelLabScopeTypes.SelectedCompetitions">@T["SelectedCompetitions"]</option>
                                <option value="@ModelLabScopeTypes.AllCompetitions">@T["AllCompetitions"]</option>
                            }
                        </select>
                    </div>

                    <div class="filter-field wide">
                        <div class="label-with-info">
                            <label for="leagueName">@CompetitionSelectorLabel</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("leagueName")'
                                    aria-controls="modelLabInfoDialog"
                                    title="League context"
                                    @onclick='() => ToggleInfoPanel("leagueName")'>
                                i
                            </button>
                        </div>
                        @if (scopeType == ModelLabScopeTypes.SelectedCompetitions)
                        {
                            <select id="leagueName" class="form-select competition-multi-select" multiple size="10" @onchange="OnSelectedCompetitionsChanged">
                                @foreach (var competition in AvailableCompetitions)
                                {
                                    <option value="@competition.Id" selected="@selectedCompetitionIds.Contains(competition.Id)">@competition.DisplayName</option>
                                }
                            </select>
                            <p class="field-note">@SelectedCompetitionNote</p>
                        }
                        else if (scopeType == ModelLabScopeTypes.AllCompetitions)
                        {
                            <div class="scope-summary">@AvailableCompetitions.Count competitions selected in @SelectedPoolDisplayName</div>
                        }
                        else
                        {
                            <select id="leagueName" class="form-select" @bind="leagueName">
                                @foreach (var league in AvailableLeagues)
                                {
                                    <option value="@league">@league</option>
                                }
                            </select>
                        }
                        <p class="field-note">@LeagueAccessNote</p>
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="initFromSeason">@T["InitFromSeason"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("initSeason")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Initialization start context"
                                    @onclick='() => ToggleInfoPanel("initSeason")'>
                                i
                            </button>
                        </div>
                        <select id="initFromSeason" class="form-select" @bind="initializationFromSeason" @bind:after="ApplySelectedSeasonsToDates">
                            @foreach (var season in AvailableSeasons)
                            {
                                <option value="@season.Label">@season.Label</option>
                            }
                        </select>
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="initToSeason">@T["InitToSeason"]</label>
                        </div>
                        <select id="initToSeason" class="form-select" @bind="initializationToSeason" @bind:after="ApplySelectedSeasonsToDates">
                            @foreach (var season in AvailableSeasons)
                            {
                                <option value="@season.Label">@season.Label</option>
                            }
                        </select>
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="scoredFromSeason">@T["ScoreFromSeason"]</label>
                            <button type="button"
                                    class="info-button"
                                    aria-expanded='@IsInfoPanelVisible("scoredSeason")'
                                    aria-controls="modelLabInfoDialog"
                                    title="Scored start context"
                                    @onclick='() => ToggleInfoPanel("scoredSeason")'>
                                i
                            </button>
                        </div>
                        <select id="scoredFromSeason" class="form-select" @bind="scoredFromSeason" @bind:after="ApplySelectedSeasonsToDates">
                            @foreach (var season in AvailableSeasons)
                            {
                                <option value="@season.Label">@season.Label</option>
                            }
                        </select>
                    </div>

                    <div class="filter-field">
                        <div class="label-with-info">
                            <label for="scoredToSeason">@T["ScoreToSeason"]</label>
                        </div>
                        <select id="scoredToSeason" class="form-select" @bind="scoredToSeason" @bind:after="ApplySelectedSeasonsToDates">
                            @foreach (var season in AvailableSeasons)
                            {
                                <option value="@season.Label">@season.Label</option>
                            }
                        </select>
                    </div>

                    <div class="season-window-summary">
                        <div>
                            <span>@T["InitializationWindow"]</span>
                            <strong>@InitializationSeasonSummary</strong>
                            <small>@FormatWindow(initializationFrom, initializationTo)</small>
                        </div>
                        <div>
                            <span>@T["ScoredWindow"]</span>
                            <strong>@ScoredSeasonSummary</strong>
                            <small>@FormatWindow(scoredFrom, scoredTo)</small>
                        </div>
                    </div>

                    <div class="run-actions">
                        @if (CanSaveModels)
                        {
                            <button type="button" class="btn btn-primary" @onclick="CreateStoredRunAsync" disabled="@(!CanCreateStoredRun)">
                                @(isSavingRun ? T["Queueing"] : T["RunBacktest"])
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary" @onclick="RunBacktestAsync" disabled="@isRunning">
                                @(isRunning ? T["Running"] : T["RunPreview"])
                            </button>
                        }
                        <button type="button" class="btn btn-outline-secondary" @onclick="ResetDefaults" disabled="@isRunning">@T["Reset"]</button>
                    </div>
                    @if (CanSaveModels)
                    {
                        <p class="field-note save-run-note">
                            Run model saves any parameter changes as a new version, then opens a results page that updates automatically.
                            @if (!string.IsNullOrWhiteSpace(SaveRunUnavailableReason))
                            {
                                <br /><span>@SaveRunUnavailableReason</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="field-note save-run-note">Sign in to save models and run asynchronous backtests with a results page. Preview runs are not persisted.</p>
                    }
                </div>
            </div>
        </section>

        @if (result is not null)
        {
            <section class="inline-results-heading">
                <p class="step-label">@T["Step"] 3</p>
                <h2>@T["PreviewResults"]</h2>
                <p>@T["PreviewResultsDescription"]</p>
            </section>

            <section class="result-summary">
                <div>
                    <span>@T["ScoredGames"]</span>
                    <strong>@result.Summary.ScoredGames</strong>
                    <small>@(result.RunId.HasValue ? $"Saved run {result.RunId.Value.ToString()[..8]}" : $"{result.ScoredWindow.Games} games in window")</small>
                </div>
                <div>
                    <span>@T["WinnerAccuracy"]</span>
                    <strong>@result.Summary.WinnerAccuracy.ToString("0.0")%</strong>
                    <small>Baseline @result.BaselineSummary.WinnerAccuracy.ToString("0.0")%</small>
                </div>
                <div>
                    <span>@T["BrierScore"]</span>
                    <strong>@result.Summary.BrierScore.ToString("0.000")</strong>
                    <small>@T["LowerIsBetter"]</small>
                </div>
                <div>
                    <span>@T["AverageMarginError"]</span>
                    <strong>@result.Summary.AverageMarginError.ToString("0.0")</strong>
                    <small>Baseline @result.BaselineSummary.AverageMarginError.ToString("0.0")</small>
                </div>
            </section>

            <section class="result-grid">
                <div class="result-panel">
                    <div class="section-head compact">
                        <div>
                            <h2>@T["FinalRatings"]</h2>
                            <p>@result.LeagueName &middot; @result.ModelName</p>
                        </div>
                        @if (HasBaselineRatings(result.Ratings))
                        {
                            <label class="comparison-toggle">
                                <input type="checkbox" @bind="showBaselineRatings" />
                                <span>Compare with standard</span>
                            </label>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle compact-table">
                            <thead>
                                <tr>
                                    <th>@T["Rank"]</th>
                                    <th>@T["Team"]</th>
                                    <th class="numeric">ELO</th>
                                    @if (showBaselineRatings)
                                    {
                                        <th class="numeric">Standard</th>
                                    }
                                    <th class="numeric">@T["Games"]</th>
                                    <th class="numeric">@T["Recent"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in result.Ratings.Take(25))
                                {
                                    <tr>
                                        <td class="rank-cell">#@row.Rank</td>
                                        <td>@row.TeamName</td>
                                        <td class="numeric rating">@row.Elo.ToString("0")</td>
                                        @if (showBaselineRatings)
                                        {
                                            <td class="numeric baseline-comparison">
                                                <strong>#@(row.BaselineRank?.ToString() ?? "—") · @(row.BaselineElo?.ToString("0") ?? "—")</strong>
                                                <small class="@BaselineComparisonClass(row)">@FormatEloDelta(row) · @FormatRankDelta(row)</small>
                                            </td>
                                        }
                                        <td class="numeric">@row.GamesPlayed</td>
                                        <td class="numeric"><span class="@MovementClass(row.RecentMovement)">@FormatMovement(row.RecentMovement)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="result-panel">
                    <div class="section-head compact">
                        <div>
                            <h2>@T["PerformanceOverTime"]</h2>
                            <p>@T["MonthlyScoringDescription"]</p>
                        </div>
                    </div>
                    <div class="period-list">
                        @foreach (var period in result.Periods)
                        {
                            <div>
                                <span>@period.Label</span>
                                <strong>@period.WinnerAccuracy.ToString("0.0")%</strong>
                                <small>@period.Games games &middot; @period.AverageMarginError.ToString("0.0") margin error</small>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <section class="result-panel">
                <div class="section-head compact">
                    <div>
                        <h2>@T["BiggestMisses"]</h2>
                        <p>@T["BiggestMissesDescription"]</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle compact-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Matchup</th>
                                <th>Score</th>
                                <th class="numeric">Home win prob.</th>
                                <th class="numeric">Expected margin</th>
                                <th class="numeric">Actual</th>
                                <th class="numeric">Error</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in result.BiggestMisses)
                            {
                                <tr>
                                    <td>@row.GameDateTimeUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                    <td>@row.HomeTeam vs @row.AwayTeam</td>
                                    <td>@row.HomeScore-@row.AwayScore</td>
                                    <td class="numeric">@row.PredictedHomeWinProbability.ToString("P0")</td>
                                    <td class="numeric">@FormatSigned(row.PredictedHomeMargin)</td>
                                    <td class="numeric">@FormatSigned(row.ActualHomeMargin)</td>
                                    <td class="numeric rating">@row.MarginError.ToString("0.0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }

    <ModelLabInfoDialog InfoKey="@activeInfoPanel"
                        IsSingleCompetition="@(scopeType == ModelLabScopeTypes.SingleCompetition)"
                        OnClose="CloseInfoPanel" />
</div>

@code {
    [Parameter]
    public Guid ModelId { get; set; }

    [SupplyParameterFromQuery(Name = "modelId")]
    public Guid? RequestedModelId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private ModelLabOptionsResponse? options;
    private ModelLabEntitlementResponse? entitlement;
    private ModelLabBacktestResponse? result;
    private List<ModelLabModelSummaryResponse> savedModels = [];
    private List<ModelLabRunSummaryResponse> savedRuns = [];
    private ModelLabRunQuotaResponse? runQuota;
    private bool showBaselineRatings;
    private bool isLoadingOptions = true;
    private bool isLoadingModels;
    private bool isRunning;
    private bool isSavingModel;
    private bool isSavingRun;
    private bool isRealSignedIn;
    private string? errorMessage;
    private string? modelStatusMessage;
    private string modelName = "My model";
    private string? modelDescription;
    private string selectedModelIdText = string.Empty;
    private ModelLabModelDetailResponse? loadedModel;
    private string? loadedModelSignature;
    private string? loadedModelVersionSignature;
    private string? lastSavedRunSignature;
    private string scopeType = ModelLabScopeTypes.SingleCompetition;
    private string selectedPoolKey = EloPoolKeys.Default;
    private string? leagueName;
    private HashSet<Guid> selectedCompetitionIds = [];
    private decimal baseRating;
    private int kFactor;
    private decimal homeAdvantageElo;
    private decimal probabilityScale;
    private bool usesMarginAdjustment;
    private decimal pointsPerEloMargin;
    private decimal competitionWeight;
    private decimal marginDampenerFactor;
    private decimal maxMarginMultiplier;
    private string? activeInfoPanel;
    private string? initializationFromSeason;
    private string? initializationToSeason;
    private string? scoredFromSeason;
    private string? scoredToSeason;
    private DateTime initializationFrom;
    private DateTime initializationTo;
    private DateTime scoredFrom;
    private DateTime scoredTo;

    private bool IsExistingModelRoute => ModelId != Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthenticationStateTask is not null)
            {
                var authenticationState = await AuthenticationStateTask;
                isRealSignedIn = authenticationState.User.Identity?.IsAuthenticated == true &&
                    string.Equals(
                        authenticationState.User.FindFirstValue(AuthClaimTypes.AuthMode),
                        "google",
                        StringComparison.OrdinalIgnoreCase);
            }

            entitlement = await Http.GetFromJsonAsync<ModelLabEntitlementResponse>("api/model-lab/entitlement");
            options = await Http.GetFromJsonAsync<ModelLabOptionsResponse>("api/model-lab/options");
            if (options is not null)
            {
                ApplyDefaults(options);
            }

            if (CanSaveModels)
            {
                await LoadSavedModelsAsync();
                await LoadSavedRunsAsync();
                var requestedModelId = IsExistingModelRoute ? ModelId : RequestedModelId;
                if (requestedModelId.HasValue && savedModels.Any(model => model.Id == requestedModelId.Value))
                {
                    selectedModelIdText = requestedModelId.Value.ToString();
                    await LoadSelectedModelAsync();
                }
            }
            else
            {
                modelStatusMessage = "Sign in to save models.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load Model Lab options: {ex.Message}";
        }
        finally
        {
            isLoadingOptions = false;
        }
    }

    private string SavedModelPlaceholder
        => isLoadingModels ? "Loading saved models..." : "No saved model selected";

    private bool CanSaveModels => isRealSignedIn && entitlement?.CanSaveModels == true;

    private bool CanUseSelectedModel
        => CanSaveModels && !isSavingModel && Guid.TryParse(selectedModelIdText, out _);

    private bool CanUpdateSelectedModel
        => CanUseSelectedModel && IsSelectedModelDirty;

    private string SaveNewModelLabel
        => IsLoadedSelectedModel ? T["DuplicateModel"] : T["SaveModel"];

    private string SaveModelChangesLabel
        => HasParameterChanges && loadedModel is not null
            ? T["SaveAsVersion", loadedModel.CurrentVersion.VersionNumber + 1]
            : T["SaveChanges"];

    private bool HasSelectedModel
        => Guid.TryParse(selectedModelIdText, out _);

    private bool IsLoadedSelectedModel
        => loadedModel is not null &&
            Guid.TryParse(selectedModelIdText, out var modelId) &&
            loadedModel.Id == modelId;

    private bool IsSelectedModelDirty
        => IsLoadedSelectedModel &&
            !string.Equals(loadedModelSignature, BuildCurrentModelSignature(), StringComparison.Ordinal);

    private bool HasParameterChanges
        => IsLoadedSelectedModel &&
            !string.Equals(loadedModelVersionSignature, BuildCurrentVersionSignature(), StringComparison.Ordinal);

    private string EditorStateLabel
        => IsLoadedSelectedModel
            ? IsSelectedModelDirty
                ? "Unsaved"
                : "Saved"
            : HasSelectedModel
                ? "Selected"
                : "Draft";

    private string EditorStateClass
        => IsLoadedSelectedModel
            ? IsSelectedModelDirty
                ? "state-pill state-unsaved"
                : "state-pill state-saved"
            : HasSelectedModel
                ? "state-pill state-selected"
                : "state-pill state-draft";

    private string EditorStateTitle
        => IsLoadedSelectedModel
            ? $"{loadedModel!.Name} v{loadedModel.CurrentVersion.VersionNumber}"
            : HasSelectedModel
                ? "Saved model selected"
                : "Unsaved model draft";

    private string EditorStateDetail
        => IsLoadedSelectedModel
            ? IsSelectedModelDirty
                ? HasParameterChanges
                    ? $"Save as immutable version {loadedModel!.CurrentVersion.VersionNumber + 1} or discard changes before running. Existing run results stay attached to their original version."
                    : "Save or discard these model details before running. Its parameter version will stay the same."
                : "Editor matches the saved model."
            : HasSelectedModel
                ? "Choose the model again to load it."
                : "Save this draft to reuse it, or run it immediately.";

    private bool CanCreateStoredRun
        => CanSaveModels &&
            !isRunning &&
            !isSavingRun &&
            !isSavingModel &&
            !HasActiveRun &&
            !IsKnownStoredRunLimitReached &&
            !IsSelectedModelDirty &&
            !string.Equals(lastSavedRunSignature, BuildCurrentRunSignature(), StringComparison.Ordinal);

    private bool HasActiveRun => savedRuns.Any(run =>
        run.Status is ModelLabRunStatuses.Queued or ModelLabRunStatuses.Running);

    private bool IsKnownStoredRunLimitReached
        => runQuota?.IsLimitReached == true ||
            (runQuota is null && entitlement?.StoredRunLimit is > 0 && savedRuns.Count >= entitlement.StoredRunLimit.Value);

    private string StoredRunQuotaText
        => runQuota?.StoredRunLimit is int limit
            ? $"Saved runs: {runQuota.StoredRuns}/{limit}"
            : runQuota is not null
                ? $"Saved runs: {runQuota.StoredRuns}"
                : entitlement?.StoredRunLimit is int entitlementLimit
                    ? $"Saved runs: 0/{entitlementLimit}"
                    : "Saved runs";

    private string StoredRunLimitMessage
        => entitlement?.IsPaid == true
            ? $"Stored run limit reached. Paid users can store up to {entitlement.StoredRunLimit ?? 100} runs."
            : $"Stored run limit reached. Free users can store up to {entitlement?.StoredRunLimit ?? 3} runs. Delete an old run or upgrade for up to 100 saved runs.";

    private string? SaveRunUnavailableReason
    {
        get
        {
            if (!CanSaveModels || isRunning || isSavingRun || isSavingModel)
            {
                return null;
            }

            if (IsKnownStoredRunLimitReached)
            {
                return StoredRunLimitMessage;
            }

            if (IsSelectedModelDirty)
            {
                return "Save or discard your model changes before running it.";
            }

            if (HasActiveRun)
            {
                return "Wait for the active Model Lab run to finish before queueing another.";
            }

            if (string.Equals(lastSavedRunSignature, BuildCurrentRunSignature(), StringComparison.Ordinal))
            {
                return "Change model parameters, seasons, or scope before saving another run.";
            }

            return null;
        }
    }

    private bool CanUseMultiCompetitionScopes
        => entitlement?.IsPaid == true && string.IsNullOrWhiteSpace(entitlement.RequiredLeagueName);

    private IReadOnlyCollection<ModelLabPoolOption> AvailablePools
    {
        get
        {
            if (options is null)
            {
                return [];
            }

            if (string.IsNullOrWhiteSpace(entitlement?.RequiredLeagueName))
            {
                return options.Pools;
            }

            var requiredCompetition = options.Competitions.FirstOrDefault(x =>
                string.Equals(x.DisplayName, entitlement.RequiredLeagueName, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.Name, entitlement.RequiredLeagueName, StringComparison.OrdinalIgnoreCase));
            return requiredCompetition is null
                ? options.Pools.Take(1).ToList()
                : options.Pools.Where(x => x.Key == requiredCompetition.EloPoolKey).ToList();
        }
    }

    private string SelectedPoolDisplayName
        => options?.Pools.FirstOrDefault(x => x.Key == selectedPoolKey)?.DisplayName
            ?? EloPoolKeys.DisplayName(selectedPoolKey);

    private IReadOnlyCollection<ModelLabCompetitionOption> AvailableCompetitions
    {
        get
        {
            if (options is null)
            {
                return [];
            }

            if (string.IsNullOrWhiteSpace(entitlement?.RequiredLeagueName))
            {
                return options.Competitions
                    .Where(x => string.Equals(x.EloPoolKey, selectedPoolKey, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            var requiredLeague = entitlement.RequiredLeagueName;
            return options.Competitions
                .Where(x =>
                    string.Equals(x.DisplayName, requiredLeague, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(x.Name, requiredLeague, StringComparison.OrdinalIgnoreCase))
                .DefaultIfEmpty(new ModelLabCompetitionOption(
                    Guid.Empty,
                    requiredLeague,
                    requiredLeague,
                    null,
                    selectedPoolKey))
                .ToList();
        }
    }

    private IReadOnlyCollection<string> AvailableLeagues
    {
        get
        {
            var competitions = AvailableCompetitions;
            return competitions.Count == 0
                ? []
                : competitions.Select(x => x.DisplayName).ToList();
        }
    }

    private IReadOnlyList<ModelLabSeasonOption> AvailableSeasons
        => options?.Seasons
            .OrderBy(x => x.FirstGameUtc)
            .ThenBy(x => x.Label)
            .ToList() ?? [];

    private string InitializationSeasonSummary
        => FormatSeasonRange(initializationFromSeason, initializationToSeason);

    private string ScoredSeasonSummary
        => FormatSeasonRange(scoredFromSeason, scoredToSeason);

    private string LeagueAccessNote
        => entitlement?.PlanKey switch
        {
            "anonymous" => $"Anonymous users can run Model Lab backtests for {entitlement.RequiredLeagueName ?? "ACB"} only. Sign in to save models.",
            "free" => $"Free users can run and save Model Lab work for {entitlement.RequiredLeagueName ?? "ACB"} only, with up to {entitlement.StoredRunLimit ?? 3} stored runs.",
            "paid" => $"Paid users can run single, selected, or all-competition backtests and store up to {entitlement.StoredRunLimit ?? 100} runs.",
            _ => string.IsNullOrWhiteSpace(entitlement?.RequiredLeagueName)
                ? "Paid users can run single, selected, or all-competition backtests across all available competitions."
                : $"Current plan users can run and save Model Lab work for {entitlement.RequiredLeagueName} only."
        };

    private string CompetitionSelectorLabel
        => scopeType switch
        {
            ModelLabScopeTypes.SelectedCompetitions => "Competitions",
            ModelLabScopeTypes.AllCompetitions => "Competitions",
            _ => "Competition"
        };

    private string SelectedCompetitionNote
        => selectedCompetitionIds.Count switch
        {
            0 => "Choose at least one competition.",
            1 => "1 competition selected.",
            _ => $"{selectedCompetitionIds.Count} competitions selected."
        };

    private string PlanLabel
        => entitlement?.PlanKey switch
        {
            "anonymous" => "Anonymous",
            "free" => "Free",
            "paid" => "Paid",
            _ => "Current plan"
        };

    private static string FormatSavedModelOption(ModelLabModelSummaryResponse model)
        => $"{model.Name} - v{model.CurrentVersion.VersionNumber}";

    private static string FormatWindow(DateTime fromUtc, DateTime toUtc)
        => fromUtc == default || toUtc == default
            ? "No games resolved"
            : $"{fromUtc:yyyy-MM-dd} to {toUtc:yyyy-MM-dd}";

    private string FormatSeasonRange(string? fromSeason, string? toSeason)
    {
        var seasons = AvailableSeasons;
        if (seasons.Count == 0)
        {
            return "No seasons available";
        }

        var fromIndex = FindSeasonIndex(fromSeason);
        var toIndex = FindSeasonIndex(toSeason);
        if (fromIndex < 0 || toIndex < 0)
        {
            return "Choose seasons";
        }

        var start = seasons[Math.Min(fromIndex, toIndex)].Label;
        var end = seasons[Math.Max(fromIndex, toIndex)].Label;
        return string.Equals(start, end, StringComparison.OrdinalIgnoreCase)
            ? start
            : $"{start} to {end}";
    }

    private void OnScopeTypeChanged(ChangeEventArgs args)
    {
        scopeType = args.Value?.ToString() ?? ModelLabScopeTypes.SingleCompetition;
        if (!CanUseMultiCompetitionScopes)
        {
            scopeType = ModelLabScopeTypes.SingleCompetition;
        }

        if (scopeType == ModelLabScopeTypes.SelectedCompetitions && selectedCompetitionIds.Count == 0)
        {
            var selected = FindCompetition(leagueName) ?? AvailableCompetitions.FirstOrDefault();
            if (selected is not null && selected.Id != Guid.Empty)
            {
                selectedCompetitionIds.Add(selected.Id);
            }
        }
    }

    private void OnPoolChanged(ChangeEventArgs args)
    {
        var requestedPool = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(requestedPool) ||
            !AvailablePools.Any(x => string.Equals(x.Key, requestedPool, StringComparison.Ordinal)))
        {
            return;
        }

        selectedPoolKey = requestedPool;
        selectedCompetitionIds = [];
        leagueName = AvailableLeagues.FirstOrDefault();
        if (scopeType == ModelLabScopeTypes.SelectedCompetitions)
        {
            selectedCompetitionIds = AvailableCompetitions
                .Take(2)
                .Select(x => x.Id)
                .Where(x => x != Guid.Empty)
                .ToHashSet();
        }

        lastSavedRunSignature = null;
        result = null;
    }

    private void OnSelectedCompetitionsChanged(ChangeEventArgs args)
    {
        selectedCompetitionIds = args.Value switch
        {
            string[] values => values
                .Select(x => Guid.TryParse(x, out var id) ? id : Guid.Empty)
                .Where(x => x != Guid.Empty)
                .ToHashSet(),
            string value when Guid.TryParse(value, out var id) && id != Guid.Empty => [id],
            _ => []
        };
    }

    private async Task OnSelectedModelChangedAsync(ChangeEventArgs args)
    {
        selectedModelIdText = args.Value?.ToString() ?? string.Empty;
        modelStatusMessage = null;
        loadedModel = null;
        loadedModelSignature = null;
        loadedModelVersionSignature = null;

        if (string.IsNullOrWhiteSpace(selectedModelIdText))
        {
            return;
        }

        await LoadSelectedModelAsync();
    }

    private async Task LoadSavedModelsAsync()
    {
        if (!CanSaveModels)
        {
            savedModels = [];
            selectedModelIdText = string.Empty;
            loadedModel = null;
            loadedModelSignature = null;
            loadedModelVersionSignature = null;
            modelStatusMessage = "Sign in to save models.";
            return;
        }

        isLoadingModels = true;
        modelStatusMessage = null;

        try
        {
            using var response = await Http.GetAsync("api/model-lab/models");
            if (response.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
            {
                savedModels = [];
                selectedModelIdText = string.Empty;
                loadedModel = null;
                loadedModelSignature = null;
                loadedModelVersionSignature = null;
                modelStatusMessage = "Sign in to save and load models.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(response));
            }

            savedModels = await response.Content.ReadFromJsonAsync<List<ModelLabModelSummaryResponse>>() ?? [];
        }
        catch (Exception ex)
        {
            modelStatusMessage = $"Could not load saved models: {ex.Message}";
        }
        finally
        {
            isLoadingModels = false;
        }
    }

    private async Task LoadSavedRunsAsync()
    {
        if (!CanSaveModels)
        {
            savedRuns = [];
            runQuota = null;
            return;
        }

        try
        {
            using var quotaResponse = await Http.GetAsync("api/model-lab/runs/quota");
            if (!quotaResponse.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(quotaResponse));
            }

            runQuota = await quotaResponse.Content.ReadFromJsonAsync<ModelLabRunQuotaResponse>();

            using var response = await Http.GetAsync("api/model-lab/runs?take=5");
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(response));
            }

            savedRuns = await response.Content.ReadFromJsonAsync<List<ModelLabRunSummaryResponse>>() ?? [];
        }
        catch (Exception ex)
        {
            modelStatusMessage = $"Could not load saved runs: {ex.Message}";
        }
    }

    private async Task LoadSelectedModelAsync()
    {
        if (!CanSaveModels)
        {
            modelStatusMessage = "Sign in to save models.";
            return;
        }

        if (!Guid.TryParse(selectedModelIdText, out var modelId))
        {
            return;
        }

        isSavingModel = true;
        modelStatusMessage = null;

        try
        {
            using var response = await Http.GetAsync($"api/model-lab/models/{modelId}");
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(response));
            }

            var model = await response.Content.ReadFromJsonAsync<ModelLabModelDetailResponse>()
                ?? throw new InvalidOperationException("The saved model response was empty.");
            ApplySavedModel(model);
            lastSavedRunSignature = null;
            modelStatusMessage = $"Loaded {model.Name} v{model.CurrentVersion.VersionNumber}.";
        }
        catch (Exception ex)
        {
            modelStatusMessage = $"Could not load saved model: {ex.Message}";
        }
        finally
        {
            isSavingModel = false;
        }
    }

    private async Task SaveNewModelAsync()
    {
        if (!CanSaveModels)
        {
            modelStatusMessage = "Sign in to save models.";
            return;
        }

        isSavingModel = true;
        modelStatusMessage = null;

        try
        {
            using var response = await Http.PostAsJsonAsync("api/model-lab/models", BuildSaveRequest());
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(response));
            }

            var model = await response.Content.ReadFromJsonAsync<ModelLabModelDetailResponse>()
                ?? throw new InvalidOperationException("The saved model response was empty.");
            selectedModelIdText = model.Id.ToString();
            ApplySavedModel(model);
            await LoadSavedModelsAsync();
            selectedModelIdText = model.Id.ToString();
            loadedModel = model;
            loadedModelSignature = BuildCurrentModelSignature();
            loadedModelVersionSignature = BuildCurrentVersionSignature();
            lastSavedRunSignature = null;
            modelStatusMessage = $"Saved {model.Name} v{model.CurrentVersion.VersionNumber}.";
        }
        catch (Exception ex)
        {
            modelStatusMessage = $"Could not save model: {ex.Message}";
        }
        finally
        {
            isSavingModel = false;
        }
    }

    private async Task UpdateSelectedModelAsync()
    {
        if (!CanSaveModels)
        {
            modelStatusMessage = "Sign in to save models.";
            return;
        }

        if (!Guid.TryParse(selectedModelIdText, out var modelId))
        {
            return;
        }

        if (!IsLoadedSelectedModel)
        {
            modelStatusMessage = "Load the selected model before updating.";
            return;
        }

        if (!IsSelectedModelDirty)
        {
            modelStatusMessage = "No model changes to update.";
            return;
        }

        isSavingModel = true;
        modelStatusMessage = null;

        try
        {
            using var response = await Http.PutAsJsonAsync($"api/model-lab/models/{modelId}", BuildSaveRequest());
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(response));
            }

            var model = await response.Content.ReadFromJsonAsync<ModelLabModelDetailResponse>()
                ?? throw new InvalidOperationException("The saved model response was empty.");
            ApplySavedModel(model);
            await LoadSavedModelsAsync();
            selectedModelIdText = model.Id.ToString();
            loadedModel = model;
            loadedModelSignature = BuildCurrentModelSignature();
            loadedModelVersionSignature = BuildCurrentVersionSignature();
            lastSavedRunSignature = null;
            modelStatusMessage = $"Updated {model.Name} to v{model.CurrentVersion.VersionNumber}.";
        }
        catch (Exception ex)
        {
            modelStatusMessage = $"Could not update model: {ex.Message}";
        }
        finally
        {
            isSavingModel = false;
        }
    }

    private async Task RunBacktestAsync()
    {
        NormalizeScopeForEntitlement();
        ApplySelectedSeasonsToDates();

        if (scopeType == ModelLabScopeTypes.SelectedCompetitions && selectedCompetitionIds.Count == 0)
        {
            errorMessage = "Choose at least one competition before running the model.";
            return;
        }

        if (scopeType == ModelLabScopeTypes.SingleCompetition && string.IsNullOrWhiteSpace(leagueName))
        {
            errorMessage = "Choose a competition before running the model.";
            return;
        }

        isRunning = true;
        errorMessage = null;

        try
        {
            var request = new ModelLabBacktestRequest(
                modelName,
                BuildParameterSet(),
                BuildRequestLeagueName(),
                DateTime.SpecifyKind(initializationFrom.Date, DateTimeKind.Utc),
                DateTime.SpecifyKind(initializationTo.Date, DateTimeKind.Utc).AddDays(1).AddTicks(-1),
                DateTime.SpecifyKind(scoredFrom.Date, DateTimeKind.Utc),
                DateTime.SpecifyKind(scoredTo.Date, DateTimeKind.Utc).AddDays(1).AddTicks(-1),
                scopeType,
                BuildRequestCompetitionIds(),
                selectedPoolKey);

            using var response = await Http.PostAsJsonAsync("api/model-lab/backtests", request);
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(response));
            }

            result = await response.Content.ReadFromJsonAsync<ModelLabBacktestResponse>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not run the model: {ex.Message}";
        }
        finally
        {
            isRunning = false;
        }
    }

    private async Task CreateStoredRunAsync()
    {
        if (IsSelectedModelDirty)
        {
            modelStatusMessage = "Save or discard your model changes before running it.";
            return;
        }

        NormalizeScopeForEntitlement();
        ApplySelectedSeasonsToDates();

        if (scopeType == ModelLabScopeTypes.SelectedCompetitions && selectedCompetitionIds.Count == 0)
        {
            errorMessage = "Choose at least one competition before running the model.";
            return;
        }

        isSavingRun = true;
        errorMessage = null;
        modelStatusMessage = null;

        try
        {
            var model = await SaveCurrentModelForRunAsync();
            var request = new CreateModelLabRunRequest(
                model.Id,
                model.CurrentVersion.Id,
                DateTime.SpecifyKind(initializationFrom.Date, DateTimeKind.Utc),
                DateTime.SpecifyKind(initializationTo.Date, DateTimeKind.Utc).AddDays(1).AddTicks(-1),
                DateTime.SpecifyKind(scoredFrom.Date, DateTimeKind.Utc),
                DateTime.SpecifyKind(scoredTo.Date, DateTimeKind.Utc).AddDays(1).AddTicks(-1),
                scopeType,
                BuildRequestCompetitionIds(),
                selectedPoolKey,
                BuildRequestLeagueName());

            using var response = await Http.PostAsJsonAsync("api/model-lab/runs", request);
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(response));
            }

            var createdRun = await response.Content.ReadFromJsonAsync<ModelLabRunCreateResponse>()
                ?? throw new InvalidOperationException("The saved run response was empty.");

            selectedModelIdText = model.Id.ToString();
            lastSavedRunSignature = BuildCurrentRunSignature();
            loadedModel = model;
            loadedModelSignature = BuildCurrentModelSignature();
            loadedModelVersionSignature = BuildCurrentVersionSignature();
            await LoadSavedModelsAsync();
            selectedModelIdText = model.Id.ToString();
            await LoadSavedRunsAsync();
            Navigation.NavigateTo($"model-lab/runs/{createdRun.RunId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not start the run: {ex.Message}";
        }
        finally
        {
            isSavingRun = false;
        }
    }

    private async Task<ModelLabModelDetailResponse> SaveCurrentModelForRunAsync()
    {
        HttpResponseMessage response;
        if (IsLoadedSelectedModel)
        {
            if (IsSelectedModelDirty)
            {
                throw new InvalidOperationException("Save or discard your model changes before running it.");
            }

            return loadedModel!;
        }

        if (Guid.TryParse(selectedModelIdText, out var modelId))
        {
            response = await Http.PutAsJsonAsync($"api/model-lab/models/{modelId}", BuildSaveRequest());
        }
        else
        {
            response = await Http.PostAsJsonAsync("api/model-lab/models", BuildSaveRequest());
        }

        using (response)
        {
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(response));
            }

            var model = await response.Content.ReadFromJsonAsync<ModelLabModelDetailResponse>()
                ?? throw new InvalidOperationException("The saved model response was empty.");
            ApplySavedModel(model);
            return model;
        }
    }

    private void StartNewDraft()
    {
        selectedModelIdText = string.Empty;
        loadedModel = null;
        loadedModelSignature = null;
        loadedModelVersionSignature = null;
        lastSavedRunSignature = null;
        modelStatusMessage = "Editing a new unsaved model draft.";
    }

    private void DiscardSelectedModelChanges()
    {
        if (!IsLoadedSelectedModel || loadedModel is null || !IsSelectedModelDirty)
        {
            return;
        }

        var model = loadedModel;
        ApplySavedModel(model);
        result = null;
        errorMessage = null;
        modelStatusMessage = $"Discarded changes. {model.Name} v{model.CurrentVersion.VersionNumber} is ready to run.";
    }

    private void ResetDefaults()
    {
        if (options is not null)
        {
            ApplyDefaults(options);
            selectedModelIdText = string.Empty;
            loadedModel = null;
            loadedModelSignature = null;
            loadedModelVersionSignature = null;
            lastSavedRunSignature = null;
            modelDescription = null;
            modelStatusMessage = null;
        }
    }

    private SaveModelLabModelRequest BuildSaveRequest()
        => new(
            modelName,
            modelDescription,
            string.Empty,
            BuildParameterSet(),
            null);

    private ModelLabParameterSet BuildParameterSet()
        => new(
            baseRating,
            kFactor,
            homeAdvantageElo,
            probabilityScale,
            usesMarginAdjustment,
            usesMarginAdjustment ? pointsPerEloMargin : null,
            competitionWeight,
            marginDampenerFactor,
            maxMarginMultiplier);

    private string BuildRequestLeagueName()
        => scopeType switch
        {
            ModelLabScopeTypes.AllCompetitions => "All competitions",
            ModelLabScopeTypes.SelectedCompetitions => selectedCompetitionIds.Count == 1
                ? AvailableCompetitions.FirstOrDefault(x => selectedCompetitionIds.Contains(x.Id))?.DisplayName ?? "Selected competition"
                : $"{selectedCompetitionIds.Count} competitions",
            _ => leagueName ?? string.Empty
        };

    private IReadOnlyCollection<Guid>? BuildRequestCompetitionIds()
        => scopeType == ModelLabScopeTypes.SelectedCompetitions
            ? selectedCompetitionIds.ToList()
            : null;

    private string BuildCurrentRunSignature()
    {
        var competitionIds = scopeType == ModelLabScopeTypes.SelectedCompetitions
            ? string.Join(",", selectedCompetitionIds.OrderBy(x => x))
            : string.Empty;
        var pointsPerMargin = usesMarginAdjustment
            ? pointsPerEloMargin.ToString("0.####")
            : string.Empty;
        var marginDampener = usesMarginAdjustment
            ? marginDampenerFactor.ToString("0.####")
            : string.Empty;
        var marginCap = usesMarginAdjustment
            ? maxMarginMultiplier.ToString("0.####")
            : string.Empty;

        return string.Join("|", [
            selectedModelIdText.Trim(),
            (modelName ?? string.Empty).Trim(),
            (modelDescription ?? string.Empty).Trim(),
            (leagueName ?? string.Empty).Trim(),
            selectedPoolKey,
            scopeType,
            competitionIds,
            initializationFromSeason ?? string.Empty,
            initializationToSeason ?? string.Empty,
            scoredFromSeason ?? string.Empty,
            scoredToSeason ?? string.Empty,
            initializationFrom.Date.ToString("O"),
            initializationTo.Date.ToString("O"),
            scoredFrom.Date.ToString("O"),
            scoredTo.Date.ToString("O"),
            baseRating.ToString("0.####"),
            kFactor.ToString(),
            homeAdvantageElo.ToString("0.####"),
            probabilityScale.ToString("0.####"),
            usesMarginAdjustment.ToString(),
            pointsPerMargin,
            competitionWeight.ToString("0.####"),
            marginDampener,
            marginCap
        ]);
    }

    private string BuildCurrentModelSignature()
        => string.Join("|", [
            (modelName ?? string.Empty).Trim(),
            (modelDescription ?? string.Empty).Trim(),
            (leagueName ?? string.Empty).Trim(),
            BuildCurrentVersionSignature()
        ]);

    private string BuildCurrentVersionSignature()
    {
        var pointsPerMargin = usesMarginAdjustment
            ? pointsPerEloMargin.ToString("0.####")
            : string.Empty;
        var marginDampener = usesMarginAdjustment
            ? marginDampenerFactor.ToString("0.####")
            : string.Empty;
        var marginCap = usesMarginAdjustment
            ? maxMarginMultiplier.ToString("0.####")
            : string.Empty;

        return string.Join("|", [
            baseRating.ToString("0.####"),
            kFactor.ToString(),
            homeAdvantageElo.ToString("0.####"),
            probabilityScale.ToString("0.####"),
            usesMarginAdjustment.ToString(),
            pointsPerMargin,
            competitionWeight.ToString("0.####"),
            marginDampener,
            marginCap
        ]);
    }

    private void ApplySavedModel(ModelLabModelDetailResponse model)
    {
        selectedModelIdText = model.Id.ToString();
        modelName = model.Name;
        modelDescription = model.Description;
        scopeType = ModelLabScopeTypes.SingleCompetition;
        SetPoolForCompetition(model.LeagueName);
        leagueName = NormalizeLeagueForEntitlement(model.LeagueName);
        ApplyParameters(model.CurrentVersion.Parameters);
        loadedModel = model;
        loadedModelSignature = BuildCurrentModelSignature();
        loadedModelVersionSignature = BuildCurrentVersionSignature();
    }

    private void ApplyDefaults(ModelLabOptionsResponse response)
    {
        modelName = "Adjusted ELO experiment";
        modelDescription = null;
        scopeType = ModelLabScopeTypes.SingleCompetition;
        selectedPoolKey = ResolveDefaultPoolKey(response);
        leagueName = NormalizeLeagueForEntitlement(AvailableLeagues.FirstOrDefault());
        selectedCompetitionIds = AvailableCompetitions
            .Take(2)
            .Where(x => x.Id != Guid.Empty)
            .Select(x => x.Id)
            .ToHashSet();
        ApplyParameters(response.Defaults);

        var seasons = response.Seasons
            .OrderBy(x => x.FirstGameUtc)
            .ThenBy(x => x.Label)
            .ToList();
        if (seasons.Count > 0)
        {
            var scoredStartIndex = seasons.Count - 1;
            var initializationStartIndex = Math.Max(0, scoredStartIndex - 1);
            var initializationEndIndex = initializationStartIndex;

            initializationFromSeason = seasons[initializationStartIndex].Label;
            initializationToSeason = seasons[initializationEndIndex].Label;
            scoredFromSeason = seasons[scoredStartIndex].Label;
            scoredToSeason = seasons[scoredStartIndex].Label;
            ApplySelectedSeasonsToDates();
        }
        else
        {
            var last = response.LastGameUtc?.Date ?? DateTime.UtcNow.Date;
            scoredTo = last;
            scoredFrom = last.AddYears(-1).AddDays(1);
            initializationTo = scoredFrom.AddDays(-1);
            initializationFrom = initializationTo.AddYears(-2).AddDays(1);

            if (response.FirstGameUtc.HasValue && initializationFrom < response.FirstGameUtc.Value.Date)
            {
                initializationFrom = response.FirstGameUtc.Value.Date;
            }
        }
    }

    private void ApplyParameters(ModelLabParameterSet parameters)
    {
        baseRating = parameters.BaseRating;
        kFactor = parameters.KFactor;
        homeAdvantageElo = parameters.HomeAdvantageElo;
        probabilityScale = parameters.ProbabilityScale;
        usesMarginAdjustment = parameters.UsesMarginAdjustment;
        pointsPerEloMargin = parameters.PointsPerEloMargin ?? EloCalculator.PointsPerEloMargin;
        competitionWeight = parameters.CompetitionWeight;
        marginDampenerFactor = parameters.MarginDampenerFactor;
        maxMarginMultiplier = parameters.MaxMarginMultiplier;
    }

    private void ApplySelectedSeasonsToDates()
    {
        if (TryResolveSeasonRange(initializationFromSeason, initializationToSeason, out var initFrom, out var initTo))
        {
            initializationFrom = initFrom;
            initializationTo = initTo;
        }

        if (TryResolveSeasonRange(scoredFromSeason, scoredToSeason, out var scoreFrom, out var scoreTo))
        {
            scoredFrom = scoreFrom;
            scoredTo = scoreTo;
        }
    }

    private bool TryResolveSeasonRange(string? fromSeason, string? toSeason, out DateTime fromUtc, out DateTime toUtc)
    {
        fromUtc = default;
        toUtc = default;

        var seasons = AvailableSeasons;
        if (seasons.Count == 0)
        {
            return false;
        }

        var fromIndex = FindSeasonIndex(fromSeason);
        var toIndex = FindSeasonIndex(toSeason);
        if (fromIndex < 0 || toIndex < 0)
        {
            return false;
        }

        var startIndex = Math.Min(fromIndex, toIndex);
        var endIndex = Math.Max(fromIndex, toIndex);
        fromUtc = seasons[startIndex].FirstGameUtc.Date;
        toUtc = seasons[endIndex].LastGameUtc.Date;
        return true;
    }

    private int FindSeasonIndex(string? label)
    {
        if (string.IsNullOrWhiteSpace(label))
        {
            return -1;
        }

        var seasons = AvailableSeasons;
        for (var index = 0; index < seasons.Count; index++)
        {
            if (string.Equals(seasons[index].Label, label, StringComparison.OrdinalIgnoreCase))
            {
                return index;
            }
        }

        return -1;
    }

    private string? NormalizeLeagueForEntitlement(string? requestedLeague)
    {
        NormalizeScopeForEntitlement();

        if (!string.IsNullOrWhiteSpace(entitlement?.RequiredLeagueName))
        {
            return entitlement.RequiredLeagueName;
        }

        return !string.IsNullOrWhiteSpace(requestedLeague) &&
            AvailableLeagues.Contains(requestedLeague, StringComparer.OrdinalIgnoreCase)
                ? requestedLeague
                : AvailableLeagues.FirstOrDefault();
    }

    private void NormalizeScopeForEntitlement()
    {
        if (!CanUseMultiCompetitionScopes)
        {
            scopeType = ModelLabScopeTypes.SingleCompetition;
            selectedCompetitionIds = [];
        }
    }

    private string ResolveDefaultPoolKey(ModelLabOptionsResponse response)
    {
        if (!string.IsNullOrWhiteSpace(entitlement?.RequiredLeagueName))
        {
            var requiredCompetition = response.Competitions.FirstOrDefault(x =>
                string.Equals(x.DisplayName, entitlement.RequiredLeagueName, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.Name, entitlement.RequiredLeagueName, StringComparison.OrdinalIgnoreCase));
            if (requiredCompetition is not null)
            {
                return requiredCompetition.EloPoolKey;
            }
        }

        return response.Pools.FirstOrDefault()?.Key ?? EloPoolKeys.Default;
    }

    private void SetPoolForCompetition(string? competitionName)
    {
        var competition = options?.Competitions.FirstOrDefault(x =>
            string.Equals(x.DisplayName, competitionName, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Name, competitionName, StringComparison.OrdinalIgnoreCase));
        if (competition is not null)
        {
            selectedPoolKey = competition.EloPoolKey;
        }
    }

    private ModelLabCompetitionOption? FindCompetition(string? displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return null;
        }

        return AvailableCompetitions.FirstOrDefault(x =>
            string.Equals(x.DisplayName, displayName, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Name, displayName, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsInfoPanelVisible(string key)
        => string.Equals(activeInfoPanel, key, StringComparison.Ordinal);

    private void ToggleInfoPanel(string key)
        => activeInfoPanel = IsInfoPanelVisible(key) ? null : key;

    private void CloseInfoPanel()
        => activeInfoPanel = null;

    private int BaselineMetricWins
        => result is null
            ? 0
            : new[]
            {
                CompareMetric(result.Summary.WinnerAccuracy, result.BaselineSummary.WinnerAccuracy, higherIsBetter: true),
                CompareMetric(result.Summary.BrierScore, result.BaselineSummary.BrierScore, higherIsBetter: false),
                CompareMetric(result.Summary.AverageMarginError, result.BaselineSummary.AverageMarginError, higherIsBetter: false)
            }.Count(x => x > 0);

    private int BaselineMetricLosses
        => result is null
            ? 0
            : new[]
            {
                CompareMetric(result.Summary.WinnerAccuracy, result.BaselineSummary.WinnerAccuracy, higherIsBetter: true),
                CompareMetric(result.Summary.BrierScore, result.BaselineSummary.BrierScore, higherIsBetter: false),
                CompareMetric(result.Summary.AverageMarginError, result.BaselineSummary.AverageMarginError, higherIsBetter: false)
            }.Count(x => x < 0);

    private string BaselineVerdictClass
        => BaselineMetricWins > BaselineMetricLosses
            ? "verdict-ahead"
            : BaselineMetricLosses > BaselineMetricWins
                ? "verdict-behind"
                : "verdict-even";

    private string BaselineVerdictLabel
        => BaselineMetricWins > BaselineMetricLosses
            ? "Ahead of standard"
            : BaselineMetricLosses > BaselineMetricWins
                ? "Standard is ahead"
                : "Too close to call";

    private string BaselineVerdictSummary
        => result is null
            ? string.Empty
            : BaselineMetricWins == BaselineMetricLosses
                ? "The model and standard split the tracked metrics."
                : $"Your model wins {BaselineMetricWins} of 3 tracked metrics against the standard.";

    private string FormatAccuracyDelta()
    {
        if (result is null)
        {
            return string.Empty;
        }

        var delta = result.Summary.WinnerAccuracy - result.BaselineSummary.WinnerAccuracy;
        return delta switch
        {
            > 0 => $"+{delta:0.0} pp",
            < 0 => $"{delta:0.0} pp",
            _ => "even"
        };
    }

    private static string FormatLowerIsBetterDelta(decimal modelValue, decimal baselineValue)
    {
        var improvement = baselineValue - modelValue;
        return improvement switch
        {
            > 0 => $"{improvement:+0.000;-0.000;0.000} better",
            < 0 => $"{improvement:0.000} worse",
            _ => "even"
        };
    }

    private static int CompareMetric(decimal modelValue, decimal baselineValue, bool higherIsBetter)
    {
        var comparison = decimal.Compare(modelValue, baselineValue);
        return higherIsBetter ? comparison : -comparison;
    }

    private static string BaselineMetricClass(decimal modelValue, decimal baselineValue, bool higherIsBetter)
        => CompareMetric(modelValue, baselineValue, higherIsBetter) switch
        {
            > 0 => "metric-better",
            < 0 => "metric-worse",
            _ => "metric-even"
        };

    private static bool HasBaselineRatings(IEnumerable<ModelLabRatingRow> ratings)
        => ratings.Any(x => x.BaselineRank.HasValue && x.BaselineElo.HasValue);

    private static string FormatEloDelta(ModelLabRatingRow row)
        => row.BaselineElo is not decimal baseline
            ? "standard unavailable"
            : (row.Elo - baseline) switch
            {
                > 0 => $"+{row.Elo - baseline:0} ELO",
                < 0 => $"{row.Elo - baseline:0} ELO",
                _ => "even ELO"
            };

    private static string FormatRankDelta(ModelLabRatingRow row)
        => row.BaselineRank is not int baseline
            ? "rank unavailable"
            : (baseline - row.Rank) switch
            {
                > 0 => $"↑{baseline - row.Rank} rank{(baseline - row.Rank == 1 ? string.Empty : "s")}",
                < 0 => $"↓{row.Rank - baseline} rank{(row.Rank - baseline == 1 ? string.Empty : "s")}",
                _ => "same rank"
            };

    private static string BaselineComparisonClass(ModelLabRatingRow row)
        => row.BaselineElo is not decimal baseline
            ? "comparison-unavailable"
            : row.Elo == baseline
                ? "comparison-even"
                : row.Elo > baseline
                    ? "comparison-positive"
                    : "comparison-negative";

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(body))
        {
            return response.ReasonPhrase ?? $"HTTP {(int)response.StatusCode}";
        }

        try
        {
            using var json = JsonDocument.Parse(body);
            if (json.RootElement.ValueKind == JsonValueKind.String)
            {
                return json.RootElement.GetString() ?? body;
            }

            if (json.RootElement.TryGetProperty("title", out var title) && title.ValueKind == JsonValueKind.String)
            {
                return title.GetString() ?? body;
            }

            if (json.RootElement.TryGetProperty("message", out var message) && message.ValueKind == JsonValueKind.String)
            {
                return message.GetString() ?? body;
            }
        }
        catch (JsonException)
        {
        }

        return body;
    }

    private static string FormatMovement(decimal value)
        => value switch
        {
            > 0 => $"+{value:0}",
            < 0 => value.ToString("0"),
            _ => "0"
        };

    private static string MovementClass(decimal value)
        => value switch
        {
            > 0 => "movement-up",
            < 0 => "movement-down",
            _ => "movement-flat"
        };

    private static string FormatSigned(decimal value)
        => value > 0 ? $"+{value:0.0}" : value.ToString("0.0");
}
