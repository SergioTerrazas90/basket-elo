@page "/about"

<SeoHead Title='@T["AboutSeoTitle"]'
         Description='@T["AboutSeoDescription"]'
         CanonicalPath="/about"
         SchemaType="AboutPage" />

<div class="info-page about-page">
    <header class="info-hero be-reveal" style="--reveal-order: 0">
        <div class="info-hero-copy">
            <p class="info-kicker">@T["About"]</p>
            <h1>@T["AboutHeroTitle"]</h1>
            <p class="info-lede">@T["AboutHeroIntro"]</p>
            <p class="info-lede">@T["AboutHeroElo"]</p>
        </div>
        <dl class="info-facts" aria-label='@T["AboutProject"]'>
            <div><dt>@T["WhatItIs"]</dt><dd>@T["PersonalProject"]</dd></div>
            <div><dt>@T["BuiltBy"]</dt><dd>@T["EngineerAndFan"]</dd></div>
            <div><dt>@T["From"]</dt><dd>@T["Spain"]</dd></div>
            <div><dt>@T["Status"]</dt><dd>@T["StillEvolving"]</dd></div>
        </dl>
    </header>

    <section class="info-section be-reveal" style="--reveal-order: 1" aria-labelledby="beginning-heading">
        <div class="info-section-label"><span>01</span><span>@T["TheBeginning"]</span></div>
        <div class="info-section-body about-prose">
            <h2 id="beginning-heading">@T["AboutBeginningTitle"]</h2>
            <p>@T["AboutBeginningText1"]</p>
            <p>@T["AboutBeginningText2"]</p>
        </div>
    </section>

    <section class="info-section be-reveal" style="--reveal-order: 2" aria-labelledby="journey-heading">
        <div class="info-section-label"><span>02</span><span>@T["TheJourney"]</span></div>
        <div class="info-section-body">
            <h2 id="journey-heading">@T["AboutJourneyTitle"]</h2>
            <p class="info-section-intro">@T["AboutJourneyIntro"]</p>
            <ol class="about-journey">
                <li><span>@T["First"]</span><div><h3>@T["SimpleModel"]</h3><p>@T["SimpleModelDescription"]</p></div></li>
                <li><span>@T["Then"]</span><div><h3>@T["DataFoughtBack"]</h3><p>@T["DataFoughtBackDescription"]</p></div></li>
                <li><span>@T["NextStep"]</span><div><h3>@T["MapGotBigger"]</h3><p>@T["MapGotBiggerDescription"]</p></div></li>
                <li><span>@T["Now"]</span><div><h3>@T["StillAskingQuestions"]</h3><p>@T["StillAskingQuestionsDescription"]</p></div></li>
            </ol>
        </div>
    </section>

    <section class="info-section be-reveal" style="--reveal-order: 3" aria-labelledby="ai-heading">
        <div class="info-section-label"><span>03</span><span>@T["BuiltInMargins"]</span></div>
        <div class="info-section-body about-prose">
            <h2 id="ai-heading">@T["AboutMarginsTitle"]</h2>
            <p>@T["AboutMarginsText1"]</p>
            <p>@T["AboutMarginsText2"]</p>
        </div>
    </section>

    <section class="info-section info-section-last be-reveal" style="--reveal-order: 4" aria-labelledby="stack-heading">
        <div class="info-section-label"><span>04</span><span>@T["TheStack"]</span></div>
        <div class="info-section-body about-prose">
            <h2 id="stack-heading">@T["AboutStackTitle"]</h2>
            <p>@T["AboutStackText"]</p>
            <div class="about-stack" aria-label='@T["TechnologyStack"]'>
                <span>Codex</span>
                <span>Blazor</span>
                <span>.NET</span>
                <span>OVH VPS</span>
            </div>
            <p class="about-stack-disclaimer">@T["AboutStackDisclaimer"]</p>
            <p>@T["AboutContactIntro"] <a class="info-text-link" href="https://x.com/sergitm12" target="_blank" rel="noopener noreferrer">@T["PingMeOnX"] <span aria-hidden="true">↗</span></a>.</p>
        </div>
    </section>

</div>
