@page "/sponsor"

<SeoHead Title='@T["SponsorSeoTitle"]'
         Description='@T["SponsorSeoDescription"]'
         CanonicalPath="/sponsor" />

<div class="info-page sponsor-page">
    <header class="info-hero sponsor-hero be-reveal" style="--reveal-order: 0">
        <div class="info-hero-copy">
            <p class="info-kicker">@T["Support"]</p>
            <h1>@T["SponsorHeroTitle"]</h1>
            <p class="info-lede">@T["SponsorHeroText"]</p>
        </div>
        <a class="sponsor-contact-link" href="https://x.com/sergitm12" target="_blank" rel="noopener noreferrer">
            <span>@T["GetInTouch"]</span>
            <strong>Message @@sergitm12</strong>
            <small>@T["OnX"] <span aria-hidden="true">↗</span></small>
        </a>
    </header>

    <aside class="support-placeholder be-reveal" style="--reveal-order: 1" aria-label='@T["BuyMeACoffeePlaceholder"]'>
        <div>
            <p class="info-kicker">@T["ComingSoon"]</p>
            <h2>@T["BuyMeACoffee"]</h2>
        </div>
        <div class="support-coffee-action">
            <p>@T["CoffeePlaceholderText"]</p>
            <a class="support-coffee-link"
               href="https://buymeacoffee.com/sergitm"
               target="_blank"
               rel="noopener noreferrer">
                <span class="support-coffee-icon" aria-hidden="true">☕</span>
                <span>@T["BuyMeACoffee"]</span>
                <span class="support-coffee-arrow" aria-hidden="true">↗</span>
            </a>
        </div>
    </aside>

    <section class="info-section info-section-last be-reveal" style="--reveal-order: 2" aria-labelledby="meaningful-heading">
        <div class="info-section-label"><span>01</span><span>@T["GoodFit"]</span></div>
        <div class="info-section-body">
            <h2 id="meaningful-heading">@T["SponsorFitTitle"]</h2>
            <div class="sponsor-fit">
                <article><h3>@T["Meaningful"]</h3><p>@T["MeaningfulSponsorText"]</p></article>
                <article><h3>@T["Unobtrusive"]</h3><p>@T["UnobtrusiveSponsorText"]</p></article>
            </div>
            <p class="sponsor-note">@T["SponsorNote"]</p>
            <a class="info-text-link" href="https://x.com/sergitm12" target="_blank" rel="noopener noreferrer">@T["StartConversation"] <span aria-hidden="true">↗</span></a>
        </div>
    </section>
</div>
