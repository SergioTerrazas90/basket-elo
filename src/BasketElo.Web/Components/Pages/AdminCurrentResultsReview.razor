@page "/admin/current-results-review"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@using BasketElo.Domain.CurrentResults
@using BasketElo.Domain.Competitions
@using BasketElo.Domain.Elo
@using BasketElo.Domain.Entities
@using BasketElo.Domain.Teams
@using BasketElo.Infrastructure.Identity
@inject HttpClient Http

<PageTitle>Results matching</PageTitle>

<div class="admin-page">
    <section class="page-header">
        <div>
            <p class="eyebrow">Review &amp; resolve</p>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1>Results matching</h1>
                @if (openReviewCount.HasValue)
                {
                    <span class="badge rounded-pill text-bg-warning" title="Open reviews remaining">
                        @openReviewCount.Value @(openReviewCount.Value == 1 ? "review left" : "reviews left")
                    </span>
                }
            </div>
            <p class="intro">Livescore team identities at 95% confidence or above are mapped automatically. Review 80–94% suggestions here; lower-confidence cases require search or a new canonical team.</p>
        </div>
        <div class="header-actions">
            <NavLink class="btn btn-outline-secondary" href="admin">Operations overview</NavLink>
            <button type="button" class="btn btn-primary" @onclick="LoadAsync" disabled="@isBusy">Refresh</button>
        </div>
    </section>

    @if (unmatchedCompetitions is { Count: > 0 })
    {
        <section class="card border-warning mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <p class="eyebrow text-warning-emphasis">New unmatched competition</p>
                        <h2 class="h4 mb-1">Decide how these competitions should be handled</h2>
                        <p class="text-muted mb-0">Merge into an existing competition or create a new one. For FIBA and Olympic sources, you can also assign or create the target tournament cycle.</p>
                    </div>
                    <NavLink class="btn btn-outline-secondary" href="admin/competitions">Manage competitions</NavLink>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var unmatched in unmatchedCompetitions)
                    {
                        var key = UnmatchedKey(unmatched);
                        var selection = GetUnmatchedSelection(key, unmatched);
                        <div class="border rounded p-3">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <strong>@unmatched.CompetitionName</strong>
                                    <div class="small text-muted">@unmatched.CountryName · @unmatched.Source@(string.IsNullOrWhiteSpace(unmatched.SourceCompetitionId) ? string.Empty : $" · ID {unmatched.SourceCompetitionId}") · @unmatched.ReviewCount review(s)</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => IgnoreUnmatchedAsync(unmatched)" disabled="@isBusy">Don't handle</button>
                            </div>
                            <div class="row g-3 mt-2">
                                <div class="col-lg-5">
                                    <label class="form-label" for="competition-mode-@key">Competition action</label>
                                    <select id="competition-mode-@key" class="form-select" @bind="selection.CompetitionMode">
                                        <option value="existing">Merge into existing competition</option>
                                        <option value="create">Create new competition</option>
                                    </select>
                                </div>
                                @if (selection.CompetitionMode == "existing")
                                {
                                    <div class="col-lg-7">
                                        <label class="form-label" for="merge-@key">Existing competition</label>
                                        <select id="merge-@key" class="form-select" @bind="selection.ExistingCompetitionId">
                                            <option value="">Choose a supported competition...</option>
                                            @foreach (var option in competitionOptions ?? [])
                                            {
                                                if (option.SupportPolicy == CompetitionSupportPolicies.Supported)
                                                {
                                                    <option value="@option.Id">@option.Name@(string.IsNullOrWhiteSpace(option.CountryCode) ? string.Empty : $" ({option.CountryCode})")</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-lg-7">
                                        <label class="form-label" for="new-name-@key">New competition name</label>
                                        <input id="new-name-@key" class="form-control" @bind="selection.NewCompetitionName" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="new-type-@key">Type</label>
                                        <select id="new-type-@key" class="form-select" @bind="selection.NewCompetitionType">
                                            @foreach (var type in CompetitionTypeCatalog.All)
                                            {
                                                <option value="@type.Key">@type.DisplayName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="new-pool-@key">ELO pool</label>
                                        <select id="new-pool-@key" class="form-select" @bind="selection.NewCompetitionEloPoolKey">
                                            <option value="">Not rated</option>
                                            @foreach (var pool in EloPoolCatalog.All.OrderBy(x => x.DisplayOrder))
                                            {
                                                <option value="@pool.Key">@pool.DisplayName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="new-country-@key">Country code (optional)</label>
                                        <input id="new-country-@key" class="form-control" @bind="selection.NewCompetitionCountryCode" />
                                    </div>
                                }
                                <div class="col-lg-7">
                                    <label class="form-label" for="cycle-@key">Tournament cycle</label>
                                    <select id="cycle-@key" class="form-select" @bind="selection.CycleSelection">
                                        <option value="">Do not assign a cycle</option>
                                        @foreach (var cycle in tournamentCycleOptions ?? [])
                                        {
                                            <option value="@cycle.Id">@cycle.DisplayName (@cycle.Key)</option>
                                        }
                                        <option value="create">Create a FIBA/Olympic cycle</option>
                                    </select>
                                </div>
                                @if (selection.CycleSelection == "create")
                                {
                                    <div class="col-md-5">
                                        <label class="form-label" for="cycle-family-@key">Cycle family</label>
                                        <select id="cycle-family-@key" class="form-select" @bind="selection.NewCycleFamily">
                                            <option value="">Choose a family...</option>
                                            @foreach (var family in tournamentCycleFamilies ?? [])
                                            {
                                                <option value="@family">@family</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label" for="cycle-edition-@key">Edition</label>
                                        <input id="cycle-edition-@key" class="form-control" placeholder="2031" @bind="selection.NewCycleEdition" />
                                    </div>
                                }
                                <div class="col-12">
                                    <button type="button" class="btn btn-primary" @onclick="() => MergeUnmatchedAsync(unmatched)" disabled="@isBusy">Apply competition and cycle</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="card mb-4">
        <div class="card-body d-flex flex-wrap align-items-end gap-3">
            <div>
                <label class="form-label" for="current-results-status">Status</label>
                <select id="current-results-status" class="form-select" @bind="statusFilter">
                    <option value="open">Needs review</option>
                    <option value="resolved">Resolved</option>
                    <option value="ignored">Ignored</option>
                    <option value="all">All</option>
                </select>
            </div>
            <span class="text-muted small">Open reviews are held outside the games table until assigned.</span>
            <button type="button" class="btn btn-outline-primary" @onclick="ReprocessMappedReviewsAsync" disabled="@isBusy" title="Recheck games whose competition was already mapped">
                Recheck mapped competitions
            </button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageCss" role="alert">@message</div>
    }

    @if (reviews is null)
    {
        <p><em>Loading current-results reviews...</em></p>
    }
    else if (reviews.Count == 0)
    {
        <div class="alert alert-success">No current-results reviews match this filter.</div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var review in reviews)
            {
                var isOpen = review.Status == CurrentResultReviewStatuses.Open;
                var isExpanded = expandedReviewId == review.Id;
                var cyclePending = review.Reason == CurrentResultReviewReasons.TournamentCycleConfirmationRequired;
                <article class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="text-muted small">@review.SourceDate.ToString("yyyy-MM-dd") · @review.CompetitionName · @review.Reason</div>
                                <h2 class="h5 mb-1">@review.HomeTeamName <span class="text-muted">vs</span> @review.AwayTeamName</h2>
                                <div class="small">@review.ResultStatus · @FormatScore(review) · @review.GameDateTimeUtc.ToLocalTime().ToString("g")</div>
                                @if (!string.IsNullOrWhiteSpace(review.SourceUrl))
                                {
                                    <a class="small" href="@review.SourceUrl" target="_blank" rel="noreferrer">Open Livescore source</a>
                                }
                                @if (isOpen && NeedsTeamMapping(review, "home"))
                                {
                                    var homePicker = GetTeamPicker(review.Id, "home", review.HomeTeamName);
                                    <div class="review-team-mapper mt-3">
                                        <div class="d-flex align-items-center justify-content-between gap-2">
                                            <span><strong>Home team:</strong> @review.HomeTeamName</span>
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ToggleHomeTeamPickerAsync(review)" disabled="@isBusy">
                                                @(homePicker.IsOpen ? "Hide suggestions" : "Map home team")
                                            </button>
                                        </div>
                                        @if (homePicker.IsOpen)
                                        {
                                            <div class="d-flex gap-2 mt-2">
                                                <input class="form-control form-control-sm" @bind="homePicker.Search" placeholder="Search canonical teams..." />
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SearchHomeTeamCandidatesAsync(review.Id, homePicker.Search)" disabled="@isBusy">Search</button>
                                            </div>
                                            @if (homePicker.Candidates.Count > 0)
                                            {
                                                <div class="list-group list-group-sm mt-2">
                                                    @foreach (var candidate in homePicker.Candidates)
                                                    {
                                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" @onclick="() => MapHomeTeamAsync(review.Id, candidate)">
                                                            <span><strong>@candidate.CanonicalName</strong> <small class="text-muted">@candidate.CountryCode · @candidate.MatchScore% · @candidate.MatchReason</small></span>
                                                            <span class="btn btn-sm btn-success">Use this team</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted small mt-2 mb-0">No suggestions found. Try a shorter name or a different spelling.</p>
                                            }
                                            <div class="mt-3">
                                                <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => ToggleHomeCreateTeam(review)" disabled="@isBusy">
                                                    @(homePicker.IsCreating ? "Cancel new team" : "Create new canonical team")
                                                </button>
                                                @if (homePicker.IsCreating)
                                                {
                                                    <div class="row g-2 mt-2 align-items-end">
                                                        <div class="col-md-6">
                                                            <label class="form-label small" for="home-team-name-@review.Id">Canonical team name</label>
                                                            <input id="home-team-name-@review.Id" class="form-control form-control-sm" @bind="homePicker.NewCanonicalName" placeholder="Canonical team name" />
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small" for="home-team-country-@review.Id">Country</label>
                                                            <select id="home-team-country-@review.Id" class="form-select form-select-sm" @bind="homePicker.NewCountryCode">
                                                                @foreach (var country in GetTeamCountryOptions(homePicker))
                                                                {
                                                                    <option value="@country.Code">@country.Name [@country.Code]</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <button type="button" class="btn btn-sm btn-warning w-100" @onclick="() => CreateHomeTeamAsync(review.Id, homePicker.NewCanonicalName, homePicker.NewCountryCode)" disabled="@isBusy">Create and use</button>
                                                        </div>
                                                    </div>
                                                    <small class="text-muted">Country defaults to the competition. Use this only when the club is genuinely new, not merely new to this division.</small>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (isOpen && NeedsTeamMapping(review, "away"))
                                {
                                    var awayPicker = GetTeamPicker(review.Id, "away", review.AwayTeamName);
                                    <div class="review-team-mapper mt-2">
                                        <div class="d-flex align-items-center justify-content-between gap-2">
                                            <span><strong>Away team:</strong> @review.AwayTeamName</span>
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ToggleAwayTeamPickerAsync(review)" disabled="@isBusy">
                                                @(awayPicker.IsOpen ? "Hide suggestions" : "Map away team")
                                            </button>
                                        </div>
                                        @if (awayPicker.IsOpen)
                                        {
                                            <div class="d-flex gap-2 mt-2">
                                                <input class="form-control form-control-sm" @bind="awayPicker.Search" placeholder="Search canonical teams..." />
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SearchAwayTeamCandidatesAsync(review.Id, awayPicker.Search)" disabled="@isBusy">Search</button>
                                            </div>
                                            @if (awayPicker.Candidates.Count > 0)
                                            {
                                                <div class="list-group list-group-sm mt-2">
                                                    @foreach (var candidate in awayPicker.Candidates)
                                                    {
                                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" @onclick="() => MapAwayTeamAsync(review.Id, candidate)">
                                                            <span><strong>@candidate.CanonicalName</strong> <small class="text-muted">@candidate.CountryCode · @candidate.MatchScore% · @candidate.MatchReason</small></span>
                                                            <span class="btn btn-sm btn-success">Use this team</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted small mt-2 mb-0">No suggestions found. Try a shorter name or a different spelling.</p>
                                            }
                                            <div class="mt-3">
                                                <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => ToggleAwayCreateTeam(review)" disabled="@isBusy">
                                                    @(awayPicker.IsCreating ? "Cancel new team" : "Create new canonical team")
                                                </button>
                                                @if (awayPicker.IsCreating)
                                                {
                                                    <div class="row g-2 mt-2 align-items-end">
                                                        <div class="col-md-6">
                                                            <label class="form-label small" for="away-team-name-@review.Id">Canonical team name</label>
                                                            <input id="away-team-name-@review.Id" class="form-control form-control-sm" @bind="awayPicker.NewCanonicalName" placeholder="Canonical team name" />
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small" for="away-team-country-@review.Id">Country</label>
                                                            <select id="away-team-country-@review.Id" class="form-select form-select-sm" @bind="awayPicker.NewCountryCode">
                                                                @foreach (var country in GetTeamCountryOptions(awayPicker))
                                                                {
                                                                    <option value="@country.Code">@country.Name [@country.Code]</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <button type="button" class="btn btn-sm btn-warning w-100" @onclick="() => CreateAwayTeamAsync(review.Id, awayPicker.NewCanonicalName, awayPicker.NewCountryCode)" disabled="@isBusy">Create and use</button>
                                                        </div>
                                                    </div>
                                                    <small class="text-muted">Country defaults to the competition. Use this only when the club is genuinely new, not merely new to this division.</small>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <span class="badge @(isOpen ? "text-bg-warning" : review.Status == CurrentResultReviewStatuses.Resolved ? "text-bg-success" : "text-bg-secondary")">@review.Status</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(review.ResolutionNote))
                        {
                            <p class="text-muted small mt-2 mb-0">Note: @review.ResolutionNote</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(review.TournamentCycleKey))
                        {
                            <p class="small mt-2 mb-0">Tournament cycle: <strong>@review.TournamentCycleKey</strong></p>
                        }

                        @if (isOpen)
                        {
                            @if (cyclePending)
                            {
                                <div class="alert alert-warning mt-3 mb-2">Tournament cycle confirmation is required before this game can become Elo-eligible. Confirm it through the official tournament ingestion, then refresh this queue.</div>
                            }
                            <div class="d-flex gap-2 mt-3">
                                @if (!cyclePending)
                                {
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => ToggleMatchesAsync(review.Id)" disabled="@isBusy">
                                        @(isExpanded ? "Hide planned matches" : "Choose planned match")
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => IgnoreAsync(review.Id)" disabled="@isBusy">Ignore</button>
                            </div>
                        }

                        @if (isExpanded)
                        {
                            <div class="mt-3 border-top pt-3">
                                @if (!matchesByReview.TryGetValue(review.Id, out var matches))
                                {
                                    <p class="text-muted mb-0">Loading planned matches...</p>
                                }
                                else if (matches.Count == 0)
                                {
                                    <p class="text-muted mb-0">No scheduled games were found within 36 hours. Leave this review open until the planned source is available, or ignore it.</p>
                                }
                                else
                                {
                                    <p class="small text-muted">Select the canonical planned fixture. The Livescore score/status will be applied while the planned source identity is preserved.</p>
                                    <div class="list-group">
                                        @foreach (var match in matches)
                                        {
                                            var selected = selectedGameByReview.TryGetValue(review.Id, out var selectedGame) && selectedGame == match.GameId;
                                            <button type="button" class="list-group-item list-group-item-action @(selected ? "active" : string.Empty)" @onclick="() => SelectMatch(review.Id, match.GameId)">
                                                <div class="d-flex justify-content-between gap-3">
                                                    <strong>@match.HomeTeamName <span class="fw-normal">vs</span> @match.AwayTeamName</strong>
                                                    <span>@match.GameDateTimeUtc.ToLocalTime().ToString("g")</span>
                                                </div>
                                                <div class="small">@match.CompetitionName · @match.Season · @(match.TournamentCycleKey ?? "no tournament cycle") · @match.Source:@match.SourceGameId</div>
                                            </button>
                                        }
                                    </div>
                                    <div class="d-flex gap-2 mt-3">
                                        <button type="button" class="btn btn-success" @onclick="() => AssignAsync(review.Id)" disabled="@(!selectedGameByReview.ContainsKey(review.Id) || isBusy)">Assign selected match</button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => Collapse(review.Id)">Cancel</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }

    <section class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <p class="eyebrow">Last 10 days</p>
                    <h2 class="h4 mb-1">Livescore team mappings</h2>
                    <p class="text-muted mb-0">Recently added provider identities and the canonical teams they now represent.</p>
                </div>
                <span class="badge text-bg-secondary">@(recentTeamMappings?.Count ?? 0) mappings</span>
            </div>
            @if (recentTeamMappings is null)
            {
                <p class="text-muted mb-0">Loading recent mappings...</p>
            }
            else if (recentTeamMappings.Count == 0)
            {
                <p class="text-muted mb-0">No recorded Livescore team mappings during the last 10 days.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th>Mapped</th><th>Livescore name</th><th>Canonical team</th><th>Confidence</th><th>Decision</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var mapping in recentTeamMappings)
                            {
                                <tr>
                                    <td>@mapping.MappedAtUtc.ToLocalTime().ToString("g")</td>
                                    <td>@mapping.ObservedName</td>
                                    <td><strong>@mapping.CanonicalName</strong> <small class="text-muted">@mapping.CountryCode</small></td>
                                    <td><span class="badge @ConfidenceBadge(mapping.Confidence)">@FormatConfidence(mapping.Confidence)</span></td>
                                    <td>@MappingMethodLabel(mapping.MappingMethod)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private IReadOnlyList<CurrentResultReviewDto>? reviews;
    private IReadOnlyList<CurrentResultTeamMappingHistoryDto>? recentTeamMappings;
    private IReadOnlyList<CurrentResultsUnmatchedCompetitionDto>? unmatchedCompetitions;
    private IReadOnlyList<CompetitionAdminOption>? competitionOptions;
    private IReadOnlyList<TeamAdminCountryOption> teamCountryOptions = [];
    private IReadOnlyList<CurrentResultsTournamentCycleOption>? tournamentCycleOptions;
    private IReadOnlyList<string>? tournamentCycleFamilies;
    private int? openReviewCount;
    private readonly Dictionary<Guid, IReadOnlyList<CurrentResultReviewMatchDto>> matchesByReview = [];
    private readonly Dictionary<Guid, Guid> selectedGameByReview = [];
    private readonly Dictionary<string, TeamPickerState> teamPickers = [];
    private readonly Dictionary<string, UnmatchedSelection> unmatchedSelections = [];
    private Guid? expandedReviewId;
    private string statusFilter = CurrentResultReviewStatuses.Open;
    private string? message;
    private string messageCss = "alert-info";
    private bool isBusy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isBusy = true;
        message = null;
        try
        {
            var query = statusFilter == "all" ? "" : $"?status={Uri.EscapeDataString(statusFilter)}";
            reviews = await Http.GetFromJsonAsync<IReadOnlyList<CurrentResultReviewDto>>($"api/current-results/reviews{query}") ?? [];
            recentTeamMappings = await Http.GetFromJsonAsync<IReadOnlyList<CurrentResultTeamMappingHistoryDto>>("api/current-results/team-mappings?days=10") ?? [];
            try
            {
                openReviewCount = await Http.GetFromJsonAsync<int>("api/current-results/reviews/count");
            }
            catch
            {
                openReviewCount = null;
            }
            unmatchedCompetitions = await Http.GetFromJsonAsync<IReadOnlyList<CurrentResultsUnmatchedCompetitionDto>>("api/current-results/reviews/unmatched-competitions") ?? [];
            competitionOptions = await Http.GetFromJsonAsync<IReadOnlyList<CompetitionAdminOption>>("api/admin/competitions/options") ?? [];
            var teamResponse = await Http.GetFromJsonAsync<TeamAdminListResponse>("api/admin/teams?page=1&pageSize=1");
            teamCountryOptions = teamResponse?.Countries ?? [];
            var cycleResponse = await Http.GetFromJsonAsync<CurrentResultsTournamentCycleOptionsResponse>("api/current-results/tournament-cycles");
            tournamentCycleOptions = cycleResponse?.Cycles ?? [];
            tournamentCycleFamilies = cycleResponse?.Families ?? [];
            unmatchedSelections.Clear();
            matchesByReview.Clear();
            selectedGameByReview.Clear();
            teamPickers.Clear();
            expandedReviewId = null;
        }
        catch (Exception exception)
        {
            SetMessage($"Could not load current-results reviews: {exception.Message}", "alert-danger");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ToggleMatchesAsync(Guid reviewId)
    {
        if (expandedReviewId == reviewId)
        {
            expandedReviewId = null;
            return;
        }

        expandedReviewId = reviewId;
        if (matchesByReview.ContainsKey(reviewId)) return;

        try
        {
            matchesByReview[reviewId] = await Http.GetFromJsonAsync<IReadOnlyList<CurrentResultReviewMatchDto>>($"api/current-results/reviews/{reviewId}/matches") ?? [];
        }
        catch (Exception exception)
        {
            SetMessage($"Could not load planned matches: {exception.Message}", "alert-danger");
        }
    }

    private void SelectMatch(Guid reviewId, Guid gameId) => selectedGameByReview[reviewId] = gameId;

    private static bool NeedsTeamMapping(CurrentResultReviewDto review, string side)
    {
        var reason = review.Reason.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return side == "home"
            ? reason.Contains(CurrentResultReviewReasons.UnresolvedHomeTeam) || reason.Contains(CurrentResultReviewReasons.AmbiguousHomeTeam)
            : reason.Contains(CurrentResultReviewReasons.UnresolvedAwayTeam) || reason.Contains(CurrentResultReviewReasons.AmbiguousAwayTeam);
    }

    private TeamPickerState GetTeamPicker(Guid reviewId, string side, string observedName, string? competitionCountryCode = null)
    {
        var key = TeamPickerKey(reviewId, side);
        if (!teamPickers.TryGetValue(key, out var state))
        {
            state = new TeamPickerState
            {
                Search = observedName,
                NewCountryCode = CountryCodeCatalog.Normalize(competitionCountryCode) ?? string.Empty
            };
            teamPickers[key] = state;
        }

        return state;
    }

    private async Task ToggleTeamPickerAsync(Guid reviewId, string side, string observedName, string? competitionCountryCode)
    {
        var state = GetTeamPicker(reviewId, side, observedName, competitionCountryCode);
        state.IsOpen = !state.IsOpen;
        if (state.IsOpen && state.Candidates.Count == 0)
        {
            await SearchTeamCandidatesAsync(reviewId, side, state.Search);
        }
    }

    private Task ToggleHomeTeamPickerAsync(CurrentResultReviewDto review) => ToggleTeamPickerAsync(review.Id, "home", review.HomeTeamName, review.SuggestedCompetitionCountryCode);

    private Task ToggleAwayTeamPickerAsync(CurrentResultReviewDto review) => ToggleTeamPickerAsync(review.Id, "away", review.AwayTeamName, review.SuggestedCompetitionCountryCode);

    private Task SearchHomeTeamCandidatesAsync(Guid reviewId, string search) => SearchTeamCandidatesAsync(reviewId, "home", search);

    private Task SearchAwayTeamCandidatesAsync(Guid reviewId, string search) => SearchTeamCandidatesAsync(reviewId, "away", search);

    private Task MapHomeTeamAsync(Guid reviewId, CurrentResultReviewTeamCandidateDto candidate) => MapTeamAsync(reviewId, "home", candidate);

    private Task MapAwayTeamAsync(Guid reviewId, CurrentResultReviewTeamCandidateDto candidate) => MapTeamAsync(reviewId, "away", candidate);

    private void ToggleHomeCreateTeam(CurrentResultReviewDto review) => ToggleCreateTeam(review.Id, "home", review.HomeTeamName, review.SuggestedCompetitionCountryCode);

    private void ToggleAwayCreateTeam(CurrentResultReviewDto review) => ToggleCreateTeam(review.Id, "away", review.AwayTeamName, review.SuggestedCompetitionCountryCode);

    private void ToggleCreateTeam(Guid reviewId, string side, string observedName, string? competitionCountryCode)
    {
        var state = GetTeamPicker(reviewId, side, observedName, competitionCountryCode);
        state.IsCreating = !state.IsCreating;
        if (state.IsCreating && string.IsNullOrWhiteSpace(state.NewCanonicalName))
        {
            state.NewCanonicalName = observedName;
        }
    }

    private Task CreateHomeTeamAsync(Guid reviewId, string canonicalName, string countryCode) => CreateTeamAsync(reviewId, "home", canonicalName, countryCode);

    private Task CreateAwayTeamAsync(Guid reviewId, string canonicalName, string countryCode) => CreateTeamAsync(reviewId, "away", canonicalName, countryCode);

    private async Task CreateTeamAsync(Guid reviewId, string side, string canonicalName, string countryCode)
    {
        isBusy = true;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/current-results/reviews/{reviewId}/create-team",
                new CurrentResultReviewTeamCreateRequest(side, canonicalName, countryCode));
            if (!response.IsSuccessStatusCode)
            {
                SetMessage(await response.Content.ReadAsStringAsync(), "alert-danger");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<CurrentResultReviewTeamMappingDto>();
            var successMessage = result?.Message ?? $"Created and mapped {canonicalName}.";
            await LoadAsync();
            SetMessage(successMessage, "alert-success");
        }
        catch (Exception exception)
        {
            SetMessage($"Could not create team: {exception.Message}", "alert-danger");
        }
        finally
        {
            isBusy = false;
        }
    }

    private IReadOnlyList<TeamAdminCountryOption> GetTeamCountryOptions(TeamPickerState picker)
    {
        var countries = (teamCountryOptions ?? []).ToDictionary(x => x.Code, StringComparer.OrdinalIgnoreCase);
        if (!countries.ContainsKey("UNK"))
        {
            countries["UNK"] = new TeamAdminCountryOption("UNK", "Unknown / unset", 0);
        }

        var selectedCode = CountryCodeCatalog.Normalize(picker.NewCountryCode);
        if (!string.IsNullOrWhiteSpace(selectedCode) && !countries.ContainsKey(selectedCode))
        {
            var displayName = CountryCodeCatalog.DisplayName(selectedCode);
            countries[selectedCode] = new TeamAdminCountryOption(
                selectedCode,
                string.IsNullOrWhiteSpace(displayName) ? selectedCode : displayName,
                0);
        }

        if (string.IsNullOrWhiteSpace(picker.NewCountryCode))
        {
            countries[string.Empty] = new TeamAdminCountryOption(string.Empty, "Use competition country", 0);
        }

        return countries.Values.OrderBy(x => x.Name).ThenBy(x => x.Code).ToList();
    }

    private async Task SearchTeamCandidatesAsync(Guid reviewId, string side, string? search)
    {
        var state = GetTeamPicker(reviewId, side, search ?? string.Empty);
        state.IsOpen = true;
        isBusy = true;
        try
        {
            var query = string.IsNullOrWhiteSpace(search) ? string.Empty : $"&search={Uri.EscapeDataString(search.Trim())}";
            state.Candidates = await Http.GetFromJsonAsync<IReadOnlyList<CurrentResultReviewTeamCandidateDto>>(
                $"api/current-results/reviews/{reviewId}/team-candidates?side={side}{query}") ?? [];
        }
        catch (Exception exception)
        {
            SetMessage($"Could not search canonical teams: {exception.Message}", "alert-danger");
        }
        finally
        {
            isBusy = false;
        }
    }

