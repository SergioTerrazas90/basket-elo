@page "/data-sources"
@using BasketElo.Domain.Backfill
@using BasketElo.Domain.Elo
@using BasketElo.Infrastructure.Backfill

<SeoHead Title='@T["SourcesSeoTitle"]'
         Description='@T["SourcesSeoDescription"]'
         CanonicalPath="/data-sources"
         SchemaType="Dataset" />

<div class="data-sources-page info-page">
    <header class="info-hero be-reveal" style="--reveal-order: 0">
        <div class="info-hero-copy">
            <p class="info-kicker">@T["Sources"]</p>
            <h1>@T["SourcesHeroTitle"]</h1>
            <p class="info-lede">@T["SourcesHeroText"]</p>
        </div>
        <dl class="info-facts" aria-label='@T["CatalogSummary"]'>
            <div><dt>@T["FibaCompetitions"]</dt><dd>@FibaCompetitionCount</dd></div>
            <div><dt>@T["ClubAndDomestic"]</dt><dd>@ClubCompetitionCount</dd></div>
            <div><dt>@T["SourcePaths"]</dt><dd>@SourceCount</dd></div>
        </dl>
    </header>

    <aside class="info-note be-reveal" style="--reveal-order: 1" aria-label='@T["CoverageNote"]'>
        <strong>@T["CoverageNotCompleteness"]</strong>
        <span>@T["CoverageNoteText"]</span>
    </aside>

    <details class="source-catalog-group fiba-catalog be-reveal" style="--reveal-order: 2" open>
        <summary class="source-catalog-summary">
            <span class="info-kicker">@T["International"]</span>
            <span><strong>@T["FibaCompetitions"]</strong><small>@T["WorldAndContinentalTeams"]</small></span>
            <span class="source-catalog-count">@FibaCompetitionCount @T["CompetitionsLower"]</span>
            <span class="source-catalog-toggle" aria-hidden="true"></span>
        </summary>

        <div class="source-catalog-body fiba-region-grid">
            @for (var regionIndex = 0; regionIndex < fibaRegions.Count; regionIndex++)
            {
                var region = fibaRegions[regionIndex];
                <article class="fiba-region-card" id="fiba-@region.Slug">
                    <header>
                        <span class="source-region-index">@((regionIndex + 1).ToString("00"))</span>
                        <div><h3>@RegionLabel(region.Name)</h3><p>@RegionDescription(region.Name)</p></div>
                        <span>@region.Leagues.Count</span>
                    </header>
                    <div class="fiba-competition-list">
                        @foreach (var league in region.Leagues)
                        {
                            <details class="fiba-competition">
                                <summary>
                                    <strong>@league.LeagueName</strong>
                                    <span class="source-region-toggle" aria-hidden="true"></span>
                                </summary>
                                <div class="fiba-competition-sources">
                                    @foreach (var source in league.Sources)
                                    {
                                        <div class="data-source-row">
                                            <div class="data-source-provider">
                                                <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Name</a>
                                                <span>@source.CoverageLabel</span>
                                            </div>
                                            <div class="data-source-seasons">
                                                <span class="data-source-label">@T["SeasonsAccountedFor"]</span>
                                                <p>@string.Join(", ", source.Seasons)</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                </article>
            }
        </div>
    </details>

    <details class="source-catalog-group data-source-list be-reveal" style="--reveal-order: 3">
        <summary class="source-catalog-summary">
            <span class="info-kicker">@T["ClubBasketball"]</span>
            <span><strong>@T["ClubAndDomesticSources"]</strong><small>@T["ClubSourcesDescription"]</small></span>
            <span class="source-catalog-count">@ClubCompetitionCount @T["CompetitionsLower"]</span>
            <span class="source-catalog-toggle" aria-hidden="true"></span>
        </summary>

        <div class="source-catalog-body">
            @for (var regionIndex = 0; regionIndex < clubRegions.Count; regionIndex++)
            {
                var region = clubRegions[regionIndex];
                <details class="data-source-region">
                <summary id="club-@region.Slug">
                    <span class="source-region-index">@((regionIndex + 1).ToString("00"))</span>
                    <strong>@RegionLabel(region.Name)</strong>
                    <span>@region.Leagues.Count @(region.Leagues.Count == 1 ? T["CompetitionLower"] : T["CompetitionsLower"])</span>
                    <span class="source-region-toggle" aria-hidden="true"></span>
                </summary>
                <div class="data-source-region-list">
                    @foreach (var league in region.Leagues)
                    {
                        <article class="data-source-entry">
                            <div class="data-source-heading">
                                <h3>@league.LeagueName</h3>
                                <span class="data-source-pool">@PoolLabel(league.EloPoolKey)</span>
                            </div>

                            <div class="data-source-rows">
                                @foreach (var source in league.Sources)
                                {
                                    <div class="data-source-row">
                                        <div class="data-source-provider">
                                            <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Name</a>
                                            <span>@source.CoverageLabel</span>
                                        </div>
                                        <div class="data-source-seasons">
                                            <span class="data-source-label">@T["SeasonsAccountedFor"]</span>
                                            <p>@string.Join(", ", source.Seasons)</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
                </details>
            }
        </div>
    </details>
</div>

@code {
    private IReadOnlyList<RegionView> fibaRegions = [];
    private IReadOnlyList<RegionView> clubRegions = [];

    private int FibaCompetitionCount => fibaRegions.Sum(region => region.Leagues.Count);
    private int ClubCompetitionCount => clubRegions.Sum(region => region.Leagues.Count);
    private int SourceCount => AllRegions.Sum(region => region.Leagues.Sum(league => league.Sources.Count));
    private IEnumerable<RegionView> AllRegions => fibaRegions.Concat(clubRegions);

    protected override void OnInitialized()
    {
        var catalog = new BackfillCatalog();
        var allRegions = catalog.GetLeagues()
            .GroupBy(x => new { Country = NormalizeCountry(x.Country), x.LeagueName, x.EloPoolKey })
            .GroupBy(x => x.Key.Country)
            .OrderBy(x => RegionSortOrder(x.Key))
            .ThenBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
            .Select(region => new RegionView(
                region.Key,
                Slug(region.Key),
                region
                    .OrderBy(x => x.Key.LeagueName)
                    .Select(group => new LeagueView(
                        group.Key.LeagueName,
                        group.Key.EloPoolKey,
                        group
                            .OrderBy(x => x.Provider)
                            .ThenBy(x => x.StartSeason)
                            .Select(x => new SourceView(
                                SourceName(x.Provider),
                                SourceUrl(x.Provider),
                                CoverageLabel(x),
                                catalog.GetSeasonsForLeague(x)
                                    .Select(SeasonLabel)
                                    .Distinct(StringComparer.OrdinalIgnoreCase)
                                    .OrderBy(SeasonSortKey)
                                    .ToList()))
                            .ToList()))
                    .ToList()))
            .ToList();

        fibaRegions = FilterRegions(allRegions, league => league.EloPoolKey == EloPoolKeys.NationalTeams);
        clubRegions = FilterRegions(allRegions, league => league.EloPoolKey != EloPoolKeys.NationalTeams);
    }

    private static IReadOnlyList<RegionView> FilterRegions(
        IReadOnlyList<RegionView> regions,
        Func<LeagueView, bool> include)
        => regions
            .Select(region => region with { Leagues = region.Leagues.Where(include).ToList() })
            .Where(region => region.Leagues.Count > 0)
            .ToList();

    private static int RegionSortOrder(string region)
        => region switch
        {
            "World" => 0,
            "Africa" => 1,
            "Americas" => 2,
            "Asia" => 3,
            "Europe" => 4,
            "Oceania" => 5,
            _ => 10
        };

    private string RegionDescription(string region)
        => region switch
        {
            "World" => T["WorldCupAndOlympics"],
            "Africa" => "AfroBasket",
            "Americas" => "AmeriCup",
            "Asia" => "Asia Cup",
            "Europe" => "EuroBasket",
            "Oceania" => T["OceaniaChampionship"],
            _ => T["NationalTeams"]
        };

    private string RegionLabel(string region)
        => region switch
        {
            "World" => T["World"],
            "Africa" => T["Africa"],
            "Americas" => T["Americas"],
            "Asia" => T["Asia"],
            "Europe" => T["Europe"],
            "Oceania" => T["Oceania"],
            "United States" => T["UnitedStates"],
            _ => region
        };

    private static string SeasonLabel(string season)
        => SeasonLabelNormalizer.ToFullSeasonLabel(season);

    private static int SeasonSortKey(string season)
        => SeasonLabelNormalizer.ParseStartYear(season);

    private string PoolLabel(string pool)
        => pool switch
        {
            EloPoolKeys.Nba => "NBA",
            EloPoolKeys.NationalTeams => T["NationalTeams"],
            _ => T["EuropeClubs"]
        };

    private static string NormalizeCountry(string country)
        => string.Equals(country, "USA", StringComparison.OrdinalIgnoreCase) ||
           string.Equals(country, "US", StringComparison.OrdinalIgnoreCase)
            ? "United States"
            : country;

    private string CoverageLabel(ConfiguredBackfillLeague league)
        => league.Provider switch
        {
            FiveThirtyEightBasketballDataProvider.Source => T["PinnedArchive"],
            ApiSportsBasketballDataProvider.Source => T["LiveHistoricalFeed"],
            FibaBasketballDataProvider.Source => T["OfficialCompetitionHistory"],
            GlobalSportsArchiveBasketballDataProvider.Source => T["HistoricalResultsArchive"],
            _ => T["HistoricalResultsArchive"]
        };

    private static string SourceName(string provider)
        => provider switch
        {
            FiveThirtyEightBasketballDataProvider.Source => "FiveThirtyEight NBA Elo archive",
            ApiSportsBasketballDataProvider.Source => "API Sports Basketball",
            FibaBasketballDataProvider.Source => "FIBA archive",
            GlobalSportsArchiveBasketballDataProvider.Source => "Global Sports Archive",
            "aba-official" => "ABA League official archive",
            "acb-dbasket" => "DBasket historical archive",
            "acb-official-liga-nacional" or "acb-official-tournaments" => "ACB official archive",
            "basketball-database" => "Basketball Database",
            "bbl-wayback" => "Internet Archive",
            "eurobasket-lithuania" => "LKL official archive",
            "euroleagueR" => "EuroLeague historical dataset",
            "flashscore-domestic" or "flashscore-poland-plk" or "flashscore-czech-nbl" => "Flashscore archive",
            "french-historical" => "French Basketball Archives",
            "german-official" => "German Basketball League archive",
            "greek-official" => "Greek Basketball League archive",
            "official-israel-basket" => "Israel Basketball Association archive",
            "lba-official" => "Lega Basket official archive",
            "serbian-historical" => "Serbian basketball historical archive",
            "turkish-historical" => "Turkish Basketball Federation archive",
            _ when provider.StartsWith("wikipedia", StringComparison.OrdinalIgnoreCase) => "Wikipedia",
            _ => "Historical basketball archive"
        };

    private static string SourceUrl(string provider)
        => provider switch
        {
            FiveThirtyEightBasketballDataProvider.Source => "https://github.com/fivethirtyeight/data/blob/4c1ff5e3aef1816ae04af63218015066e186c147/nba-elo/nbaallelo.csv",
            ApiSportsBasketballDataProvider.Source => "https://api-sports.io/sports/basketball",
            FibaBasketballDataProvider.Source => "https://www.fiba.basketball/",
            GlobalSportsArchiveBasketballDataProvider.Source => "https://globalsportsarchive.com/",
            "aba-official" => "https://www.aba-liga.com/",
            "acb-dbasket" => "https://dbasket.net/",
            "acb-official-liga-nacional" or "acb-official-tournaments" => "https://www.acb.com/",
            "basketball-database" => "https://basketball-database.com/",
            "bbl-wayback" => "https://web.archive.org/",
            "eurobasket-lithuania" => "https://lkl.lt/",
            "euroleagueR" => "https://github.com/JaseZiv/euroleagueR_data",
            "flashscore-domestic" or "flashscore-poland-plk" or "flashscore-czech-nbl" => "https://www.flashscore.com/basketball/",
            "french-historical" => "https://www.basketarchives.fr/",
            "german-official" => "https://www.easycredit-bbl.de/",
            "greek-official" => "https://www.esake.gr/",
            "official-israel-basket" => "https://basket.co.il/",
            "lba-official" => "https://www.legabasket.it/",
            "serbian-historical" => "https://kls.rs/",
            "turkish-historical" => "https://www.tbf.org.tr/",
            _ when provider.StartsWith("wikipedia", StringComparison.OrdinalIgnoreCase) => "https://www.wikipedia.org/",
            _ => "https://www.google.com/search?q=" + Uri.EscapeDataString(provider + " basketball archive")
        };

    private static string Slug(string value)
        => new string(value.Where(char.IsLetterOrDigit).Select(char.ToLowerInvariant).ToArray());

    private sealed record RegionView(
        string Name,
        string Slug,
        IReadOnlyList<LeagueView> Leagues);

    private sealed record LeagueView(
        string LeagueName,
        string EloPoolKey,
        IReadOnlyList<SourceView> Sources);

    private sealed record SourceView(
        string Name,
        string Url,
        string CoverageLabel,
        IReadOnlyList<string> Seasons);
}
