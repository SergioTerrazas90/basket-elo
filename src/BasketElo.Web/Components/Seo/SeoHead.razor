@using System.Text.Json
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <meta name="robots" content="@RobotsContent" />
    <meta name="author" content="BasketElo" />
    <link rel="canonical" href="@CanonicalUrl" />

    <meta property="og:site_name" content="BasketElo" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@CanonicalUrl" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@Title" />
    <meta name="twitter:description" content="@Description" />

    <script type="application/ld+json">@((MarkupString)StructuredDataJson)</script>
</HeadContent>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string? CanonicalPath { get; set; }

    [Parameter]
    public bool NoIndex { get; set; }

    [Parameter]
    public string SchemaType { get; set; } = "WebPage";

    private string RobotsContent => NoIndex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

    private string SiteRoot
    {
        get
        {
            var configuredUrl = Configuration["Seo:SiteUrl"]?.Trim();
            var root = string.IsNullOrWhiteSpace(configuredUrl)
                ? Navigation.BaseUri
                : configuredUrl;
            return root.TrimEnd('/') + "/";
        }
    }

    private string CanonicalUrl
    {
        get
        {
            var path = CanonicalPath;
            if (string.IsNullOrWhiteSpace(path))
            {
                path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            }

            return new Uri(new Uri(SiteRoot), path.TrimStart('/')).AbsoluteUri;
        }
    }

    private string StructuredDataJson
    {
        get
        {
            var siteId = SiteRoot + "#website";
            var page = new Dictionary<string, object?>
            {
                ["@type"] = SchemaType,
                ["@id"] = CanonicalUrl + "#webpage",
                ["url"] = CanonicalUrl,
                ["name"] = Title,
                ["description"] = Description,
                ["inLanguage"] = "en",
                ["isPartOf"] = new Dictionary<string, object?> { ["@id"] = siteId }
            };

            var graph = new List<object>
            {
                new Dictionary<string, object?>
                {
                    ["@type"] = "WebSite",
                    ["@id"] = siteId,
                    ["url"] = SiteRoot,
                    ["name"] = "BasketElo",
                    ["alternateName"] = "Basket ELO",
                    ["description"] = "Transparent basketball ELO rankings for NBA, European club, and national teams.",
                    ["inLanguage"] = "en"
                },
                page
            };

            return JsonSerializer.Serialize(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@graph"] = graph
            });
        }
    }
}
