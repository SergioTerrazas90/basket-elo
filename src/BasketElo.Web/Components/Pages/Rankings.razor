    private async Task RefreshAsync(
        CancellationToken cancellationToken = default,
        long? expectedTeamSearchVersion = null,
        string? expectedTeamSearch = null)
    {
        if (!IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
        {
            return;
        }

        isBusy = true;
        errorMessage = null;

        try
        {
            cancellationToken.ThrowIfCancellationRequested();
            var rankingsUri = BuildApiUri();
            var cacheKey = BuildRankingsClientCacheKey(rankingsUri);
            if (rankingsClientCache.TryGetValue(cacheKey, out var cachedEntry))
            {
                if (!IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
                {
                    return;
                }

                RestoreRankingsCacheEntry(cacheKey, cachedEntry);
                return;
            }

            if (response is null ||
                !string.Equals(rankingsUri, lastRankingsApiUri, StringComparison.Ordinal))
            {
                var fetchedResponse = await Http.GetFromJsonAsync<EloRankingsResponse>(rankingsUri, cancellationToken);
                if (!IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
                {
                    return;
                }

                response = fetchedResponse;
                lastRankingsApiUri = rankingsUri;
            }

            if (response is not null)
            {
                page = response.Page;
                requestedPage = response.Page;
            }

            if (selectedView == "movers")
            {
                var moversUri = BuildMoversApiUri();
                if (movers is null || !string.Equals(moversUri, lastMoversApiUri, StringComparison.Ordinal))
                {
                    var fetchedMovers = await Http.GetFromJsonAsync<EloMoversResponse>(moversUri, cancellationToken);
                    if (!IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
                    {
                        return;
                    }

                    movers = fetchedMovers;
                    lastMoversApiUri = moversUri;
                }

                if (movers is not null)
                {
                    page = movers.Page;
                    requestedPage = movers.Page;
                }
            }
            else if (selectedView == "results")
            {
                var resultsUri = BuildResultsApiUri();
                if (results is null || !string.Equals(resultsUri, lastResultsApiUri, StringComparison.Ordinal))
                {
                    var fetchedResults = await Http.GetFromJsonAsync<EloResultsResponse>(resultsUri, cancellationToken);
                    if (!IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
                    {
                        return;
                    }

                    results = fetchedResults;
                    lastResultsApiUri = resultsUri;
                }

                if (results is not null)
                {
                    // Results are a single bounded newest-first window; ranking
                    // and mover pagination remains independent.
                    page = 1;
                    requestedPage = 1;
                }
            }
            else if (selectedView == "fixtures")
            {
                var fixturesFromUtc = DateTime.UtcNow;
                var fixturesToUtc = fixturesFromUtc.AddDays(9);
                var upcomingFixturesUri = BuildFixturesApiUri(
                    includeFilters: false,
                    fixturesFromUtc: fixturesFromUtc,
                    fixturesToUtc: fixturesToUtc);
                if (upcomingFixtures is null || !string.Equals(upcomingFixturesUri, lastUpcomingFixturesApiUri, StringComparison.Ordinal))
                {
                    var fetchedUpcomingFixtures = await Http.GetFromJsonAsync<UpcomingGamesResponse>(upcomingFixturesUri, cancellationToken);
                    if (!IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
                    {
                        return;
                    }

                    upcomingFixtures = fetchedUpcomingFixtures;
                    lastUpcomingFixturesApiUri = upcomingFixturesUri;
                }

                var fixturesUri = BuildFixturesApiUri(
                    includeFilters: true,
                    fixturesFromUtc: fixturesFromUtc,
                    fixturesToUtc: fixturesToUtc);
                if (fixtures is null || !string.Equals(fixturesUri, lastFixturesApiUri, StringComparison.Ordinal))
                {
                    var fetchedFixtures = await Http.GetFromJsonAsync<UpcomingGamesResponse>(fixturesUri, cancellationToken);
                    if (!IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
                    {
                        return;
                    }

                    fixtures = fetchedFixtures;
                    lastFixturesApiUri = fixturesUri;
                }

                page = 1;
                requestedPage = 1;
            }
            else
            {
                // Chart data is intentionally deferred until the user opens the chart.
                // The ranking response must remain the first meaningful data surface.
            }

            if (IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
            {
                StoreRankingsCacheEntry(cacheKey);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // A newer team search or navigation replaced this request.
        }
        catch (Exception ex)
        {
            if (IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
            {
                errorMessage = $"Could not load rankings: {ex.Message}";
            }
        }
        finally
        {
            if (IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
            {
                isBusy = false;
            }
        }
    }

    private async Task LoadResultExplanationAsync(Guid gameId)
    {
        selectedResultExplanationGameId = gameId;
        selectedResultExplanation = null;
        resultExplanationError = null;
        isResultExplanationLoading = true;

        try
        {
            var rulesetVersion = results?.RulesetVersion ?? response?.RulesetVersion;
            var uri = $"api/elo/games/{gameId}/explanation";
            if (!string.IsNullOrWhiteSpace(rulesetVersion))
            {
                uri += $"?rulesetVersion={Uri.EscapeDataString(rulesetVersion)}";
            }

            using var responseMessage = await Http.GetAsync(uri);
            if (!responseMessage.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(responseMessage));
            }

            selectedResultExplanation = await responseMessage.Content.ReadFromJsonAsync<EloGameExplanationResponse>();
            if (selectedResultExplanation is null)
            {
                throw new InvalidOperationException("The API returned an empty explanation.");
            }
        }
        catch (Exception ex)
        {
            resultExplanationError = $"Could not load ELO explanation: {ex.Message}";
        }
        finally
        {
            isResultExplanationLoading = false;
        }
    }

    private bool IsResultExplanationLoading(Guid gameId)
        => isResultExplanationLoading && selectedResultExplanationGameId == gameId;

    private void CloseResultExplanation()
    {
        selectedResultExplanationGameId = null;
        selectedResultExplanation = null;
        resultExplanationError = null;
        isResultExplanationLoading = false;
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage responseMessage)
    {
        var body = await responseMessage.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(body))
        {
            return responseMessage.ReasonPhrase ?? $"HTTP {(int)responseMessage.StatusCode}";
        }

        try
        {
            using var json = JsonDocument.Parse(body);
            if (json.RootElement.TryGetProperty("detail", out var detail) && detail.ValueKind == JsonValueKind.String)
            {
                return detail.GetString() ?? body;
            }

            if (json.RootElement.TryGetProperty("title", out var title) && title.ValueKind == JsonValueKind.String)
            {
                return title.GetString() ?? body;
            }

            if (json.RootElement.ValueKind == JsonValueKind.String)
            {
                return json.RootElement.GetString() ?? body;
            }
        }
        catch (JsonException)
        {
        }

        return body;
    }

    private RankingsClientCacheKey BuildRankingsClientCacheKey(string rankingsUri)
        => new(
            selectedPool,
            selectedView,
            rankingsUri,
            selectedView == "movers" ? selectedMoverDirection : string.Empty,
            selectedView == "movers" ? selectedWindowDays : 0);

    private void CaptureActiveRankingsCacheEntry()
    {
        if (activeRankingsCacheKey is null ||
            !rankingsClientCache.TryGetValue(activeRankingsCacheKey, out var entry))
        {
            return;
        }

        entry.Rankings = response;
        entry.Movers = movers;
        entry.Results = results;
        entry.Fixtures = fixtures;
        entry.UpcomingFixtures = upcomingFixtures;
        entry.Evolution = evolution;
        entry.FullEvolution = fullEvolution;
        entry.EvolutionRankings = evolutionRankings;
        entry.EvolutionChartSeries = evolutionChartSeries.ToList();
        entry.EvolutionVisibleRatedPointCounts = new(evolutionVisibleRatedPointCounts);
        entry.RankingsApiUri = lastRankingsApiUri;
        entry.MoversApiUri = lastMoversApiUri;
        entry.ResultsApiUri = lastResultsApiUri;
        entry.FixturesApiUri = lastFixturesApiUri;
        entry.UpcomingFixturesApiUri = lastUpcomingFixturesApiUri;
        entry.EvolutionRankingsApiUri = lastEvolutionRankingsApiUri;
        entry.EvolutionApiUri = lastEvolutionApiUri;
        entry.EvolutionDataRevision = evolutionDataRevision;
    }

    private void StoreRankingsCacheEntry(RankingsClientCacheKey cacheKey)
    {
        var entry = rankingsClientCache.TryGetValue(cacheKey, out var existing)
            ? existing
            : new RankingsClientCacheEntry();

        entry.Rankings = response;
        entry.Movers = movers;
        entry.Results = results;
        entry.Fixtures = fixtures;
        entry.UpcomingFixtures = upcomingFixtures;
        entry.Evolution = evolution;
        entry.FullEvolution = fullEvolution;
        entry.EvolutionRankings = evolutionRankings;
        entry.EvolutionChartSeries = evolutionChartSeries.ToList();
        entry.EvolutionVisibleRatedPointCounts = new(evolutionVisibleRatedPointCounts);
        entry.RankingsApiUri = lastRankingsApiUri;
        entry.MoversApiUri = lastMoversApiUri;
        entry.ResultsApiUri = lastResultsApiUri;
        entry.FixturesApiUri = lastFixturesApiUri;
        entry.UpcomingFixturesApiUri = lastUpcomingFixturesApiUri;
        entry.EvolutionRankingsApiUri = lastEvolutionRankingsApiUri;
        entry.EvolutionApiUri = lastEvolutionApiUri;
        entry.EvolutionDataRevision = evolutionDataRevision;

        rankingsClientCache[cacheKey] = entry;
        activeRankingsCacheKey = cacheKey;
    }

    private void RestoreRankingsCacheEntry(
        RankingsClientCacheKey cacheKey,
        RankingsClientCacheEntry entry)
    {
        response = entry.Rankings;
        movers = entry.Movers;
        results = entry.Results;
        fixtures = entry.Fixtures;
        upcomingFixtures = entry.UpcomingFixtures;
        evolution = entry.Evolution;
        fullEvolution = entry.FullEvolution;
        evolutionRankings = entry.EvolutionRankings;
        evolutionChartSeries = entry.EvolutionChartSeries.ToList();
        evolutionVisibleRatedPointCounts.Clear();
        foreach (var item in entry.EvolutionVisibleRatedPointCounts)
        {
            evolutionVisibleRatedPointCounts[item.Key] = item.Value;
        }

        lastRankingsApiUri = entry.RankingsApiUri;
        lastMoversApiUri = entry.MoversApiUri;
        lastResultsApiUri = entry.ResultsApiUri;
        lastFixturesApiUri = entry.FixturesApiUri;
        lastUpcomingFixturesApiUri = entry.UpcomingFixturesApiUri;
        lastEvolutionRankingsApiUri = entry.EvolutionRankingsApiUri;
        lastEvolutionApiUri = entry.EvolutionApiUri;
        evolutionDataRevision = entry.EvolutionDataRevision;
        activeRankingsCacheKey = cacheKey;

        if (response is not null)
        {
            page = response.Page;
            requestedPage = response.Page;
        }
        else if (movers is not null)
        {
            page = movers.Page;
            requestedPage = movers.Page;
        }
        else if (results is not null)
        {
            page = results.Page;
            requestedPage = results.Page;
        }
    }

    private void NavigateToRankings(int targetPage)
    {
        NormalizeSelectedSeasonRange();
        targetPage = ClampRequestedPage(targetPage, CurrentTotalPages);
        page = targetPage;

        Navigation.NavigateTo(BuildRankingsHref(targetPage));
    }

    private static bool IsPageOnlyNavigation(string currentUri, string? previousUri)
        => previousUri is not null &&
           string.Equals(RemovePageParameter(currentUri), RemovePageParameter(previousUri), StringComparison.Ordinal);

    private static bool IsRankingsMoversNavigation(string currentUri, string? previousUri)
        => previousUri is not null &&
           IsRankingsOrMoversPath(currentUri) &&
           IsRankingsOrMoversPath(previousUri);

    private static bool IsRankingsOrMoversPath(string uri)
    {
        var path = new Uri(uri).AbsolutePath.Trim('/');
        return path is "" or "rankings" or "movers";
    }

    private static string RemovePageParameter(string uri)
    {
        var separatorIndex = uri.IndexOf('?');
        if (separatorIndex < 0)
        {
            return uri;
        }

        var queryParts = uri[(separatorIndex + 1)..]
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Where(parameter => !string.Equals(parameter.Split('=', 2)[0], "page", StringComparison.OrdinalIgnoreCase));

        var remainingQuery = string.Join('&', queryParts);
        return remainingQuery.Length == 0 ? uri[..separatorIndex] : $"{uri[..separatorIndex]}?{remainingQuery}";
    }

    private async Task RefreshSelectionAsync(
        int targetPage,
        CancellationToken cancellationToken = default,
        long? expectedTeamSearchVersion = null,
        string? expectedTeamSearch = null)
    {
        if (!IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch))
        {
            return;
        }

        NormalizeSelectedSeasonRange();
        CloseResultExplanation();
        page = ClampRequestedPage(targetPage, CurrentTotalPages);
        requestedPage = page;
        lastRankingsApiUri = null;
        lastMoversApiUri = null;
        lastResultsApiUri = null;
        lastFixturesApiUri = null;
        lastUpcomingFixturesApiUri = null;
        lastEvolutionRankingsApiUri = null;
        lastEvolutionApiUri = null;
        ResetGraphSelection();
        movers = null;
        results = null;
        fixtures = null;
        upcomingFixtures = null;
        evolution = null;
        fullEvolution = null;
        evolutionRankings = null;
        evolutionChartSeries = [];
        isChartVisible = false;
        isChartExpanded = false;
        isChartLoading = IsGraphView;
        CancelEvolutionRefinement();
        try
        {
            await RefreshAsync(cancellationToken, expectedTeamSearchVersion, expectedTeamSearch);
            if (IsCurrentTeamSearchRequest(expectedTeamSearchVersion, expectedTeamSearch) && IsGraphView)
            {
                await LoadChartAsync(force: true);
            }
        }
        finally
        {
            if (!IsGraphView || response is null)
            {
                isChartLoading = false;
            }
        }
    }

    private string BuildRankingsHref(int targetPage, string? targetView = null)
    {
        var requestedView = targetView ?? selectedView;
        var view = string.Equals(requestedView, "movers", StringComparison.OrdinalIgnoreCase)
            ? "movers"
            : requestedView;
        var route = view == "movers" ? "/movers" : "/rankings";
        var targetShowsTeamScope = SupportsTeamScope && view is not ("results" or "fixtures" or "movers");
        var targetShowsSeasonFilter = view is not "fixtures";
        var targetShowsMinimumGamesFilter = view is "rankings" or "graph" or "movers";

        var query = new Dictionary<string, object?>
        {
            ["pool"] = selectedPool == EloPoolKeys.Default ? null : selectedPool,
            ["teams"] = targetShowsTeamScope && selectedTeamScope == EloTeamScopes.Historical
                ? selectedTeamScope
                : null,
            ["movement"] = view == "movers" ? selectedMoverDirection : null,
            ["windowDays"] = view == "movers" && selectedWindowDays != 30 ? selectedWindowDays : null,
            ["ruleset"] = selectedRuleset == EloRulesetVersions.Default ? null : selectedRuleset,
            ["country"] = selectedCountry,
            ["competition"] = selectedCompetition,
            ["fromSeason"] = targetShowsSeasonFilter ? selectedFromSeason : null,
            ["toSeason"] = targetShowsSeasonFilter ? selectedToSeason : null,
            ["minGames"] = targetShowsMinimumGamesFilter && minimumGames > 0 ? minimumGames : null,
            ["team"] = teamSearch,
            ["view"] = view == "rankings" ? null : view,
            ["page"] = targetPage > 1 ? targetPage : null
        };

        return Navigation.GetUriWithQueryParameters(route, query);
    }

    private string BuildPoolHref(string poolKey)
    {
        var targetPool = EloPoolKeys.Normalize(poolKey);
        var targetView = selectedView;
        var route = targetView == "movers" ? "/movers" : "/rankings";
        var query = new Dictionary<string, object?>
        {
            ["pool"] = targetPool == EloPoolKeys.Default ? null : targetPool,
            ["ruleset"] = selectedRuleset == EloRulesetVersions.Default ? null : selectedRuleset,
            ["movement"] = targetView == "movers" ? selectedMoverDirection : null,
            ["windowDays"] = targetView == "movers" && selectedWindowDays != 30 ? selectedWindowDays : null,
            ["view"] = targetView is "rankings" or "movers" ? null : targetView
        };

        return Navigation.GetUriWithQueryParameters(route, query);
    }

    private static int ClampRequestedPage(int value, int totalPages)
        => Math.Clamp(value, 1, Math.Max(1, totalPages));

    private void ApplyLegacyDateRange()
    {
        if (string.IsNullOrWhiteSpace(selectedFromSeason) && From.HasValue)
        {
            selectedFromSeason = GetSeasonLabelForDate(From.Value);
        }

        if (string.IsNullOrWhiteSpace(selectedToSeason) && To.HasValue)
        {
            selectedToSeason = GetSeasonLabelForDate(To.Value);
        }
    }

    private void NormalizeSelectedSeasonRange()
    {
        if (TryParseSeasonStartYear(selectedFromSeason, out var fromYear) &&
            TryParseSeasonStartYear(selectedToSeason, out var toYear) &&
            fromYear > toYear)
        {
            (selectedFromSeason, selectedToSeason) = (selectedToSeason, selectedFromSeason);
        }
    }

    private (DateTime? FromUtc, DateTime? ToUtc, DateTime? AsOfUtc) GetSelectedSeasonDateRange()
    {
        NormalizeSelectedSeasonRange();

        var fromUtc = TryGetSeasonStart(selectedFromSeason, out var seasonStart)
            ? seasonStart
            : (DateTime?)null;
        var toDate = TryGetSeasonEndDate(selectedToSeason, out var seasonEndDate)
            ? seasonEndDate
            : (DateTime?)null;
        var toUtc = NormalizeInclusiveDateEnd(toDate);

        return (fromUtc, toUtc, toDate);
    }

    private static bool TryGetSeasonStart(string? season, out DateTime startUtc)
    {
        startUtc = default;
        if (!TryParseSeasonStartYear(season, out var startYear))
        {
            return false;
        }

        startUtc = new DateTime(startYear, 8, 1, 0, 0, 0, DateTimeKind.Utc);
        return true;
    }

    private static bool TryGetSeasonEndDate(string? season, out DateTime endDateUtc)
    {
        endDateUtc = default;
        if (!TryParseSeasonStartYear(season, out var startYear))
        {
            return false;
        }

        endDateUtc = new DateTime(startYear + 1, 7, 31, 0, 0, 0, DateTimeKind.Utc);
        return true;
    }

    private static bool TryParseSeasonStartYear(string? season, out int startYear)
    {
        startYear = default;
        if (string.IsNullOrWhiteSpace(season))
        {
            return false;
        }

        var parts = season.Split('-', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 2 &&
               int.TryParse(parts[0], NumberStyles.None, CultureInfo.InvariantCulture, out startYear) &&
               int.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var endYear) &&
               endYear == startYear + 1;
    }

    private static string GetSeasonLabelForDate(DateTime value)
    {
        var date = value.Date;
        return date.Month >= 8
            ? $"{date.Year}-{date.Year + 1}"
            : $"{date.Year - 1}-{date.Year}";
    }

    private int CurrentPage => selectedView switch
    {
        "movers" => movers?.Page ?? page,
        "results" => results?.Page ?? page,
        _ => response?.Page ?? page
    };

    private int CurrentTotalPages => selectedView switch
    {
        "movers" => Math.Max(1, movers?.TotalPages ?? 1),
        "results" => Math.Max(1, results?.TotalPages ?? 1),
        _ => Math.Max(1, response?.TotalPages ?? 1)
    };

    private string ResultsContextLabel()
    {
        var currentResults = CurrentResultsResponse;
        if (currentResults is null || currentResults.TotalCount == 0)
        {
            return isBusy
                ? "Loading completed results..."
                : "Completed games matching the current filters, newest first.";
        }

        var shown = VisibleResultRows.Count;
        return shown < currentResults.TotalCount
            ? $"Showing the latest {shown} of {currentResults.TotalCount} matching completed games, newest first."
            : $"Showing all {currentResults.TotalCount} matching completed games, newest first.";
    }

    private EloResultsResponse? CurrentResultsResponse
        => results is not null &&
            string.Equals(lastResultsApiUri, BuildResultsApiUri(), StringComparison.Ordinal)
            ? results
            : null;

    private IReadOnlyCollection<EloResultRow> VisibleResultRows
    {
        get
        {
            var currentResults = CurrentResultsResponse;
            if (currentResults is null || currentResults.Results.Count == 0)
            {
                return [];
            }

            if (string.IsNullOrWhiteSpace(teamSearch))
            {
                return currentResults.Results;
            }

            var searchText = teamSearch.Trim();
            return currentResults.Results
                .Where(row => row.HomeTeam.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    row.AwayTeam.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private bool HasTeamSearch
        => !string.IsNullOrWhiteSpace(teamSearch);

    private bool HasGraphBulkScope
        => !string.IsNullOrWhiteSpace(selectedCountry) || !string.IsNullOrWhiteSpace(selectedCompetition);

    private IReadOnlyList<EloRankingRow> SelectedGraphTeams
        => graphTeamRows
            .Where(row => graphTeamIds.Contains(row.TeamId))
            .OrderBy(row => row.TeamName)
            .ToList();

    private IReadOnlyCollection<Guid> HiddenGraphTeamIds
        => hiddenGraphTeamIds.ToArray();

    private bool IsGraphView
        => selectedView == "graph";

    private int VisibleGraphTeamCount
        => graphTeamIds.Count - hiddenGraphTeamIds.Count(id => graphTeamIds.Contains(id));

    private bool IsGraphTeamVisible(Guid teamId)
        => graphTeamIds.Contains(teamId) && !hiddenGraphTeamIds.Contains(teamId);

    private string GraphTeamColor(Guid teamId)
        => evolutionChartSeries.FirstOrDefault(series => series.TeamId == teamId)?.Color
            ?? "var(--color-border-strong)";

    private bool HasAdvancedFilterValues
        => !string.IsNullOrWhiteSpace(selectedCountry)
            || !string.IsNullOrWhiteSpace(selectedCompetition)
            || (ShowsSeasonFilter && (!string.IsNullOrWhiteSpace(selectedFromSeason)
                || !string.IsNullOrWhiteSpace(selectedToSeason)))
            || (ShowsMinimumGamesFilter && minimumGames > 0);

    private bool HasActiveFilters
        => HasTeamSearch || HasAdvancedFilterValues;

    private bool HasCountryFilter
        => (response?.Filters.Countries.Count ?? 0) > 1 || !string.IsNullOrWhiteSpace(selectedCountry);

    private bool HasCompetitionFilter
        => FilteredCompetitionOptions.Count > 1 ||
            (!string.IsNullOrWhiteSpace(selectedCountry) && FilteredCompetitionOptions.Count > 0) ||
            !string.IsNullOrWhiteSpace(selectedCompetition);

    private IReadOnlyList<EloRankingCompetitionOption> FilteredCompetitionOptions
        => (response?.Filters.Competitions ?? [])
            .Where(option => string.IsNullOrWhiteSpace(selectedCountry) ||
                string.Equals(option.Country, selectedCountry, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private IReadOnlyList<string> FilteredToSeasonOptions
        => (response?.Filters.Seasons ?? [])
            .Where(option => !TryParseSeasonStartYear(selectedFromSeason, out var fromYear) ||
                (TryParseSeasonStartYear(option, out var optionYear) && optionYear >= fromYear))
            .ToList();

    private int ActiveFilterCount
        => (HasTeamSearch ? 1 : 0)
            + (!string.IsNullOrWhiteSpace(selectedCountry) ? 1 : 0)
            + (!string.IsNullOrWhiteSpace(selectedCompetition) ? 1 : 0)
            + (ShowsSeasonFilter && (!string.IsNullOrWhiteSpace(selectedFromSeason) || !string.IsNullOrWhiteSpace(selectedToSeason)) ? 1 : 0)
            + (ShowsMinimumGamesFilter && minimumGames > 0 ? 1 : 0);

