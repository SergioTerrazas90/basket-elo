@page "/"
@page "/rankings"
@page "/movers"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@implements IDisposable
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Caching.Memory
@using Microsoft.AspNetCore.Components.Authorization
@using BasketElo.Domain.Elo
@using BasketElo.Domain.Entities
@using BasketElo.Domain.Games
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PersistentComponentState PersistentState
@inject IMemoryCache PrerenderCache
@inject ILogger<Rankings> Logger

<SeoHead Title="@SeoTitle()"
         Description="@SeoDescription()"
         CanonicalPath="@(selectedView == "movers" ? "/movers" : "/")"
         SchemaType="CollectionPage" />

<div id="rankings-interactive-page" class="rankings-page @(IsGraphView ? "graph-page" : string.Empty)">
    <header class="rankings-header">
        <div class="rankings-page-heading">
            <div>
                <p class="eyebrow">@T["LiveBoard"]</p>
                <h1>@(selectedView == "movers" ? T["MoversTitle"] : T["RankingsTitle"])</h1>
                <p class="rankings-intro">@T["RankingsIntro"]</p>
            </div>
            <a class="rankings-method-note" href="how-it-works" aria-label='@T["ReadRankingsMethod"]'>
                <span class="method-note-mark" aria-hidden="true">↗</span>
                <div>
                    <strong>@T["TransparentSignal"]</strong>
                    <span>@T["TransparentSignalDescription"]</span>
                </div>
            </a>
        </div>

        <div class="rankings-workspace-bar">
            <div class="workspace-navigation">
                <div class="workspace-control workspace-pool-control">
                    <span class="workspace-label" title='@T["Pool"]'>@T["Pool"]</span>
                    <nav class="rating-pool-tabs" aria-label='@T["RatingPools"]'>
                        @foreach (var option in EloPoolCatalog.All.OrderBy(x => x.DisplayOrder))
                        {
                            <a class="@PoolTabClass(option.Key)"
                               href="@BuildPoolHref(option.Key)"
                               data-enhance-nav="true"
                               aria-current="@PoolTabAriaCurrent(option.Key)">
                                @(option.Key == EloPoolKeys.EuropeClubs ? T["Europe"] : option.Key == EloPoolKeys.NationalTeams ? T["NationalTeams"] : option.DisplayName)
                            </a>
                        }
                    </nav>
                </div>

                @if (!IsMoversView)
                {
                    <div class="workspace-control workspace-view-control">
                        <span class="workspace-label">@T["View"]</span>
                        <nav class="rankings-view-tabs" aria-label='@T["RankingViews"]'>
                            <a class='@ViewTabClass("rankings")' href='@BuildRankingsHref(1, "rankings")' data-enhance-nav="true" aria-current='@ViewTabAriaCurrent("rankings")'>@T["Rankings"]</a>
                            <a class='@ViewTabClass("graph")' href='@BuildRankingsHref(1, "graph")' data-enhance-nav="true" aria-current='@ViewTabAriaCurrent("graph")'>@T["Graph"]</a>
                            <a class='@ViewTabClass("fixtures")' href='@BuildRankingsHref(1, "fixtures")' data-enhance-nav="true" aria-current='@ViewTabAriaCurrent("fixtures")'>@T["Fixtures"]</a>
                            <a class='@ViewTabClass("results")' href='@BuildRankingsHref(1, "results")' data-enhance-nav="true" aria-current='@ViewTabAriaCurrent("results")'>@T["Results"]</a>
                        </nav>
                    </div>
                }
            </div>

            <section class="ranking-toolbar" aria-label='@T["RankingControls"]'>
                @if (ShowsTeamScopeFilter)
                {
                    <div class="scope-control-block">
                        <span class="filter-label">@(selectedPool == EloPoolKeys.Nba ? T["Franchises"] : T["Teams"])</span>
                        <div class="franchise-scope-control" role="group" aria-label="@TeamScopeAriaLabel()">
                            <button type="button" class="@TeamScopeClass(EloTeamScopes.Current)" @onclick="() => SelectTeamScopeAsync(EloTeamScopes.Current)" disabled="@isBusy">
                                @T["Current"]
                            </button>
                            <button type="button" class="@TeamScopeClass(EloTeamScopes.Historical)" @onclick="() => SelectTeamScopeAsync(EloTeamScopes.Historical)" disabled="@isBusy">
                                @T["Historical"]
                            </button>
                        </div>
                    </div>
                }

                <div class="filter-field team-search-field">
                    <label for="teamSearch">@T["Team"]</label>
                    <div class="clearable-field">
                        <input id="teamSearch" class="form-control" @bind="teamSearch" @bind:event="oninput" @bind:after="TeamSearchChangedAsync" placeholder='@T["SearchTeams"]' />
                        <button type="button" class="clear-filter" aria-label='@T["ClearTeamSearch"]' title='@T["ClearTeamSearch"]' @onclick="ClearTeamSearch" disabled="@(!HasTeamSearch)">
                            &times;
                        </button>
                    </div>
                </div>

                <button type="button"
                        class="filter-toggle"
                        aria-expanded="@showAdvancedFilters"
                        aria-controls="advanced-ranking-filters"
                        @onclick="ToggleAdvancedFilters">
                    <span>@T["Filters"]</span>
                    @if (ActiveFilterCount > 0)
                    {
                        <span class="filter-count" aria-label="@($"{ActiveFilterCount} active filters")">@ActiveFilterCount</span>
                    }
                    <span class="filter-toggle-icon" aria-hidden="true">@(showAdvancedFilters ? "−" : "+")</span>
                </button>

                @if (HasActiveFilters)
                {
                    <button type="button" class="clear-all-filters" @onclick="ResetFiltersAsync" disabled="@isBusy">
                        @T["ClearAll"]
                    </button>
                }

                @if (response is not null)
                {
                    <div class="toolbar-model-control">
                        <div class="toolbar-model-label">
                            <span>@T["RatingModel"]</span>
                            <span class="snapshot-model-help">
                                <button type="button"
                                        class="snapshot-model-info"
                                        title='@T["AboutRatingModels"]'
                                        aria-label="@(showRulesetHelp ? "Close rating model explanation" : "Explain the rating models")"
                                        aria-expanded="@(showRulesetHelp ? "true" : "false")"
                                        aria-controls="rating-model-help"
                                        @onclick="ToggleRulesetHelp">i</button>
                                @if (showRulesetHelp)
                                {
                                    <span id="rating-model-help" class="snapshot-model-popover" role="note">
                                        <strong>@T["TwoWaysSameGames"]</strong>
                                        <span>@T["RatingModelsDescription"]</span>
                                        <a href="/how-it-works#rulesets-heading">@T["ReadFullMethod"] <span aria-hidden="true">→</span></a>
                                    </span>
                                }
                            </span>
                        </div>
                        <div class="rating-model-switch" role="group" aria-label='@T["RatingModel"]'>
                            @foreach (var ruleset in EloRulesetVersions.All)
                            {
                                <button type="button"
                                        class="rating-model-option @(string.Equals(selectedRuleset, ruleset, StringComparison.Ordinal) ? "is-active" : null)"
                                        aria-pressed="@(string.Equals(selectedRuleset, ruleset, StringComparison.Ordinal) ? "true" : "false")"
                                        title="@RulesetDisplayName(ruleset)"
                                        disabled="@isBusy"
                                        @onclick="() => SelectRulesetAsync(ruleset)">
                                    @RulesetShortName(ruleset)
                                </button>
                            }
                        </div>
                    </div>
                }
            </section>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (HasActiveFilters)
    {
        <div class="active-filters" aria-label='@T["ActiveRankingFilters"]'>
            @if (!string.IsNullOrWhiteSpace(teamSearch))
            {
                <button type="button" class="filter-chip" @onclick="ClearTeamSearch">
                    Team: @teamSearch <span aria-hidden="true">×</span>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(selectedCountry))
            {
                <button type="button" class="filter-chip" @onclick="ClearCountryFilterAsync">
                    Country: @selectedCountry <span aria-hidden="true">×</span>
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(selectedCompetition))
            {
                <button type="button" class="filter-chip" @onclick="ClearCompetitionFilterAsync">
                    Competition: @selectedCompetition <span aria-hidden="true">×</span>
                </button>
            }
            @if (ShowsSeasonFilter && (!string.IsNullOrWhiteSpace(selectedFromSeason) || !string.IsNullOrWhiteSpace(selectedToSeason)))
            {
                <button type="button" class="filter-chip" @onclick="ClearSeasonFilterAsync">
                    Seasons: @(selectedFromSeason ?? "All") – @(selectedToSeason ?? "Current") <span aria-hidden="true">×</span>
                </button>
            }
            @if (ShowsMinimumGamesFilter && minimumGames > 0)
            {
                <button type="button" class="filter-chip" @onclick="ClearMinimumGamesFilterAsync">
                    Min games: @minimumGames <span aria-hidden="true">×</span>
                </button>
            }
        </div>
    }

    @if (showAdvancedFilters)
    {
        <section id="advanced-ranking-filters" class="advanced-filters" aria-label='@T["AdditionalRankingFilters"]'>
            @if (HasCountryFilter)
            {
                <div class="filter-field searchable-filter-field">
                    <span class="filter-label-row">
                        <label for="countryFilter">@T["Country"]</label>
                        <button type="button" class="filter-info" title='@T["CountrySearchHelp"]' aria-label='@T["AboutCountrySearch"]'>i</button>
                    </span>
                    <div class="filter-combobox">
                        <input id="countryFilter"
                               class="form-control"
                               role="combobox"
                               aria-autocomplete="list"
                               aria-expanded="@showCountrySuggestions"
                               aria-controls="countryFilterOptions"
                               autocomplete="off"
                               placeholder='@T["SearchCountries"]'
                               @onfocus="ShowCountrySuggestions"
                               @onblur="HideCountrySuggestions"
                               @bind="countrySearch"
                               @bind:event="oninput"
                               @bind:after="CountrySearchChanged" />
                        @if (showCountrySuggestions && CountrySuggestions.Count > 0)
                        {
                            <div id="countryFilterOptions" class="filter-suggestions" role="listbox" aria-label='@T["CountrySuggestions"]'>
                                @foreach (var option in CountrySuggestions)
                                {
                                    <button type="button" role="option" @onmousedown:preventDefault @onclick="() => SelectCountrySuggestion(option)">@option</button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (HasCompetitionFilter)
            {
                <div class="filter-field searchable-filter-field">
                    <span class="filter-label-row">
                        <label for="competitionFilter">@T["Competition"]</label>
                        <button type="button" class="filter-info" title='@T["CompetitionSearchHelp"]' aria-label='@T["AboutCompetitionSearch"]'>i</button>
                    </span>
                    <div class="filter-combobox">
                        <input id="competitionFilter"
                               class="form-control"
                               role="combobox"
                               aria-autocomplete="list"
                               aria-expanded="@showCompetitionSuggestions"
                               aria-controls="competitionFilterOptions"
                               autocomplete="off"
                               placeholder='@T["SearchCompetitions"]'
                               @onfocus="ShowCompetitionSuggestions"
                               @onblur="HideCompetitionSuggestions"
                               @bind="competitionSearch"
                               @bind:event="oninput"
                               @bind:after="CompetitionSearchChanged" />
                        @if (showCompetitionSuggestions && CompetitionSuggestions.Count > 0)
                        {
                            <div id="competitionFilterOptions" class="filter-suggestions" role="listbox" aria-label='@T["CompetitionSuggestions"]'>
                                @foreach (var option in CompetitionSuggestions)
                                {
                                    <button type="button" role="option" @onmousedown:preventDefault @onclick="() => SelectCompetitionSuggestion(option)">
                                        <strong>@option.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(option.Context))
                                        {
                                            <span>@option.Context</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (ShowsSeasonFilter)
            {
                <div class="season-range-field">
                    <span class="filter-label">@T["Seasons"]</span>
                    <div class="season-range-control">
                        <select id="fromSeasonFilter" class="form-select" aria-label='@T["FromSeason"]' @bind="selectedFromSeason" @bind:after="FromSeasonChanged">
                            <option value="">@T["AllHistory"]</option>
                            @foreach (var option in response?.Filters.Seasons ?? [])
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                        <span aria-hidden="true">@T["ToLower"]</span>
                        <select id="toSeasonFilter" class="form-select" aria-label='@T["ToSeason"]' @bind="selectedToSeason">
                            <option value="">@T["Current"]</option>
                            @foreach (var option in FilteredToSeasonOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                </div>
            }

            @if (ShowsMinimumGamesFilter)
            {
                <div class="filter-field compact">
                    <label for="minGames">@T["MinGames"]</label>
                    <input id="minGames" class="form-control" type="number" min="0" max="999" @bind="minimumGames" />
                </div>
            }

            <div class="filter-actions">
                <button class="btn btn-primary" @onclick="ApplyFiltersAsync" disabled="@isBusy">@T["Apply"]</button>
                <button class="btn btn-outline-secondary" @onclick="ResetFiltersAsync" disabled="@isBusy">@T["Reset"]</button>
            </div>
        </section>
    }

    @if (isBusy && response is null)
    {
        <section class="loading-panel" role="status" aria-live="polite">@T["LoadingRankings"]</section>
    }
    else if (response is not null)
    {
        @if (IsArchiveMode)
        {
            <section class="archive-state">
                <strong>@ArchiveStateTitle()</strong>
                <span>@ArchiveStateDetail()</span>
            </section>
        }

        @if (selectedView == "movers")
        {
            <section class="movers-section">
                <div class="section-head">
                    <div>
                        <h2>@MoversTitle()</h2>
                    </div>
                    <div class="table-section-controls">
                        <span class="table-page-summary">@MoversContextLabel()</span>
                        @if (CurrentTotalPages > 1)
                        {
                            <div class="pager" aria-label='@T["MovementPagination"]'>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(isBusy || CurrentPage <= 1)">@T["Previous"]</button>
                                <label class="page-jump" for="moversPageInput">
                                    <span>@T["Page"]</span>
                                    <input id="moversPageInput" class="form-control form-control-sm" type="number" min="1" max="@CurrentTotalPages" @bind="requestedPage" @onkeydown="HandlePageInputKeyDown" />
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="GoToRequestedPageAsync" disabled="@isBusy">@T["Go"]</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextPageAsync" disabled="@(isBusy || CurrentPage >= CurrentTotalPages)">@T["Next"]</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="movers-toolbar" aria-label='@T["MovementControls"]'>
                    <label for="moverDirection">
                        <span>@T["Movement"]</span>
                        <select id="moverDirection" class="form-select form-select-sm" value="@selectedMoverDirection" @onchange="ChangeMoverDirectionAsync">
                            <option value="risers">@T["Risers"]</option>
                            <option value="fallers">@T["Fallers"]</option>
                        </select>
                    </label>
                    <label for="windowDays">
                        <span>@T["Window"]</span>
                        <select id="windowDays" class="form-select form-select-sm" value="@selectedWindowDays" @onchange="ChangeMoverWindowAsync">
                            <option value="7">@T["Days", 7]</option>
                            <option value="30">@T["Days", 30]</option>
                            <option value="90">@T["Days", 90]</option>
                        </select>
                    </label>
                </div>

                <div class="table-responsive ranking-table-wrap">
                    <table class="table table-hover align-middle ranking-table">
                        <thead>
                            <tr>
                                <th>@T["Rank"]</th>
                                <th>@T["Team"]</th>
                                @if (ShowsCountryColumn)
                                {
                                    <th>@T["Country"]</th>
                                }
                                <th class="numeric">@T["Change"]</th>
                                <th class="numeric">@T["Start"]</th>
                                <th class="numeric">@T["End"]</th>
                                <th class="numeric">@T["Current"]</th>
                                <th class="numeric">@T["Games"]</th>
                                <th>@T["Latest"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (movers is null || movers.Movers.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="empty-state">@T["NoRatingMovement"]</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in movers.Movers)
                                {
                                    <tr class="team-row" tabindex="0" @onclick="() => OpenTeam(row.TeamId)" @onkeydown="args => OpenTeamFromKeyboard(args, row.TeamId)">
                                        <td class="rank-cell">#@row.Rank</td>
                                        <td>
                                            <div class="team-identity-cell">
                                                <div>
                                                    <a class="team-link" href="@BuildTeamHref(row.TeamId, row.TeamName)" @onclick:stopPropagation="true">@row.TeamName</a>
                                                    @if (!row.IsActive)
                                                    {
                                                        <span class="franchise-status">@HistoricalTeamLabel()</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        @if (ShowsCountryColumn)
                                        {
                                            <td><a class="context-link" href="@RankingsContextHref(country: row.Country)" @onclick:stopPropagation="true">@row.Country</a></td>
                                        }
                                        <td class="numeric"><span class="@MovementClass(row.EloChange)">@FormatMovement(row.EloChange)</span></td>
                                        <td class="numeric">@row.StartElo.ToString("0")</td>
                                        <td class="numeric">@row.EndElo.ToString("0")</td>
                                        <td class="numeric rating">@row.CurrentElo.ToString("0")</td>
                                        <td class="numeric">@row.GamesInWindow</td>
                                        <td>@FormatDate(row.LastGameUtc)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        @if (selectedView == "results")
        {
            <section class="results-section">
                <div class="section-head">
                    <div>
                        <h2>@T["RecentResults"]</h2>
                        <p>@ResultsContextLabel() ELO is shown as pre-rating → post-rating (change).</p>
                    </div>
                </div>

                <div class="table-responsive ranking-table-wrap">
                    <table class="table table-hover align-middle results-table">
                                <thead>
                            <tr>
                                <th>@T["Date"]</th>
                                <th>@T["Competition"]</th>
                                <th>@T["Match"]</th>
                                <th class="numeric">@T["Score"]</th>
                                <th>ELO <span class="result-header-note">@T["PreToPost"]</span></th>
                                <th class="results-action-column"><span class="visually-hidden">@T["Explanation"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (CurrentResultsResponse is null)
                            {
                                <tr><td colspan="6" class="empty-state" role="status">@T["LoadingCompletedResults"]</td></tr>
                            }
                            else if (VisibleResultRows.Count == 0)
                            {
                                <tr><td colspan="6" class="empty-state">@T["NoCompletedResults"]</td></tr>
                            }
                            else
                            {
                                @foreach (var row in VisibleResultRows)
                                {
                                    <tr>
                                        <td>@FormatDate(row.GameDateTimeUtc)</td>
                                        <td><strong>@row.Competition</strong><span class="result-meta">@row.Country · @row.Season</span></td>
                                        <td>@row.HomeTeam <span class="result-separator">@T["Versus"]</span> @row.AwayTeam</td>
                                        <td class="numeric result-score">@row.HomeScore–@row.AwayScore</td>
                                        <td class="result-elo-cell">
                                            @if (row.HomeRating is { } homeRating && row.AwayRating is { } awayRating)
                                            {
                                                <div class="result-elo-line">
                                                    <span class="result-elo-side" title="@row.HomeTeam">H</span>
                                                    <span class="result-elo-values">@FormatRating(homeRating.PreElo) → @FormatRating(homeRating.PostElo)</span>
                                                    <span class="@MovementClass(homeRating.EloDelta)">@FormatMovement(homeRating.EloDelta)</span>
                                                </div>
                                                <div class="result-elo-line">
                                                    <span class="result-elo-side" title="@row.AwayTeam">A</span>
                                                    <span class="result-elo-values">@FormatRating(awayRating.PreElo) → @FormatRating(awayRating.PostElo)</span>
                                                    <span class="@MovementClass(awayRating.EloDelta)">@FormatMovement(awayRating.EloDelta)</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="muted-cell" title='@T["NoRatingHistory"]'>@T["NotRated"]</span>
                                            }
                                        </td>
                                        <td class="results-action-cell">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => LoadResultExplanationAsync(row.GameId)"
                                                    disabled="@isResultExplanationLoading">
                                                @(IsResultExplanationLoading(row.GameId) ? "Loading" : "Explain")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (selectedView == "fixtures")
        {
            <section class="fixtures-section">
                <div class="section-head">
                    <div>
                        <h2>@T["UpcomingFixtures"]</h2>
                        <p>@FixturesContextLabel()</p>
                        <small class="fixture-timezone-hint">@T["TimesShownUtc"]</small>
                    </div>
                </div>

                @if (isBusy && (upcomingFixtures is null || fixtures is null))
                {
                    <div class="loading-panel" role="status">@T["LoadingFixtures"]</div>
                }
                else if (upcomingFixtures is null || upcomingFixtures.TotalCount == 0)
                {
                    <div class="empty-state">@T["NoUpcomingFixtures"]</div>
                }
                else
                {
                    <div class="fixture-highlights" aria-label='@T["FixtureHighlights"]'>
                        @foreach (var highlight in FixtureHighlights)
                        {
                            <article class="fixture-highlight-card">
                                <div class="fixture-highlight-heading">
                                    <div>
                                        <h3>@highlight.Title</h3>
                                    </div>
                                    <span class="fixture-highlight-count">@highlight.Games.Count</span>
                                </div>
                                <p>@highlight.Description</p>
                                <div class="fixture-highlight-games">
                                    @foreach (var game in highlight.Games)
                                    {
                                        <div class="fixture-highlight-game">
                                            <div class="fixture-game-date">@FormatFixtureDate(game.GameDateTimeUtc)</div>
                                            <div class="fixture-matchup">
                                                <div class="fixture-team-row">
                                                    <strong>@game.HomeTeam</strong>
                                                    <span class="fixture-team-rating"><b>@FormatFixtureRating(game.HomeElo)</b> ELO · <b>@FormatFixtureRank(game.HomeRank)</b></span>
                                                </div>
                                                <span class="fixture-versus">@T["Versus"]</span>
                                                <div class="fixture-team-row">
                                                    <strong>@game.AwayTeam</strong>
                                                    <span class="fixture-team-rating"><b>@FormatFixtureRating(game.AwayElo)</b> ELO · <b>@FormatFixtureRank(game.AwayRank)</b></span>
                                                </div>
                                            </div>
                                            <div class="fixture-game-meta">
                                                <span>@game.Competition</span>
                                                <span>@game.Country</span>
                                            </div>
                                            <div class="fixture-game-probability" aria-label='@T["ExpectedWinProbability"]'>
                                                <span>@T["Home"] <strong>@FormatFixtureProbability(game.HomeWinProbability)</strong></span>
                                                <span>@T["Away"] <strong>@FormatFixtureProbability(AwayWinProbability(game))</strong></span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>

                    <section class="fixtures-list-section">
                        <div class="section-head">
                            <div>
                                <h2>@T["AllFixtures"]</h2>
                                <p>@T["AllFixturesDescription"]</p>
                            </div>
                            <span class="fixture-list-count">@(fixtures?.TotalCount ?? 0) games</span>
                        </div>

                        @if (fixtures is null)
                        {
                            <div class="loading-panel" role="status">@T["LoadingFilteredFixtures"]</div>
                        }
                        else if (fixtures.TotalCount == 0)
                        {
                            <div class="empty-state">@T["NoFilteredFixtures"]</div>
                        }
                        else
                        {
                            <div class="table-responsive ranking-table-wrap">
                                <table class="table table-hover align-middle fixtures-table">
                                <thead>
                                    <tr>
                                        <th>@T["Date"]</th>
                                        <th>@T["Competition"]</th>
                                        <th>@T["Matchup"]</th>
                                        <th class="numeric">ELO</th>
                                        <th class="numeric">@T["Rank"]</th>
                                        <th class="numeric">@T["Gap"]</th>
                                        <th class="numeric">@T["Expected"]</th>
                                        <th>@T["Status"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var game in fixtures.Games)
                                    {
                                        <tr>
                                            <td>@FormatFixtureDate(game.GameDateTimeUtc)</td>
                                            <td><strong>@game.Competition</strong><span class="result-meta">@game.Country</span></td>
                                            <td>@game.HomeTeam <span class="result-separator">@T["Versus"]</span> @game.AwayTeam</td>
                                            <td class="numeric">@FormatFixtureRating(game.HomeElo) – @FormatFixtureRating(game.AwayElo)</td>
                                            <td class="numeric">@FormatFixtureRank(game.HomeRank) – @FormatFixtureRank(game.AwayRank)</td>
                                            <td class="numeric">@FormatFixtureRating(game.EloDifference)</td>
                                            <td class="numeric fixture-probability-cell">@FormatFixtureProbability(game.HomeWinProbability) – @FormatFixtureProbability(AwayWinProbability(game))</td>
                                            <td><span class="@FixtureStatusClass(game.Status)">@game.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }
            </section>
        }

        @if (selectedView == "rankings")
        {
            <section class="rankings-table-section">
                <div class="section-head">
                    <div class="ranking-table-title">
                        <h2>@T["RankingTable"]</h2>
                        <span>(@LatestGameLabel(): @FormatDate(response.Summary.LatestGameUtc))</span>
                    </div>
                    <div class="table-section-controls">
                        <span class="table-page-summary">@TableContextLabel()</span>
                        @if (CurrentTotalPages > 1)
                        {
                            <div class="pager" aria-label='@T["RankingPagination"]'>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(isBusy || CurrentPage <= 1)">@T["Previous"]</button>
                                <label class="page-jump" for="rankingsPageInput">
                                    <span>@T["Page"]</span>
                                    <input id="rankingsPageInput" class="form-control form-control-sm" type="number" min="1" max="@CurrentTotalPages" @bind="requestedPage" @onkeydown="HandlePageInputKeyDown" />
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="GoToRequestedPageAsync" disabled="@isBusy">@T["Go"]</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextPageAsync" disabled="@(isBusy || CurrentPage >= CurrentTotalPages)">@T["Next"]</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="table-responsive ranking-table-wrap">
                    <table class="table table-hover align-middle ranking-table @(ShowsGlobalRank ? "with-global-rank" : string.Empty)">
                        <thead>
                            <tr>
                                @if (ShowRankingColumn("rank"))
                                {
                                    <th class="sticky-column rank-column" scope="col">@T["Rank"]</th>
                                }
                                @if (ShowRankingColumn("globalRank"))
                                {
                                    <th class="sticky-column global-rank-column" scope="col">@T["GlobalRank"]</th>
                                }
                                @if (ShowRankingColumn("team"))
                                {
                                    <th class="sticky-column team-column" scope="col">@T["Team"]</th>
                                }
                                @if (ShowRankingColumn("country"))
                                {
                                    <th scope="col">@T["Country"]</th>
                                }
                                @if (ShowRankingColumn("elo"))
                                {
                                    <th class="numeric" scope="col">ELO</th>
                                }
                                @if (ShowRankingColumn("peakElo"))
                                {
                                    <th class="numeric" scope="col">@T["PeakElo"]</th>
                                }
                                @if (ShowRankingColumn("form"))
                                {
                                    <th class="numeric form-column-header" scope="col">
                                        <span>@T["LastGames"]</span>
                                        <small>@T["OldestToNewest"]</small>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (response.Rankings.Count == 0)
                            {
                                <tr>
                                    <td colspan="@RankingTableColumnCount" class="empty-state">@(selectedPool == EloPoolKeys.NationalTeams ? "National team ratings are not available yet." : "No teams match the current filters.")</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in response.Rankings)
                                {
                                    <tr class="team-row" tabindex="0" @onclick="() => OpenTeam(row.TeamId)" @onkeydown="args => OpenTeamFromKeyboard(args, row.TeamId)">
                                        @if (ShowRankingColumn("rank"))
                                        {
                                            <td class="rank-cell sticky-column rank-column">#@row.Rank</td>
                                        }
                                        @if (ShowRankingColumn("globalRank"))
                                        {
                                            <td class="muted-rank sticky-column global-rank-column">#@row.GlobalRank</td>
                                        }
                                        @if (ShowRankingColumn("team"))
                                        {
                                            <td class="sticky-column team-column">
                                            <div class="team-identity-cell">
                                                <div>
                                                    <a class="team-link" href="@BuildTeamHref(row.TeamId, row.TeamName)" @onclick:stopPropagation="true">@row.TeamName</a>
                                                    @if (!row.IsActive)
                                                    {
                                                        <span class="franchise-status">@HistoricalTeamLabel()</span>
                                                    }
                                                </div>
                                            </div>
                                            </td>
                                        }
                                        @if (ShowRankingColumn("country"))
                                        {
                                            <td><a class="context-link" href="@RankingsContextHref(country: row.Country)" @onclick:stopPropagation="true">@row.Country</a></td>
                                        }
                                        @if (ShowRankingColumn("elo"))
                                        {
                                            <td class="numeric rating">@row.Elo.ToString("0")</td>
                                        }
                                        @if (ShowRankingColumn("peakElo"))
                                        {
                                            <td class="numeric peak-rating">
                                                <span class="peak-rating-content">
                                                    <strong>@FormatRating(row.PeakElo)</strong>
                                                    <small>@FormatDate(row.PeakEloDateUtc)</small>
                                                </span>
                                            </td>
                                        }
                                        @if (ShowRankingColumn("form"))
                                        {
                                            <td class="numeric">
                                                <div class="ranking-form-strip" aria-label='@T["RecentFiveRatedGames"]'>
                                                    @if (row.RecentForm is { Count: > 0 } form)
                                                    {
                                                        @foreach (var game in form)
                                                        {
                                                            <button type="button"
                                                                    class="ranking-form-box @(game.IsWin ? "is-win" : "is-loss") @(IsResultExplanationLoading(game.GameId) ? "is-loading" : string.Empty)"
                                                                    title="@(game.IsWin ? "Win" : "Loss") vs @game.Opponent · @FormatMovement(game.EloDelta) ELO · Open explanation"
                                                                    aria-label="@GameExplanationAriaLabel(game)"
                                                                    @onclick="() => LoadResultExplanationAsync(game.GameId)"
                                                                    @onclick:stopPropagation="true"
                                                                    disabled="@isResultExplanationLoading">
                                                                @FormatMovement(game.EloDelta)
                                                            </button>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="muted-cell">-</span>
                                                    }
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (IsGraphView && response.Rankings.Count > 0)
        {
            <section class="evolution-section">
                <div class="section-head evolution-section-head">
                    <div>
                        <h2>@(IsGraphView ? "ELO evolution" : "Explore the graph")</h2>
                        <p>@EvolutionContextLabel()</p>
                    </div>
                    <div class="evolution-section-actions">
                        @if (selectedView == "rankings")
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    aria-expanded="@isChartVisible"
                                    aria-controls="ranking-evolution-panel"
                                    @onclick="ToggleChartAsync">
                                @(isChartVisible ? "Hide chart" : "Show chart")
                            </button>
                        }
                        @if (isChartVisible || IsGraphView)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    aria-expanded="@isGraphTeamManagerOpen"
                                    aria-controls="chart-team-manager"
                                    @onclick="ToggleGraphTeamManager">
                                Manage teams <span class="chart-count-badge">@graphTeamIds.Count</span>
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    aria-pressed="@showGraphLegend"
                                    @onclick="ToggleGraphLegend">
                                Legend: @(showGraphLegend ? "On" : "Off")
                            </button>
                        }
                    </div>
                </div>

                @if (isChartVisible || IsGraphView)
                {
                    <div id="ranking-evolution-panel" class="evolution-panel" role="region" aria-label='@T["EloEvolutionChart"]'>
                        @if (isChartLoading)
                        {
                            <div class="chart-loading-panel" role="status" aria-live="polite">
                                <span class="spinner-border chart-loading-spinner" aria-hidden="true"></span>
                                <span>@T["LoadingChart"]</span>
                            </div>
                        }
                        else
                        {
                            <div class="evolution-workspace @(isGraphTeamManagerOpen ? "manager-open" : string.Empty)">
                                @if (isGraphTeamManagerOpen)
                                {
                                    <aside id="chart-team-manager" class="graph-team-manager" aria-label='@T["ChartTeamManager"]'>
                                        <div class="graph-team-manager-heading">
                                            <div>
                                                <strong>@T["ChartTeams"]</strong>
                                                <span>@graphTeamIds.Count selected · @VisibleGraphTeamCount visible</span>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-quiet" @onclick="ToggleGraphTeamManager">@T["Collapse"]</button>
                                        </div>

                                        <p class="graph-team-manager-help">@T["ChartManagerHelp"]</p>

                                        <div class="graph-team-search">
                                            <label for="graphTeamSearch">@T["AddManageTeams"]</label>
                                            <div class="graph-team-search-row">
                                                <input id="graphTeamSearch"
                                                       class="form-control"
                                                       value="@graphTeamSearch"
                                                       @oninput="HandleGraphTeamSearchInputAsync"
                                                       placeholder='@T["SearchTeams"]'
                                                       autocomplete="off"
                                                       role="combobox"
                                                       aria-autocomplete="list"
                                                       aria-controls="graph-team-search-results"
                                                       aria-expanded="@(graphTeamSearchResults.Count > 0)" />
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SearchGraphTeamsAsync" disabled="@(isGraphSelectionBusy || isGraphSearchBusy || string.IsNullOrWhiteSpace(graphTeamSearch))">@T["Search"]</button>
                                            </div>
                                            @if (isGraphSearchBusy)
                                            {
                                                <span class="graph-team-search-status" aria-live="polite">@T["Searching"]</span>
                                            }
                                        </div>

                                        <div class="graph-bulk-actions">
                                            @if (!string.IsNullOrWhiteSpace(selectedCountry))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddCountryTeamsToGraphAsync" disabled="@isGraphSelectionBusy">@T["AddAll"] @selectedCountry</button>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(selectedCompetition))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddCompetitionTeamsToGraphAsync" disabled="@isGraphSelectionBusy">@T["AddAll"] @selectedCompetition</button>
                                            }
                                        </div>

                                        @if (graphTeamSearchResults.Count > 0)
                                        {
                                            <div id="graph-team-search-results" class="graph-team-search-results" role="listbox" aria-label='@T["TeamSearchSuggestions"]'>
                                                @foreach (var row in graphTeamSearchResults)
                                                {
                                                    var isAdded = graphTeamIds.Contains(row.TeamId);
                                                    <div class="graph-team-search-result" role="option" aria-selected="@isAdded">
                                                        <span>@row.TeamName <small>@row.Country</small></span>
                                                        @if (isAdded)
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-danger"
                                                                    disabled="@isGraphSelectionBusy"
                                                                    @onclick="() => RemoveGraphTeamAsync(row.TeamId)">
                                                                Remove
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    disabled="@isGraphSelectionBusy"
                                                                    @onclick="() => AddGraphTeamAsync(row)">
                                                                Add
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (SelectedGraphTeams.Count == 0)
                                        {
                                            <p class="graph-selection-empty">@T["NoTeamsSelected"]</p>
                                        }
                                        else
                                        {
                                            <div class="graph-team-manager-list-heading">
                                                <span>@T["Legend"]</span>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleAllGraphTeamsAsync" disabled="@(SelectedGraphTeams.Count == 0)">@GraphVisibilityToggleLabel</button>
                                            </div>
                                            <div class="graph-team-manager-list" aria-label='@T["ChartLegendSelectedTeams"]'>
                                                @foreach (var team in SelectedGraphTeams)
                                                {
                                                    var isVisible = IsGraphTeamVisible(team.TeamId);
                                                    <div class="graph-team-manager-row @(isVisible ? "is-visible" : "is-hidden")">
                                                        <span class="graph-team-color-swatch" style="background: @GraphTeamColor(team.TeamId)" aria-hidden="true"></span>
                                                        <span class="graph-team-manager-name" title="@team.TeamName">@team.TeamName <small>@team.Country</small></span>
                                                        <button type="button" class="graph-team-visibility-toggle" aria-pressed="@isVisible" aria-label="@(isVisible ? $"Hide {team.TeamName}" : $"Show {team.TeamName}")" title="@(isVisible ? "Hide line" : "Show line")" @onclick="() => ToggleGraphTeamVisibilityAsync(team.TeamId)">
                                                            <span class="graph-eye-icon" aria-hidden="true"></span>
                                                        </button>
                                                        <button type="button" class="graph-team-remove-button" aria-label="@RemoveFromChartAriaLabel(team.TeamName)" title='@T["RemoveFromChart"]' @onclick="() => RemoveGraphTeamAsync(team.TeamId)">&times;</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </aside>
                                }

                                <div class="@EvolutionChartClass" role="img" aria-label='@T["EloEvolutionCurrentTeams"]'>
                                    @if (EvolutionSeries.Count < 1 || EvolutionSeries.All(x => x.Points.Count < 2))
                                    {
                                        <div class="empty-state">@T["NotEnoughChartGames"]</div>
                                    }
                                    else
                                    {
                                        <EloEvolutionChart @key="@($"{activeRankingsCacheKey}:{selectedView}")"
                                                           Series="@evolutionChartSeries"
                                                           EnableRangeNavigation="true"
                                                           ShowLegend="false"
                                                           ShowSeriesControls="@(showGraphLegend && !isGraphTeamManagerOpen)"
                                                           CompareRenderers="false"
                                                           UseDygraphs="true"
                                                           ShowDiagnostics="@isAdmin"
                                                           HiddenTeamIds="@HiddenGraphTeamIds"
                                                           SeriesVisibilityChanged="@ToggleGraphTeamVisibilityAsync"
                                                           ShowAllSeriesRequested="@ShowAllGraphTeamsAsync"
                                                           HideAllSeriesRequested="@HideAllGraphTeamsAsync"
                                                           SharedTooltip="false"
                                                           HeightPixels="@ChartHeightPixels"
                                                           FillAvailableHeight="@IsGraphView"
                                                           DataRevision="@evolutionDataRevision"
                                                           IsRefining="@isEvolutionRefining"
                                                           ViewportInteractionStarted="@CancelEvolutionRefinementAsync"
                                                           ViewportRefinementRequested="@QueueEvolutionRefinementAsync"
                                                           FullRangeRequested="@RestoreFullEvolutionAsync" />

                                    }
                                </div>
                            </div>
                            @if (!IsGraphView)
                            {
                                <div class="chart-actions">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleChartSize">
                                        @(isChartExpanded ? "Compact chart" : "Expand chart")
                                    </button>
                                </div>
                            }
                        }
                    </div>
                }
            </section>
        }

        <GameEloExplanationPanel Explanation="selectedResultExplanation"
                                 IsLoading="isResultExplanationLoading"
                                 ErrorMessage="@resultExplanationError"
                                 OnClose="CloseResultExplanation" />

    }

</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "pool")]
    public string? Pool { get; set; }

    [SupplyParameterFromQuery(Name = "country")]
    public string? Country { get; set; }

    [SupplyParameterFromQuery(Name = "competition")]
    public string? Competition { get; set; }

    [SupplyParameterFromQuery(Name = "ruleset")]
    public string? Ruleset { get; set; }

    [SupplyParameterFromQuery(Name = "season")]
    public string? Season { get; set; }

    [SupplyParameterFromQuery(Name = "fromSeason")]
    public string? FromSeason { get; set; }

    [SupplyParameterFromQuery(Name = "toSeason")]
    public string? ToSeason { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? From { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? To { get; set; }

    [SupplyParameterFromQuery(Name = "minGames")]
    public int? MinGames { get; set; }

    [SupplyParameterFromQuery(Name = "team")]
    public string? Team { get; set; }

    [SupplyParameterFromQuery(Name = "teams")]
    public string? Teams { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    [SupplyParameterFromQuery(Name = "movement")]
    public string? Movement { get; set; }

    [SupplyParameterFromQuery(Name = "windowDays")]
    public int? WindowDays { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    private EloRankingsResponse? response;
    private EloMoversResponse? movers;
    private EloResultsResponse? results;
    private UpcomingGamesResponse? fixtures;
    private UpcomingGamesResponse? upcomingFixtures;
    private EloRankingsEvolutionResponse? evolution;
    private EloRankingsEvolutionResponse? fullEvolution;
    private EloRankingsResponse? evolutionRankings;
    private Guid? selectedResultExplanationGameId;
    private EloGameExplanationResponse? selectedResultExplanation;
    private bool isResultExplanationLoading;
    private string? resultExplanationError;
    private IReadOnlyList<EloChartSeries> evolutionChartSeries = [];
    private bool isBusy;
    private bool isChartExpanded;
    private bool isChartVisible;
    private bool isChartLoading;
    private bool isAdmin;
    private bool isGraphTeamManagerOpen;
    private bool showGraphLegend = true;
    private bool showAdvancedFilters;
    private string? errorMessage;
    private string? selectedCountry;
    private string? selectedCompetition;
    private string? countrySearch;
    private string? competitionSearch;
    private bool showCountrySuggestions;
    private bool showCompetitionSuggestions;
    private bool showRulesetHelp;
    private string selectedRuleset = EloRulesetVersions.Default;
    private string selectedPool = EloPoolKeys.Default;
    private string selectedTeamScope = EloTeamScopes.Current;
    private string? selectedFromSeason;
    private string? selectedToSeason;
    private string? teamSearch;
    private int minimumGames;
    private int page = 1;
    private int requestedPage = 1;
    private string selectedView = "rankings";
    private string selectedMoverDirection = "risers";
    private int selectedWindowDays = 30;
    private string? lastLoadedUri;
    private string? lastRankingsApiUri;
    private string? lastMoversApiUri;
    private string? lastResultsApiUri;
    private string? lastFixturesApiUri;
    private string? lastUpcomingFixturesApiUri;
    private string? lastEvolutionRankingsApiUri;
    private string? lastEvolutionApiUri;
    private RankingsClientCacheKey? activeRankingsCacheKey;
    private long evolutionDataRevision;
    private bool isEvolutionRefining;
    private readonly Dictionary<Guid, int> evolutionVisibleRatedPointCounts = new();
    private CancellationTokenSource? evolutionRefinementCancellation;
    private readonly Dictionary<RankingsClientCacheKey, RankingsClientCacheEntry> rankingsClientCache = new();
    private readonly Dictionary<string, EloRankingsEvolutionResponse> evolutionRangeCache = new(StringComparer.Ordinal);
    private readonly Queue<string> evolutionRangeCacheOrder = new();

    private const int EvolutionRefinementDebounceMilliseconds = 600;
    private const int EvolutionRangeCacheLimit = 8;
    private const int MaxManualGraphTeams = 200;

    private readonly HashSet<Guid> graphTeamIds = [];
    private readonly HashSet<Guid> graphBulkTeamIds = [];
    private readonly HashSet<Guid> manualGraphTeamIds = [];
    private readonly HashSet<Guid> hiddenGraphTeamIds = [];
    private IReadOnlyList<EloRankingRow> graphTeamRows = [];
    private IReadOnlyList<EloRankingRow> graphTeamSearchResults = [];
    private string? graphTeamSearch;
    private bool graphSelectionInitialized;
    private bool isGraphSelectionBusy;
    private bool isGraphSearchBusy;
    private CancellationTokenSource? graphSearchCancellation;
    private CancellationTokenSource? teamSearchDebounceCancellation;
    private CancellationTokenSource? teamSearchRequestCancellation;
    private long teamSearchRequestVersion;
    private PersistingComponentStateSubscription? persistingSubscription;
    private const string PersistedPageStateKey = "rankings-page-state";

    private sealed record RankingsClientCacheKey(
        string Pool,
        string View,
        string RankingsUri,
        string MoverDirection,
        int MoverWindowDays);

    private sealed class RankingsClientCacheEntry
    {
        public EloRankingsResponse? Rankings { get; set; }
        public EloMoversResponse? Movers { get; set; }
        public EloResultsResponse? Results { get; set; }
        public UpcomingGamesResponse? Fixtures { get; set; }
        public UpcomingGamesResponse? UpcomingFixtures { get; set; }
        public EloRankingsEvolutionResponse? Evolution { get; set; }
        public EloRankingsEvolutionResponse? FullEvolution { get; set; }
        public EloRankingsResponse? EvolutionRankings { get; set; }
        public IReadOnlyList<EloChartSeries> EvolutionChartSeries { get; set; } = [];
        public Dictionary<Guid, int> EvolutionVisibleRatedPointCounts { get; set; } = new();
        public string? RankingsApiUri { get; set; }
        public string? MoversApiUri { get; set; }
        public string? ResultsApiUri { get; set; }
        public string? FixturesApiUri { get; set; }
        public string? UpcomingFixturesApiUri { get; set; }
        public string? EvolutionRankingsApiUri { get; set; }
        public string? EvolutionApiUri { get; set; }
        public long EvolutionDataRevision { get; set; }
    }

    private sealed record PersistedRankingsPageState(
        string RelativeUri,
        EloRankingsResponse Rankings,
        EloMoversResponse? Movers,
        EloResultsResponse? Results,
        UpcomingGamesResponse? Fixtures,
        UpcomingGamesResponse? UpcomingFixtures,
        string? RankingsApiUri,
        string? MoversApiUri,
        string? ResultsApiUri,
        string? FixturesApiUri,
        string? UpcomingFixturesApiUri);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var path = Navigation.ToBaseRelativePath(args.Location).Split('?', 2)[0].Trim('/');
        if (path is not ("" or "rankings" or "movers"))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            ApplyQueryParametersFromUri(args.Location);
            await LoadPageForUriAsync(args.Location);
            StateHasChanged();
        });
    }

    private void ApplyQueryParametersFromUri(string uri)
    {
        var query = QueryHelpers.ParseQuery(new Uri(uri).Query);
        string? Value(string name)
            => query.TryGetValue(name, out var values) ? values.FirstOrDefault() : null;

        Pool = Value("pool");
        Country = Value("country");
        Competition = Value("competition");
        Ruleset = Value("ruleset");
        Season = Value("season");
        FromSeason = Value("fromSeason");
        ToSeason = Value("toSeason");
        From = ParseQueryDate(Value("from"));
        To = ParseQueryDate(Value("to"));
        MinGames = ParseQueryInt(Value("minGames"));
        Team = Value("team");
        Teams = Value("teams");
        View = Value("view");
        Movement = Value("movement");
        WindowDays = ParseQueryInt(Value("windowDays"));
        Page = ParseQueryInt(Value("page"));
    }

    private static DateTime? ParseQueryDate(string? value)
        => DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var parsed)
            ? parsed
            : null;

    private static int? ParseQueryInt(string? value)
        => int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : null;

    protected override Task OnParametersSetAsync()
        => LoadPageForUriAsync(Navigation.Uri);

    private async Task LoadPageForUriAsync(string currentUri)
    {
        var authenticationState = AuthenticationStateTask is null
            ? null
            : await AuthenticationStateTask;
        isAdmin = authenticationState?.User.IsInRole(ApplicationRoleKeys.Admin) == true;

        if (currentUri == lastLoadedUri)
        {
            return;
        }

        CancelTeamSearchDebounce();
        CaptureActiveRankingsCacheEntry();
        var previousPool = selectedPool;
        var previousTeamScope = selectedTeamScope;
        var preserveCurrentData = IsPageOnlyNavigation(currentUri, lastLoadedUri) ||
            IsRankingsMoversNavigation(currentUri, lastLoadedUri);

        selectedPool = EloPoolKeys.IsSupported(Pool?.Trim().ToLowerInvariant() ?? string.Empty)
            ? Pool!.Trim().ToLowerInvariant()
            : EloPoolKeys.Default;
        var poolChanged = !string.Equals(previousPool, selectedPool, StringComparison.Ordinal);
        selectedTeamScope = SupportsTeamScope
            ? EloTeamScopes.Normalize(Teams)
            : EloTeamScopes.Current;
        var teamScopeChanged = !string.Equals(previousTeamScope, selectedTeamScope, StringComparison.Ordinal);
        selectedCountry = Country;
        selectedCompetition = Competition;
        countrySearch = selectedCountry;
        competitionSearch = selectedCompetition;
        selectedRuleset = EloRulesetVersions.All.Contains(Ruleset?.Trim(), StringComparer.OrdinalIgnoreCase)
            ? Ruleset!.Trim().ToLowerInvariant()
            : EloRulesetVersions.Default;
        selectedFromSeason = FromSeason;
        selectedToSeason = ToSeason;
        if (!string.IsNullOrWhiteSpace(Season) && string.IsNullOrWhiteSpace(selectedFromSeason) && string.IsNullOrWhiteSpace(selectedToSeason))
        {
            selectedFromSeason = Season;
            selectedToSeason = Season;
        }
        else
        {
            ApplyLegacyDateRange();
        }
        minimumGames = Math.Max(0, MinGames ?? 0);
        teamSearch = Team;
        var currentPath = Navigation.ToBaseRelativePath(currentUri).Split('?', 2)[0].Trim('/');
        var isMoversRoute = string.Equals(currentPath, "movers", StringComparison.OrdinalIgnoreCase);
        selectedView = isMoversRoute || string.Equals(View, "movers", StringComparison.OrdinalIgnoreCase)
            ? "movers"
            : View?.Trim().ToLowerInvariant() switch
            {
                "results" => "results",
                "fixtures" => "fixtures",
                "graph" or "graph-canvas" or "graph-svg" => "graph",
                _ => "rankings"
            };
        if (!ShowsTeamScopeFilter)
        {
            selectedTeamScope = EloTeamScopes.Current;
        }

        if (!ShowsSeasonFilter)
        {
            selectedFromSeason = null;
            selectedToSeason = null;
        }

        if (!ShowsMinimumGamesFilter)
        {
            minimumGames = 0;
        }

        selectedMoverDirection = string.Equals(Movement, "fallers", StringComparison.OrdinalIgnoreCase) ? "fallers" : "risers";
        selectedWindowDays = WindowDays is 7 or 30 or 90 ? WindowDays.Value : 30;
        showAdvancedFilters = HasAdvancedFilterValues;
        isChartVisible = IsGraphView;
        isChartExpanded = false;
        isChartLoading = false;
        page = Math.Max(1, Page ?? 1);
        requestedPage = page;
        lastLoadedUri = currentUri;
        CancelEvolutionRefinement();
        evolutionRangeCache.Clear();
        evolutionRangeCacheOrder.Clear();
        ResetGraphSelection();

        activeRankingsCacheKey = null;
        if (!preserveCurrentData)
        {
            response = null;
            movers = null;
            results = null;
            fixtures = null;
            upcomingFixtures = null;
        }
        CloseResultExplanation();
        // Keep the existing ranking table visible while a pool navigation
        // refreshes, but never reuse its chart data: the series and legend
        // belong to the selected pool and must be fetched as a unit.
        if (!preserveCurrentData || poolChanged || teamScopeChanged)
        {
            evolution = null;
            evolutionRankings = null;
            evolutionChartSeries = [];
            fullEvolution = null;
        }

        try
        {
            if (TryRestorePersistedPageState(currentUri))
            {
                RegisterPersistenceAtEndOfInitialization();
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not restore prerendered rankings state; loading it again interactively.");
        }
        await RefreshAsync();
        if (IsGraphView)
        {
            await LoadChartAsync();
        }

        CachePrerenderedPageState(currentUri);
        RegisterPersistenceAtEndOfInitialization();
    }

    private void RegisterPersistenceAtEndOfInitialization()
        => persistingSubscription ??= PersistentState.RegisterOnPersisting(PersistPageStateAsync);

    private bool TryRestorePersistedPageState(string currentUri)
    {
        var relativeUri = Navigation.ToBaseRelativePath(currentUri);
        PersistentState.TryTakeFromJson<string>(PersistedPageStateKey, out var persistedCacheKey);
        PersistedRankingsPageState? persistedState = null;
        if (!string.IsNullOrWhiteSpace(persistedCacheKey))
        {
            PrerenderCache.TryGetValue(persistedCacheKey, out persistedState);
        }

        if (persistedState is null ||
            !string.Equals(persistedState.RelativeUri, relativeUri, StringComparison.Ordinal))
        {
            PrerenderCache.TryGetValue(BuildPrerenderCacheKey(relativeUri), out persistedState);
        }

        if (persistedState is null ||
            !string.Equals(persistedState.RelativeUri, relativeUri, StringComparison.Ordinal))
        {
            return false;
        }

        response = persistedState.Rankings;
        movers = persistedState.Movers;
        results = persistedState.Results;
        fixtures = persistedState.Fixtures;
        upcomingFixtures = persistedState.UpcomingFixtures;
        lastRankingsApiUri = persistedState.RankingsApiUri;
        lastMoversApiUri = persistedState.MoversApiUri;
        lastResultsApiUri = persistedState.ResultsApiUri;
        lastFixturesApiUri = persistedState.FixturesApiUri;
        lastUpcomingFixturesApiUri = persistedState.UpcomingFixturesApiUri;
        page = selectedView switch
        {
            "movers" when movers is not null => movers.Page,
            "results" when results is not null => results.Page,
            _ => response.Page
        };
        requestedPage = page;
        isBusy = false;

        var clientCacheKey = BuildRankingsClientCacheKey(BuildApiUri());
        StoreRankingsCacheEntry(clientCacheKey);
        return true;
    }

    private Task PersistPageStateAsync()
    {
        var cacheKey = CachePrerenderedPageState(Navigation.Uri);
        if (cacheKey is not null)
        {
            PersistentState.PersistAsJson(
                PersistedPageStateKey,
                cacheKey);
        }

        return Task.CompletedTask;
    }

    private string? CachePrerenderedPageState(string currentUri)
    {
        if (response is null || selectedView is not ("rankings" or "movers" or "results" or "fixtures"))
        {
            return null;
        }

        var relativeUri = Navigation.ToBaseRelativePath(currentUri);
        var cacheKey = BuildPrerenderCacheKey(relativeUri);
        PrerenderCache.Set(
            cacheKey,
            new PersistedRankingsPageState(
                relativeUri,
                response,
                selectedView == "movers" ? movers : null,
                selectedView == "results" ? results : null,
                selectedView == "fixtures" ? fixtures : null,
                selectedView == "fixtures" ? upcomingFixtures : null,
                lastRankingsApiUri,
                selectedView == "movers" ? lastMoversApiUri : null,
                selectedView == "results" ? lastResultsApiUri : null,
                selectedView == "fixtures" ? lastFixturesApiUri : null,
                selectedView == "fixtures" ? lastUpcomingFixturesApiUri : null),
            TimeSpan.FromMinutes(2));
        return cacheKey;
    }

    private static string BuildPrerenderCacheKey(string relativeUri)
        => $"rankings-page-state:{relativeUri}";

