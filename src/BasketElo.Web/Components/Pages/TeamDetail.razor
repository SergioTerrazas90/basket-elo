@page "/teams/{TeamId:guid}"
@page "/team/{TeamId:guid}/{TeamSlug}"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using BasketElo.Domain.Elo
@using BasketElo.Domain.Entities
@inject HttpClient Http

<SeoHead Title="@TeamSeoTitle"
         Description="@TeamSeoDescription"
         CanonicalPath="@TeamCanonicalPath"
         SchemaType="ProfilePage"
         SocialImageAlt="@TeamSocialImageAlt" />

<div class="team-page">
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (isBusy && team is null)
    {
        <section class="loading-panel">@T["LoadingTeamProfile"]</section>
    }
    else if (team is not null)
    {
        <section class="team-hero">
            <div>
                <a class="back-link" href="@BackHref">@T["BackToRankings"]</a>
                <p class="eyebrow">@team.EloPoolName</p>
                <div class="team-title-line">
                    <h1>@team.TeamName</h1>
                    @if (!team.IsActive || team.EloPoolKey == EloPoolKeys.NationalTeams)
                    {
                        <span class="team-status-badge @TeamHeaderStatusClass(team)">@TeamHeaderStatusLabel(team)</span>
                    }
                </div>
                <p class="intro">@RulesetDisplayName(team.RulesetVersion) profile, latest rated games, and the team's continuous rating path.</p>
            </div>
            <div class="team-rank-card">
                <span>@T["PoolRank"]</span>
                <strong>#@team.GlobalRank</strong>
                <small>@team.RulesetVersion</small>
            </div>
        </section>

        <section class="team-summary">
            <div>
                <span>@T["CurrentElo"]</span>
                <strong>@team.Elo.ToString("0")</strong>
                <small>@T["BestRank"] @FormatRank(team.BestRank) · @T["LastReached"] @FormatDate(team.BestRankUtc)</small>
            </div>
            <div>
                <span>@T["BestElo"]</span>
                <strong>@FormatRating(team.BestElo)</strong>
                <small>@FormatDate(team.BestEloUtc)</small>
            </div>
            <div>
                <span>@T["GamesRated"]</span>
                <strong>@team.GamesPlayed</strong>
            </div>
            <div>
                <span>@T["RecentMovement"]</span>
                <strong class="@MovementClass(team.RecentMovement)">@FormatMovement(team.RecentMovement)</strong>
                <small>@RecentMovementOpponentLabel(team)</small>
            </div>
            <div>
                <span>@T["LastGame"]</span>
                <strong>@FormatDate(team.LastGameUtc)</strong>
            </div>
        </section>

        @if (team.EloPoolKey == EloPoolKeys.Nba && (team.IdentityEvents.Count > 0 || !team.IsActive))
        {
            <section class="franchise-lineage" aria-labelledby="franchise-lineage-title">
                <div>
                    <p class="eyebrow">@T["FranchiseIdentity"]</p>
                    <h2 id="franchise-lineage-title">@(team.IdentityEvents.Count > 0 ? T["FranchiseHistory"] : T["HistoricalFranchise"])</h2>
                    <p>@(team.IdentityEvents.Count > 0 ? T["FranchiseHistoryDescription"] : T["DefunctFranchiseDescription"])</p>
                </div>
                @if (!team.IsActive)
                {
                    <span class="franchise-state">@T["DefunctFranchise"]</span>
                }
                @if (team.IdentityEvents.Count > 0)
                {
                    <ol class="identity-event-list">
                        @foreach (var identityEvent in team.IdentityEvents.OrderBy(x => x.Year))
                        {
                            <li>
                                <time>@identityEvent.Year</time>
                                <span>@identityEvent.FromName <strong aria-hidden="true">&rarr;</strong> @identityEvent.ToName</span>
                                <small>@IdentityEventLabel(identityEvent.Type)</small>
                            </li>
                        }
                    </ol>
                }
            </section>
        }

        @if (team.RecentForms.Count > 0)
        {
            <section class="form-section">
                <div class="section-head">
                    <div>
                        <h2>@T["RecentForm"]</h2>
                        <p>@T["RecentFormDescription"]</p>
                    </div>
                </div>

                <div class="form-grid">
                    @foreach (var form in team.RecentForms)
                    {
                        <article class="form-card">
                            <div class="form-card-head">
                                <span>@T["Last"] @form.WindowGames</span>
                                <strong>@FormatRecord(form)</strong>
                            </div>

                            <dl class="form-stats">
                                <div>
                                    <dt>@T["RatedGames"]</dt>
                                    <dd>@form.GamesAvailable</dd>
                                </div>
                                <div>
                                    <dt>@T["EloChange"]</dt>
                                    <dd class="@MovementClass(form.TotalEloChange)">@FormatMovement(form.TotalEloChange)</dd>
                                </div>
                                <div>
                                    <dt>@T["AverageOpponent"]</dt>
                                    <dd>@FormatRating(form.AverageOpponentPreElo)</dd>
                                </div>
                            </dl>

                        </article>
                    }
                </div>

                @if (team.HistoricalHighlights is not null)
                {
                    <div class="historical-highlights">
                        <div>
                            <h3>@T["HistoryHighlights"]</h3>
                            <p>@T["HistoryHighlightsDescription", team.HistoricalHighlights.GamesAvailable]</p>
                        </div>
                        <div class="historical-highlights-grid">
                            <div>
                                <span>@T["BestWins"]</span>
                                @if (team.HistoricalHighlights.BestWins.Count == 0)
                                {
                                    <strong class="muted-cell">@T["NoWins"]</strong>
                                }
                                else
                                {
                                    @foreach (var win in team.HistoricalHighlights.BestWins)
                                    {
                                        <div class="historical-highlight-row">
                                            <span>@FormatHistoricalHighlightGame(win)</span>
                                            <button type="button"
                                                    class="history-highlight-elo @MovementClass(win.EloDelta)"
                                                    @onclick="() => LoadExplanationAsync(win.GameId)"
                                                    disabled="@IsExplanationLoading(win.GameId)"
                                                    title='@T["ExplainThisGame"]'>
                                                @(IsExplanationLoading(win.GameId) ? "Loading" : FormatMovement(win.EloDelta))
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                            <div>
                                <span>@T["WorstLosses"]</span>
                                @if (team.HistoricalHighlights.WorstLosses.Count == 0)
                                {
                                    <strong class="muted-cell">@T["NoLosses"]</strong>
                                }
                                else
                                {
                                    @foreach (var loss in team.HistoricalHighlights.WorstLosses)
                                    {
                                        <div class="historical-highlight-row">
                                            <span>@FormatHistoricalHighlightGame(loss)</span>
                                            <button type="button"
                                                    class="history-highlight-elo @MovementClass(loss.EloDelta)"
                                                    @onclick="() => LoadExplanationAsync(loss.GameId)"
                                                    disabled="@IsExplanationLoading(loss.GameId)"
                                                    title='@T["ExplainThisGame"]'>
                                                @(IsExplanationLoading(loss.GameId) ? "Loading" : FormatMovement(loss.EloDelta))
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        @if (team.EloPoolKey != EloPoolKeys.Nba)
        {
            <section class="team-context">
                <div>
                    <h2>@T["Competitions"]</h2>
                    <div class="competition-list">
                        @if (team.Competitions.Count == 0)
                        {
                            <span class="empty-chip">@T["NoCompetitionsYet"]</span>
                        }
                        else
                        {
                            @foreach (var competition in team.Competitions)
                            {
                                <span>@competition</span>
                            }
                        }
                    </div>
                </div>
            </section>
        }

        <div class="history-workspace @(isChartExpanded ? "is-chart-expanded" : string.Empty)">
            <section class="history-section">
                <div class="section-head">
                    <div>
                        <h2>@T["RatingHistory"]</h2>
                        <p>@HistoryContextLabel()</p>
                    </div>
                </div>
                <div class="chart-shell">
                    @if (team.History.Count < 2)
                    {
                        <div class="empty-state">@T["NotEnoughChartGames"]</div>
                    }
                    else
                    {
                        <EloEvolutionChart Series="@teamHistoryChartSeries"
                                           ShowLegend="false"
                                           ShowSeriesControls="false"
                                           ShowDiagnostics="@isAdmin"
                                           SharedTooltip="false"
                                           EnableRangeNavigation="true"
                                           AllowExpand="true"
                                           FillAvailableHeight="true"
                                           IsExpanded="@isChartExpanded"
                                           ExpandedChanged="@HandleChartExpandedChanged"
                                           DataRevision="@teamHistoryDataRevision"
                                           IsRefining="@isTeamHistoryRefining"
                                           ViewportRefinementRequested="@QueueTeamHistoryRefinementAsync"
                                           FullRangeRequested="@RestoreFullTeamHistoryAsync"
                                           HighlightedGameId="@highlightedGameId"
                                           PointHoverChanged="@HandleChartPointHoverAsync" />
                    }
                </div>
            </section>

            <section class="recent-games-section">
                <div class="section-head">
                    <div>
                        <h2>@T["PlottedGames"]</h2>
                        <p>@GamesContextLabel(team)</p>
                    </div>
                </div>

                <div class="table-responsive games-table-scroll">
                    <table class="table table-hover align-middle team-games-table is-condensed">
                    <thead>
                        <tr>
                            <th>@T["Date"]</th>
                            <th>@T["Competition"]</th>
                            <th>@T["Opponent"]</th>
                            <th>@T["Score"]</th>
                            <th class="numeric">@T["EloChange"]</th>
                            <th class="numeric">@T["After"]</th>
                            <th class="numeric">@T["NewRank"]</th>
                            <th>@T["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (team.RecentGames.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="empty-state">@T["NoImportedGames"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var game in team.RecentGames)
                            {
                                <tr class="@(IsGameHighlighted(game.GameId) ? "is-game-highlighted" : string.Empty)"
                                    @onmouseenter="() => HandleGameRowEnter(game.GameId)"
                                    @onmouseleave="() => HandleGameRowLeave(game.GameId)">
                                    <td>@FormatDate(game.GameDateTimeUtc)</td>
                                    <td>
                                        <div class="competition-cell">
                                            <span>@game.Competition</span>
                                            <small>@game.Season</small>
                                        </div>
                                    </td>
                                    <td>@(game.WasHome ? "vs" : "at") @game.Opponent</td>
                                    <td>@FormatScore(game)</td>
                                    <td class="numeric">
                                        @if (game.EloDelta.HasValue)
                                        {
                                            <span class="@MovementClass(game.EloDelta)">@FormatMovement(game.EloDelta)</span>
                                        }
                                        else
                                        {
                                            <span class="muted-cell">@T["NotRated"]</span>
                                        }
                                    </td>
                                    <td class="numeric rating">@(game.PostElo?.ToString("0") ?? "-")</td>
                                    <td class="numeric">
                                        @if (game.RankAfter.HasValue)
                                        {
                                            <span>#@game.RankAfter</span>
                                            @if (game.RankChange.HasValue && game.RankChange.Value != 0)
                                            {
                                                <small class="@RankChangeClass(game.RankChange.Value)">(@FormatRankChange(game.RankChange.Value))</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="muted-cell">-</span>
                                        }
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => LoadExplanationAsync(game.GameId)" disabled="@IsExplanationLoading(game.GameId)">
                                            @(IsExplanationLoading(game.GameId) ? "Loading" : "Explain")
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    </table>
                </div>

            </section>
        </div>

        <GameEloExplanationPanel Explanation="selectedExplanation"
                                 IsLoading="isExplanationLoading"
                                 ErrorMessage="@explanationError"
                                 OnClose="CloseExplanation" />
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter]
    public Guid TeamId { get; set; }

    [Parameter]
    public string? TeamSlug { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "pool")]
    public string? Pool { get; set; }

    [SupplyParameterFromQuery(Name = "ruleset")]
    public string? Ruleset { get; set; }

    private EloTeamDetailResponse? team;
    private bool isBusy;
    private bool isAdmin;
    private string? errorMessage;
    private Guid? selectedExplanationGameId;
    private EloGameExplanationResponse? selectedExplanation;
    private bool isExplanationLoading;
    private string? explanationError;
    private Guid? highlightedGameId;
    private bool isChartExpanded;
    private IReadOnlyList<EloChartSeries> teamHistoryChartSeries = [];
    private IReadOnlyList<EloChartSeries> fullTeamHistoryChartSeries = [];
    private IReadOnlyCollection<EloTeamGameDto> fullTeamHistoryGames = [];
    private int fullTeamHistoryTotalGames;
    private bool fullTeamHistoryWasSampled;
    private DateTime? teamHistoryVisibleFromUtc;
    private DateTime? teamHistoryVisibleToUtc;
    private long teamHistoryDataRevision;
    private bool isTeamHistoryRefining;
    private CancellationTokenSource? teamHistoryRefinementCancellation;
    private readonly Dictionary<string, EloTeamHistoryGamesResponse> teamHistoryGamesRangeCache = new(StringComparer.Ordinal);

    private string TeamSeoTitle
        => team is null
            ? "Basketball Team ELO Profile | BasketElo"
            : $"{team.TeamName} ELO History & Ranking | BasketElo";

    private string TeamSeoDescription
        => team is null
            ? "Explore basketball team ELO rankings, rating history, recent form, and game-level explanations on BasketElo."
            : $"Explore {team.TeamName}'s {team.EloPoolName} ELO rating, ranking, form, rating history, and game explanations on BasketElo.";

    private string TeamSocialImageAlt
        => team is null
            ? "BasketElo basketball team ELO profile"
            : $"{team.TeamName} basketball ELO profile on BasketElo";

    private string TeamCanonicalPath
        => team is null
            ? $"/team/{TeamId:D}/{TeamSlug ?? "team"}"
            : $"/team/{team.TeamId:D}/{ToSlug(team.TeamName)}?pool={Uri.EscapeDataString(team.EloPoolKey)}&ruleset={Uri.EscapeDataString(team.RulesetVersion)}";

    private void HandleChartExpandedChanged(bool expanded)
        => isChartExpanded = expanded;

    private const int HistoryRefinementDebounceMilliseconds = 600;

    private string BackHref => string.IsNullOrWhiteSpace(ReturnUrl) ? "/rankings" : "/" + ReturnUrl.TrimStart('/');

    protected override async Task OnParametersSetAsync()
    {
        isBusy = true;
        errorMessage = null;
        highlightedGameId = null;
        isChartExpanded = false;
        var authenticationState = AuthenticationStateTask is null
            ? null
            : await AuthenticationStateTask;
        isAdmin = authenticationState?.User.IsInRole(ApplicationRoleKeys.Admin) == true;
        CancelTeamHistoryRefinement();
        teamHistoryGamesRangeCache.Clear();

        try
        {
            var poolKey = string.IsNullOrWhiteSpace(Pool) ? EloPoolKeys.Default : Pool;
            var ruleset = EloRulesetVersions.All.Contains(Ruleset?.Trim(), StringComparer.OrdinalIgnoreCase)
                ? Ruleset!.Trim().ToLowerInvariant()
                : EloRulesetVersions.Default;
            team = await Http.GetFromJsonAsync<EloTeamDetailResponse>($"api/elo/teams/{TeamId}?pool={Uri.EscapeDataString(poolKey)}&rulesetVersion={Uri.EscapeDataString(ruleset)}");
            if (team is not null)
            {
                fullTeamHistoryGames = team.RecentGames.ToList();
                fullTeamHistoryTotalGames = team.RecentGamesTotalCount;
                fullTeamHistoryWasSampled = team.RecentGamesWasSampled;
                teamHistoryVisibleFromUtc = null;
                teamHistoryVisibleToUtc = null;
                teamHistoryChartSeries = BuildTeamChartSeries(team);
                fullTeamHistoryChartSeries = teamHistoryChartSeries;
                teamHistoryDataRevision++;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load team profile: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadExplanationAsync(Guid gameId)
    {
        selectedExplanationGameId = gameId;
        selectedExplanation = null;
        explanationError = null;
        isExplanationLoading = true;

        try
        {
            using var responseMessage = await Http.GetAsync($"api/elo/games/{gameId}/explanation?rulesetVersion={Uri.EscapeDataString(team?.RulesetVersion ?? string.Empty)}");
            if (!responseMessage.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadErrorMessageAsync(responseMessage));
            }

            selectedExplanation = await responseMessage.Content.ReadFromJsonAsync<EloGameExplanationResponse>();
            if (selectedExplanation is null)
            {
                throw new InvalidOperationException("The API returned an empty explanation.");
            }
        }
        catch (Exception ex)
        {
            explanationError = $"Could not load ELO explanation: {ex.Message}";
        }
        finally
        {
            isExplanationLoading = false;
        }
    }

    private bool IsExplanationLoading(Guid gameId)
        => isExplanationLoading && selectedExplanationGameId == gameId;

    private void CloseExplanation()
    {
        selectedExplanationGameId = null;
        selectedExplanation = null;
        explanationError = null;
        isExplanationLoading = false;
    }

    private void HandleGameRowEnter(Guid gameId)
        => highlightedGameId = gameId;

    private void HandleGameRowLeave(Guid gameId)
    {
        if (highlightedGameId == gameId)
        {
            highlightedGameId = null;
        }
    }

    private Task HandleChartPointHoverAsync(Guid? gameId)
    {
        highlightedGameId = gameId;
        return Task.CompletedTask;
    }

    private bool IsGameHighlighted(Guid gameId)
        => highlightedGameId == gameId;

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage responseMessage)
    {
        var body = await responseMessage.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(body))
        {
            return responseMessage.ReasonPhrase ?? $"HTTP {(int)responseMessage.StatusCode}";
        }

        try
        {
            using var json = JsonDocument.Parse(body);
            if (json.RootElement.TryGetProperty("detail", out var detail) && detail.ValueKind == JsonValueKind.String)
            {
                return detail.GetString() ?? body;
            }

            if (json.RootElement.TryGetProperty("title", out var title) && title.ValueKind == JsonValueKind.String)
            {
                return title.GetString() ?? body;
            }

            if (json.RootElement.ValueKind == JsonValueKind.String)
            {
                return json.RootElement.GetString() ?? body;
            }
        }
        catch (JsonException)
        {
        }

        return body;
    }

    private static IReadOnlyList<EloChartSeries> BuildTeamChartSeries(EloTeamDetailResponse team)
    {
        var gamesById = team.RecentGames.ToDictionary(game => game.GameId);
        var points = team.History
            .OrderBy(point => point.GameDateTimeUtc)
            .Select(point =>
            {
                var game = point.GameId is { } gameId && gamesById.TryGetValue(gameId, out var plottedGame)
                    ? plottedGame
                    : null;
                return new EloChartPoint(
                    point.GameDateTimeUtc,
                    point.Elo,
                    team.TeamName,
                    "#245c7a",
                    point.EloDelta,
                    point.Rank,
                    point.GameId,
                    game?.Competition,
                    game?.Season,
                    game?.Opponent,
                    game?.WasHome,
                    game?.TeamScore,
                    game?.OpponentScore);
            })
            .ToList();

        return
        [
            new EloChartSeries(
                team.TeamId,
                team.TeamName,
                "#245c7a",
                points,
                team.GamesPlayed,
                team.GamesPlayed)
        ];
    }

    private static IReadOnlyList<EloChartSeries> BuildTeamChartSeries(
        EloTeamHistoryGamesResponse historyGames,
        EloTeamDetailResponse team)
    {
        var points = historyGames.Games
            .Where(game => game.PostElo.HasValue)
            .OrderBy(game => game.GameDateTimeUtc)
            .ThenBy(game => game.GameId)
            .Select(game => new EloChartPoint(
                game.GameDateTimeUtc,
                game.PostElo!.Value,
                team.TeamName,
                "#245c7a",
                game.EloDelta,
                game.RankAfter,
                game.GameId,
                game.Competition,
                game.Season,
                game.Opponent,
                game.WasHome,
                game.TeamScore,
                game.OpponentScore))
            .ToList();
        if (points.Count == 0)
        {
            return [];
        }

        return
        [
            new EloChartSeries(
                team.TeamId,
                team.TeamName,
                "#245c7a",
                points,
                historyGames.TotalGames,
                historyGames.SampledGames)
        ];
    }

    private Task QueueTeamHistoryRefinementAsync(EloChartViewportRange range)
    {
        CancelTeamHistoryRefinement();
        var cancellation = new CancellationTokenSource();
        teamHistoryRefinementCancellation = cancellation;
        isTeamHistoryRefining = true;
        _ = RefineTeamHistoryAsync(range, cancellation);
        return Task.CompletedTask;
    }

    private async Task RefineTeamHistoryAsync(EloChartViewportRange range, CancellationTokenSource cancellation)
    {
        try
        {
            await Task.Delay(HistoryRefinementDebounceMilliseconds, cancellation.Token);
            if (team is null)
            {
                return;
            }

            var fromUtc = DateTime.SpecifyKind(range.FromUtc.Date, DateTimeKind.Utc);
            var toUtc = DateTime.SpecifyKind(range.ToUtc.Date, DateTimeKind.Utc);
            var gamesUri = BuildTeamHistoryGamesApiUri(team, fromUtc, toUtc);
            if (!teamHistoryGamesRangeCache.TryGetValue(gamesUri, out var refinedGames))
            {
                refinedGames = await Http.GetFromJsonAsync<EloTeamHistoryGamesResponse>(gamesUri, cancellation.Token);
                if (refinedGames is null)
                {
                    return;
                }

                teamHistoryGamesRangeCache[gamesUri] = refinedGames;
            }

            cancellation.Token.ThrowIfCancellationRequested();
            if (!ReferenceEquals(teamHistoryRefinementCancellation, cancellation) || team is null)
            {
                return;
            }

            var refinedSeries = BuildTeamChartSeries(refinedGames, team);
            team = team with
            {
                RecentGames = refinedGames.Games,
                RecentGamesPage = 1,
                RecentGamesPageSize = Math.Max(1, refinedGames.Games.Count),
                RecentGamesTotalCount = refinedGames.TotalGames,
                RecentGamesTotalPages = 1,
                RecentGamesSampledCount = refinedGames.SampledGames,
                RecentGamesWasSampled = refinedGames.WasSampled
            };
            if (refinedSeries.Count > 0 && refinedSeries[0].Points.Count >= 2)
            {
                teamHistoryChartSeries = MergeTeamHistorySeries(teamHistoryChartSeries, refinedSeries, fromUtc, toUtc);
                teamHistoryVisibleFromUtc = fromUtc;
                teamHistoryVisibleToUtc = toUtc;
            }
            errorMessage = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (ReferenceEquals(teamHistoryRefinementCancellation, cancellation))
            {
                errorMessage = $"Could not refine chart detail: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            if (ReferenceEquals(teamHistoryRefinementCancellation, cancellation))
            {
                teamHistoryRefinementCancellation = null;
                isTeamHistoryRefining = false;
                await InvokeAsync(StateHasChanged);
            }

            cancellation.Dispose();
        }
    }

    private static string BuildTeamHistoryGamesApiUri(EloTeamDetailResponse team, DateTime fromUtc, DateTime toUtc)
        => $"api/elo/teams/{team.TeamId}/history-games?rulesetVersion={Uri.EscapeDataString(team.RulesetVersion)}" +
           $"&pool={Uri.EscapeDataString(team.EloPoolKey)}" +
           $"&pointsPerTeam={EloEvolutionLimits.DefaultPointsPerTeam}" +
           $"&fromUtc={Uri.EscapeDataString(fromUtc.ToString("O"))}" +
           $"&toUtc={Uri.EscapeDataString(toUtc.ToString("O"))}";

    private static string ToSlug(string value)
    {
        var normalized = value.Normalize(System.Text.NormalizationForm.FormD);
        var slug = new string(normalized
            .Where(character => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(character) != System.Globalization.UnicodeCategory.NonSpacingMark)
            .ToArray());

        return string.Join('-', slug
            .ToLowerInvariant()
            .Split([' ', '/', '\\', '.', ',', ':', ';', '&', '+', '(', ')', '[', ']', '{', '}', '\'', '"'], StringSplitOptions.RemoveEmptyEntries)
            .SelectMany(part => part.Split('-', StringSplitOptions.RemoveEmptyEntries)));
    }

    private Task RestoreFullTeamHistoryAsync()
    {
        CancelTeamHistoryRefinement();
        teamHistoryChartSeries = fullTeamHistoryChartSeries
            .Select(series => series with { VisibleRatedPointCount = series.RatedPointCount })
            .ToList();
        teamHistoryVisibleFromUtc = null;
        teamHistoryVisibleToUtc = null;
        if (team is not null)
        {
            team = team with
            {
                RecentGames = fullTeamHistoryGames,
                RecentGamesPage = 1,
                RecentGamesPageSize = Math.Max(1, fullTeamHistoryGames.Count),
                RecentGamesTotalCount = fullTeamHistoryTotalGames,
                RecentGamesTotalPages = 1,
                RecentGamesSampledCount = fullTeamHistoryGames.Count,
                RecentGamesWasSampled = fullTeamHistoryWasSampled
            };
        }
        return Task.CompletedTask;
    }

    private static IReadOnlyList<EloChartSeries> MergeTeamHistorySeries(
        IReadOnlyList<EloChartSeries> baseSeries,
        IReadOnlyList<EloChartSeries> refinedSeries,
        DateTime fromUtc,
        DateTime toUtc)
    {
        var refinedByTeam = refinedSeries
            .Where(series => series.TeamId.HasValue)
            .ToDictionary(series => series.TeamId!.Value);
        return baseSeries
            .Select(series => series.TeamId is Guid teamId && refinedByTeam.TryGetValue(teamId, out var refined)
                ? series with
                {
                    Points = EloChartData.ReplacePointsInRange(series.Points, refined.Points, fromUtc, toUtc),
                    VisibleRatedPointCount = refined.VisibleRatedPointCount ?? refined.RatedPointCount
                }
                : series)
            .ToList();
    }

    private void CancelTeamHistoryRefinement()
    {
        var cancellation = teamHistoryRefinementCancellation;
        teamHistoryRefinementCancellation = null;
        cancellation?.Cancel();
        isTeamHistoryRefining = false;
    }

    private string HistoryContextLabel()
    {
        var points = teamHistoryChartSeries
            .SelectMany(series => series.Points)
            .OrderBy(point => point.GameDateTimeUtc)
            .ToList();

        if (points.Count == 0)
        {
            return "No rated history yet.";
        }

        var first = teamHistoryVisibleFromUtc ?? points[0].GameDateTimeUtc;
        var last = teamHistoryVisibleToUtc ?? points[^1].GameDateTimeUtc;
        var shown = team?.RecentGames.Count ?? points.Count;
        var gameLabel = team?.RecentGamesWasSampled == true ? "sampled games" : "games";

        return $"Showing {shown} {gameLabel} from {FormatDate(first)} to {FormatDate(last)}.";
    }

    private static string GamesContextLabel(EloTeamDetailResponse team)
    {
        if (team.RecentGamesTotalCount == 0)
        {
            return "No imported games are available for this team yet.";
        }
        var shown = team.RecentGames.Count;
        return team.RecentGamesWasSampled
            ? $"Showing {shown} of {team.RecentGamesTotalCount} rated games represented by this chart interval."
            : $"Showing all {shown} rated games represented by this chart interval.";
    }

    private static string FormatScore(EloTeamGameDto game)
        => game.TeamScore.HasValue && game.OpponentScore.HasValue
            ? $"{game.TeamScore}-{game.OpponentScore}"
            : "-";

    private static string IdentityEventLabel(string type) => type switch
    {
        EloFranchiseIdentityEventTypes.Rename => "Rename",
        EloFranchiseIdentityEventTypes.TemporaryRelocation => "Temporary move",
        _ => "Relocation"
    };

    private static string TeamHeaderStatusLabel(EloTeamDetailResponse team)
        => team.EloPoolKey switch
        {
            EloPoolKeys.Nba => "Defunct franchise",
            EloPoolKeys.EuropeClubs => "Historical club",
            EloPoolKeys.NationalTeams => team.IsActive ? "National team" : "Historical national team",
            _ => team.IsActive ? "Team" : "Historical team"
        };

    private static string TeamHeaderStatusClass(EloTeamDetailResponse team)
        => !team.IsActive && team.EloPoolKey == EloPoolKeys.Nba
            ? "is-defunct"
            : !team.IsActive
                ? "is-historical"
                : string.Empty;

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("MMM d, yyyy") : "-";

    private static string FormatRating(decimal value)
        => value == 0 ? "-" : value.ToString("0");

    private static string FormatRating(decimal? value)
        => !value.HasValue || value.Value == 0 ? "-" : value.Value.ToString("0");

    private static string FormatRank(int? rank)
        => rank.HasValue ? $"#{rank.Value}" : "-";

    private static string RulesetDisplayName(string ruleset)
        => ruleset == EloRulesetVersions.BasicEloV1 ? "Basic ELO" : "Adjusted ELO";

    private static string RecentMovementOpponentLabel(EloTeamDetailResponse team)
        => string.IsNullOrWhiteSpace(team.RecentMovementOpponent)
            ? "Latest rated game"
            : $"vs {team.RecentMovementOpponent}";

    private static string FormatRankChange(int value)
        => value > 0 ? $"+{value}" : value.ToString();

    private static string RankChangeClass(int value)
        => value > 0 ? "movement-up" : value < 0 ? "movement-down" : "movement-flat";
    private static string FormatMovement(decimal? value)
        => value switch
        {
            null => "-",
            > 0 => $"+{value:0}",
            < 0 => value.Value.ToString("0"),
            _ => "0"
        };

    private static string FormatRecord(EloTeamFormSummary form)
        => form.GamesAvailable == 0 ? "No games" : $"{form.Wins}-{form.Losses}";

    private static string FormatHistoricalHighlightGame(EloTeamFormGame game)
    {
        var location = game.WasHome ? "vs" : "at";
        var score = game.TeamScore.HasValue && game.OpponentScore.HasValue
            ? $" {game.TeamScore}-{game.OpponentScore}"
            : string.Empty;

        return $"{FormatDate(game.GameDateTimeUtc)} · {location} {game.Opponent}{score}";
    }

    private static string MovementClass(decimal? value)
        => value switch
        {
            null => "movement-flat",
            > 0 => "movement-up",
            < 0 => "movement-down",
            _ => "movement-flat"
        };

    public ValueTask DisposeAsync()
    {
        CancelTeamHistoryRefinement();
        return ValueTask.CompletedTask;
    }
}
