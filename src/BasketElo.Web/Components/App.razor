<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1320" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/default-base.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/dygraphs@2.1.0/dist/dygraph.min.css" />
    <link rel="stylesheet" href="app.css?v=design-system-12" />
    <link rel="stylesheet" href="@ScopedStylesheetHref" />
    <link rel="icon" type="image/svg+xml" href="brand-mark.svg" />
    <link rel="alternate" type="application/xml" title="BasketElo sitemap" href="sitemap.xml" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dygraphs@2.1.0/dist/dygraph.min.js"></script>
    <script src="js/elo-dygraph.js?v=dygraph-21"></script>
    <script src="js/culture-switch.js?v=culture-switch-2"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/rankings-navigation.js?v=rankings-navigation-1"></script>
    @if (CloudflareAnalyticsToken is { } token)
    {
        <script type="module"
                src="https://static.cloudflareinsights.com/beacon.min.js"
                data-cf-beacon="@CreateCloudflareBeaconConfiguration(token)"></script>
    }
</body>

</html>

@code {
    private static readonly string ScopedStylesheetHref =
        $"BasketElo.Web.styles.css?v={typeof(App).Assembly.ManifestModule.ModuleVersionId:N}-rankings-spacing-1";

    [Inject]
    private IConfiguration Configuration { get; set; } = default!;

    private string? CloudflareAnalyticsToken
    {
        get
        {
            var token = Configuration["CloudflareAnalytics:Token"]?.Trim();
            return string.IsNullOrWhiteSpace(token) ? null : token;
        }
    }

    private static string CreateCloudflareBeaconConfiguration(string token) =>
        System.Text.Json.JsonSerializer.Serialize(new { token });
}
